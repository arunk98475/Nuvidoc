<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuvidoc.MainPage"
             BackgroundColor="{StaticResource Mist}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,48,24,24" Spacing="20">

                <Label x:Name="BrandLabel"
                       Text="NuviDoc"
                       FontFamily="OpenSansSemibold"
                       FontSize="34"
                       TextColor="{StaticResource Ink}"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="TaglineLabel"
                       Text="Find the right dentist — not just any dentist."
                       FontSize="16"
                       TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource Fog}"
                        Padding="18"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource Sage}"
                                    StrokeShape="RoundRectangle 20"
                                    VerticalOptions="Center">
                                <Label Text="N"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                            <Label x:Name="BotNameLabel"
                                   Text="Nuvi"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="{StaticResource Ink}"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <Label x:Name="WelcomeLabel"
                               Text="Loading…"
                               FontSize="15"
                               TextColor="{StaticResource Ink}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="What's going on?"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       TextColor="{StaticResource Slate}" />

                <FlexLayout x:Name="ConcernsLayout"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Start" />

                <Button x:Name="TalkToNuviBtn"
                        Text="Create free account"
                        BackgroundColor="{StaticResource Sage}"
                        TextColor="White"
                        FontFamily="OpenSansSemibold"
                        CornerRadius="28"
                        HeightRequest="52"
                        Clicked="OnTalkToNuviClicked" />

                <Label Text="In-person visits only · Matching &amp; office calling come next"
                       FontSize="12"
                       TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Text="Connecting…"
               FontSize="12"
               TextColor="{StaticResource Muted}"
               HorizontalTextAlignment="Center"
               Margin="16,8,16,20" />
    </Grid>
</ContentPage>
