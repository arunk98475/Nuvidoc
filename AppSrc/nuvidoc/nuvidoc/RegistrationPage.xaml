<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuvidoc.RegistrationPage"
             Title="Create account"
             BackgroundColor="{StaticResource Mist}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="White"
                Padding="16,12">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Border WidthRequest="36"
                        HeightRequest="36"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Sage}"
                        StrokeShape="RoundRectangle 18">
                    <Label Text="N"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label x:Name="HeaderBotLabel"
                           Text="Nuvi"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="Free patient account · in-person visits"
                           FontSize="12"
                           TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <ScrollView x:Name="ChatScroll" Grid.Row="1" Padding="16,12">
            <VerticalStackLayout x:Name="MessagesLayout" Spacing="10" />
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="16,8,16,16" BackgroundColor="White">
            <Entry x:Name="AnswerEntry"
                   Placeholder="Type your answer…"
                   ReturnType="Send"
                   Completed="OnSendClicked"
                   FontSize="15"
                   BackgroundColor="{StaticResource Fog}"
                   TextColor="{StaticResource Ink}" />
            <Button x:Name="SendBtn"
                    Text="Send"
                    BackgroundColor="{StaticResource Sage}"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    CornerRadius="24"
                    HeightRequest="48"
                    Clicked="OnSendClicked" />
            <Label x:Name="HintLabel"
                   FontSize="11"
                   TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
