<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nuvidoc.AppointmentsPage"
             Title="Appointments"
             BackgroundColor="#F5F7F6">
    <Grid RowDefinitions="Auto,*" Padding="16">
        <Label Text="Upcoming appointments"
               FontFamily="OpenSansSemibold"
               FontSize="22"
               TextColor="#1A2B22"
               VerticalOptions="Center" />

        <RefreshView Grid.Row="1" x:Name="Refresh" Refreshing="OnRefreshing">
            <CollectionView x:Name="List"
                            SelectionMode="None"
                            EmptyView="No upcoming appointments. Find a dentist from Home to book with Nuvi.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#D4DDD9"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="14"
                                Margin="0,6"
                                StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <Label Grid.ColumnSpan="2"
                                       Text="{Binding SlotLabel}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="#3D6B5A" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding DoctorName}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="#1A2B22"
                                       Margin="0,4,0,0" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="{Binding Details}"
                                       FontSize="13"
                                       TextColor="#6B8078"
                                       LineBreakMode="WordWrap" />
                                <Button Grid.Row="3"
                                        Grid.Column="1"
                                        Text="Cancel"
                                        FontSize="13"
                                        BackgroundColor="#E8EFEB"
                                        TextColor="#3D4F47"
                                        Padding="12,6"
                                        Margin="0,8,0,0"
                                        Command="{Binding CancelCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
