<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="nuvidoc.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{StaticResource Mist}"
    Title="NuviDoc">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="20,14">
                <Label
                    Text="{Binding Title}"
                    TextColor="{StaticResource Black}"
                    FontSize="16"
                    VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Padding="20,14">
                <Label
                    Text="{Binding Text}"
                    TextColor="{StaticResource Black}"
                    FontSize="16"
                    VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

</Shell>
