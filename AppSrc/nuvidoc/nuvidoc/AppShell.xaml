<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="nuvidoc.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{StaticResource Mist}"
    FlyoutWidth="300"
    FlyoutHeaderBehavior="Fixed"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="{StaticResource Sage}"
    Shell.TitleColor="{StaticResource Ink}"
    Shell.NavBarHasShadow="False"
    Title="NuviDoc">

    <Shell.FlyoutHeader>
        <Grid Padding="20,36,20,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Sage}" Offset="0" />
                    <GradientStop Color="{StaticResource PrimaryDark}" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                <Border
                    StrokeThickness="0"
                    BackgroundColor="White"
                    WidthRequest="52"
                    HeightRequest="52"
                    StrokeShape="RoundRectangle 26"
                    VerticalOptions="Center">
                    <Image
                        Source="favicon_large.png"
                        WidthRequest="36"
                        HeightRequest="36"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label
                        Text="NuviDoc"
                        FontFamily="OpenSansSemibold"
                        FontSize="22"
                        TextColor="White" />
                    <Label
                        Text="Your dental matchmaker"
                        FontSize="12"
                        TextColor="#D8E8E0" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <BoxView
                Grid.Row="1"
                HeightRequest="1"
                Color="#FFFFFF33"
                Margin="0,8,0,0" />

            <VerticalStackLayout Grid.Row="2" Spacing="2" Margin="0,4,0,0">
                <Label
                    x:Name="FlyoutUserLabel"
                    Text="Welcome"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    TextColor="White" />
                <Label
                    x:Name="FlyoutUserStatusLabel"
                    Text="Sign in to save your progress"
                    FontSize="12"
                    TextColor="#D8E8E0" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="16,6">
                <Border
                    x:Name="FlyoutItemBorder"
                    Padding="14,12"
                    Stroke="{StaticResource Rule}"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 14">
                    <Border.Shadow>
                        <Shadow Brush="#1A2B2215" Offset="0,2" Radius="8" Opacity="0.35" />
                    </Border.Shadow>
                    <Border.VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{StaticResource SageLt}" />
                                        <Setter Property="Stroke" Value="{StaticResource Sage}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </Border.VisualStateManager.VisualStateGroups>

                    <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            WidthRequest="40"
                            HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource SageLt}"
                            StrokeShape="RoundRectangle 20"
                            VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Title}" Value="Login">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Fog}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Title}" Value="Logout">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Fog}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Image
                                Source="home.png"
                                WidthRequest="22"
                                HeightRequest="22"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding Title}" Value="Login">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Image" Binding="{Binding Title}" Value="Logout">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>

                            <Image
                                Source="login.png"
                                WidthRequest="22"
                                HeightRequest="22"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsVisible="False">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding Title}" Value="Login">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>

                            <Image
                                Source="logout.png"
                                WidthRequest="22"
                                HeightRequest="22"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsVisible="False">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding Title}" Value="Logout">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>

                        <Label
                            Grid.Column="1"
                            Text="{Binding Title}"
                            FontFamily="OpenSansSemibold"
                            FontSize="16"
                            TextColor="{StaticResource Ink}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

</Shell>
