@page "/Doctor/Settings/{section?}"
@model Docovee.Pages.Doctor.SettingsModel
@{
    ViewData["Title"] = Model.SectionTitle;
    ViewData["Nav"] = "settings-" + (Model.Section == "booking-link" ? "booking-link" : Model.Section);
    var p = Model.Profile!;
}

<div class="dp-content@(Model.Section == "practice" || Model.Section == "visit-reasons" || Model.Section == "working-hours" ? " dp-content-practice" : "")">
    @if (Model.Section != "practice" && Model.Section != "visit-reasons" && Model.Section != "working-hours" && Model.Section != "booking-link")
    {
        <div class="dp-page-head@(Model.Section == "locations" || Model.Section == "insurance" || Model.Section == "legal" ? " dp-locations-head" : "")">
            <div>
                <h1>@Model.SectionTitle</h1>
                @if (Model.Section == "insurance")
                {
                    <p class="dp-page-sub">Manage the insurances your practice is in-network with. Click on a carrier to view and make edits.</p>
                }
                else if (Model.Section != "locations" && Model.Section != "legal")
                {
                    <p class="dp-page-sub">Manage your practice settings on @Branding.SiteName.</p>
                }
            </div>
            @if (Model.Section is "locations")
            {
                <div class="dp-page-actions">
                    <button type="button" class="dp-btn" id="dp-add-location-btn">Add location</button>
                </div>
            }
            else if (Model.Section is "insurance")
            {
                <div class="dp-page-actions dp-insurance-actions">
                    <button type="button" class="dp-insurance-adv-btn" id="dp-insurance-adv-btn">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                        Advanced preferences
                    </button>
                    <a class="dp-btn dp-btn-primary" href="/Doctor/Settings/insurance/select">Add</a>
                </div>
            }
        </div>
    }

    @if (Model.Section == "practice")
    {
        var descLen = (Model.PracticeInput.PracticeDescription ?? "").Length;
        <form method="post" asp-page-handler="Practice" enctype="multipart/form-data" class="dp-practice-form">
            <div class="dp-practice-scroll">
                <div class="dp-practice-inner">
                @if (Model.Saved)
                {
                    <div class="dp-practice-alert is-success">Practice profile saved.</div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="dp-practice-alert is-error">@Model.ErrorMessage</div>
                }

                <header class="dp-practice-hero">
                    <h1>Practice profile</h1>
                    <p>Manage your patient facing profile for your practice</p>
                </header>

                <section class="dp-practice-block">
                    <div class="dp-practice-field">
                        <label class="dp-practice-label" for="PracticeInput_PracticeName">Practice name</label>
                        <input asp-for="PracticeInput.PracticeName" class="dp-practice-input" id="PracticeInput_PracticeName" />
                    </div>

                    <div class="dp-practice-field">
                        <label class="dp-practice-label" for="dp-practice-logo">Practice logo <span class="dp-practice-optional">(optional)</span></label>
                        <p class="dp-practice-hint">A good photo increases appointment bookings</p>
                        <div class="dp-practice-logo-row">
                            @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                            {
                                <img src="@p.PhotoUrl" alt="" class="dp-practice-logo" id="dp-practice-logo-preview" />
                            }
                            else
                            {
                                <div class="dp-practice-logo is-fallback" id="dp-practice-logo-preview">@(p.Name.Length > 0 ? p.Name[0] : '?')</div>
                            }
                            <div>
                                <input type="file" id="dp-practice-logo" name="PracticeLogo" accept="image/*" hidden />
                                <button type="button" class="dp-practice-outline-btn" id="dp-practice-logo-btn">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
                                    Replace
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="dp-practice-field">
                        <label class="dp-practice-label" for="PracticeInput_PracticeDescription">Practice description <span class="dp-practice-optional">(optional)</span></label>
                        <p class="dp-practice-hint">Methods and philosophies, or other points of distinction</p>
                        <textarea asp-for="PracticeInput.PracticeDescription" class="dp-practice-textarea" id="PracticeInput_PracticeDescription" rows="8" maxlength="20000"></textarea>
                        <div class="dp-practice-count"><span id="dp-practice-count">@descLen</span>/20000</div>
                    </div>

                    <div class="dp-practice-field">
                        <label class="dp-practice-label" for="PracticeInput_YoutubeVideoUrl">YouTube video link <span class="dp-practice-optional">(optional)</span></label>
                        <p class="dp-practice-hint">Add an introduction video that appears on your public profile</p>
                        <input asp-for="PracticeInput.YoutubeVideoUrl" class="dp-practice-input" id="PracticeInput_YoutubeVideoUrl" type="url" placeholder="https://www.youtube.com/watch?v=..." />
                    </div>
                </section>

                <section class="dp-practice-block dp-practice-block-divider">
                    <header class="dp-practice-section-head">
                        <h2>Online Scheduling</h2>
                        <p>Let patients book with you 24/7 from the top places they search for care</p>
                    </header>

                    <div class="dp-practice-field">
                        <label class="dp-practice-label" for="PracticeInput_PracticeWebsite">Practice website <span class="dp-practice-optional">(optional)</span></label>
                        <input asp-for="PracticeInput.PracticeWebsite" class="dp-practice-input" id="PracticeInput_PracticeWebsite" placeholder="yourpractice.com" />
                    </div>

                    <div class="dp-practice-field">
                        <div class="dp-practice-label">Bookings from Google and others</div>
                        <p class="dp-practice-hint">Allow patients to book with you directly from your Google Business Profile and other search engines. <a href="/Doctor/Features">Learn more</a></p>
                        <div class="dp-practice-radios">
                            <label class="dp-practice-radio">
                                <input type="radio" asp-for="PracticeInput.AllowGoogleBookings" value="true" />
                                <span>Yes</span>
                            </label>
                            <label class="dp-practice-radio">
                                <input type="radio" asp-for="PracticeInput.AllowGoogleBookings" value="false" />
                                <span>No</span>
                            </label>
                        </div>
                    </div>
                </section>
                </div>
            </div>

            <footer class="dp-practice-footer">
                <button type="submit" class="dp-btn dp-btn-primary">Save changes</button>
            </footer>
        </form>
    }
    else if (Model.Section == "locations")
    {
        <div class="dp-locations">
            @if (Model.Saved)
            {
                <div class="dp-location-alert is-success">Location saved.</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="dp-location-alert is-error">@Model.ErrorMessage</div>
            }

            <div class="dp-locations-table-wrap">
                <table class="dp-locations-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Address</th>
                            <th>Location type</th>
                            <th>Phone number</th>
                            <th>Email</th>
                            <th class="dp-locations-actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Locations.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="dp-locations-empty">No locations yet. Click <strong>Add location</strong> to get started.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var loc in Model.Locations)
                            {
                                <tr data-location-id="@loc.Id">
                                    <td class="dp-locations-name">@loc.DisplayName</td>
                                    <td>
                                        <span class="dp-locations-status @(loc.IsActive ? "is-active" : "is-inactive")" title="@(loc.IsActive ? "Active" : "Inactive")">
                                            @if (loc.IsActive)
                                            {
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </span>
                                    </td>
                                    <td>@loc.FormattedAddress</td>
                                    <td>@loc.LocationTypeLabel</td>
                                    <td>@loc.PhoneDisplay</td>
                                    <td>@loc.EmailDisplay</td>
                                    <td class="dp-locations-actions-col">
                                        <div class="dp-locations-menu">
                                            <button type="button" class="dp-locations-menu-btn" aria-label="Location actions" aria-expanded="false" aria-haspopup="true">
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
                                            </button>
                                            <div class="dp-locations-menu-panel" hidden role="menu">
                                                <button type="button" role="menuitem" class="dp-locations-edit-btn" data-location-id="@loc.Id">View and edit details</button>
                                                <form method="post" asp-page-handler="DeleteLocation" class="dp-locations-delete-form">
                                                    <input type="hidden" name="locationId" value="@loc.Id" />
                                                    <button type="submit" role="menuitem" class="dp-locations-delete-btn" onclick="return confirm('Delete this location?');">Delete location</button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="dp-location-modal-backdrop" id="dp-location-modal" hidden aria-hidden="true" data-open-on-load="@(!string.IsNullOrEmpty(Model.ErrorMessage) ? "true" : "false")">
            <div class="dp-location-modal" role="dialog" aria-modal="true" aria-labelledby="dp-location-modal-title">
                <form method="post" asp-page-handler="Locations" id="dp-location-form">
                    <header class="dp-location-modal-head">
                        <h2 id="dp-location-modal-title">Add location</h2>
                        <button type="button" class="dp-location-modal-close" id="dp-location-modal-close" aria-label="Close">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                        </button>
                    </header>

                    <div class="dp-location-modal-body" id="dp-location-blocks">
                        <div class="dp-location-block" data-index="0">
                            <input type="hidden" name="LocationsForm.Locations[0].Id" class="dp-location-id" value="" />

                            <div class="dp-location-field">
                                <label class="dp-location-label">Name <span class="dp-location-optional">(optional)</span></label>
                                <input type="text" name="LocationsForm.Locations[0].Name" class="dp-location-input dp-field-name" autocomplete="organization" />
                            </div>

                            <div class="dp-location-field">
                                <div class="dp-location-label">Location type</div>
                                <div class="dp-location-checks">
                                    <label class="dp-location-check">
                                        <input type="checkbox" name="LocationsForm.Locations[0].InPerson" value="true" class="dp-field-inperson" checked />
                                        <span>In person</span>
                                    </label>
                                    <label class="dp-location-check">
                                        <input type="checkbox" name="LocationsForm.Locations[0].VideoVisits" value="true" class="dp-field-video" />
                                        <span>Video visits</span>
                                    </label>
                                </div>
                            </div>

                            <div class="dp-location-field">
                                <div class="dp-location-label">Address</div>
                                <input type="text" name="LocationsForm.Locations[0].Address1" class="dp-location-input" placeholder="Address 1" />
                                <input type="text" name="LocationsForm.Locations[0].Address2" class="dp-location-input" placeholder="Address 2 (Office/Suite)" style="margin-top:10px;" />
                                <input type="text" name="LocationsForm.Locations[0].City" class="dp-location-input" placeholder="City" style="margin-top:10px;" />
                                <div class="dp-location-row-2" style="margin-top:10px;">
                                    <select name="LocationsForm.Locations[0].State" class="dp-location-input dp-location-select">
                                        <option value="">State</option>
                                        @foreach (var state in Model.StateOptions)
                                        {
                                            <option value="@state.Code">@state.Name</option>
                                        }
                                    </select>
                                    <input type="text" name="LocationsForm.Locations[0].ZipCode" class="dp-location-input" placeholder="Zip" inputmode="numeric" />
                                </div>
                            </div>

                            <div class="dp-location-row-2 dp-location-row-phone">
                                <div class="dp-location-field">
                                    <label class="dp-location-label">Practice phone number</label>
                                    <input type="tel" name="LocationsForm.Locations[0].PhoneNumber" class="dp-location-input dp-field-phone" />
                                </div>
                                <div class="dp-location-field dp-location-field-narrow">
                                    <label class="dp-location-label">Ext <span class="dp-location-optional">(optional)</span></label>
                                    <input type="text" name="LocationsForm.Locations[0].PhoneExt" class="dp-location-input" inputmode="numeric" />
                                </div>
                            </div>

                            <div class="dp-location-field">
                                <label class="dp-location-label">Fax <span class="dp-location-optional">(optional)</span></label>
                                <input type="tel" name="LocationsForm.Locations[0].Fax" class="dp-location-input" />
                            </div>

                            <div class="dp-location-field">
                                <label class="dp-location-label">Name of contact person <span class="dp-location-optional">(optional)</span></label>
                                <p class="dp-location-hint">This will not be visible to the public</p>
                                <input type="text" name="LocationsForm.Locations[0].ContactPersonName" class="dp-location-input" />
                            </div>

                            <div class="dp-location-field">
                                <label class="dp-location-label">Email for appointment notifications</label>
                                <p class="dp-location-hint">This will not be visible to the public</p>
                                <input type="email" name="LocationsForm.Locations[0].AppointmentNotificationEmail" class="dp-location-input" />
                            </div>
                        </div>
                    </div>

                    <div class="dp-location-add-another-wrap">
                        <button type="button" class="dp-location-add-another" id="dp-location-add-another">Add another</button>
                    </div>

                    <footer class="dp-location-modal-foot">
                        <button type="button" class="dp-btn" id="dp-location-cancel">Cancel</button>
                        <button type="submit" class="dp-btn dp-btn-primary" id="dp-location-submit">Add location</button>
                    </footer>
                </form>
            </div>
        </div>

        <template id="dp-location-block-template">
            <div class="dp-location-block" data-index="__INDEX__">
                <div class="dp-location-block-divider">
                    <span>Location __NUMBER__</span>
                    <button type="button" class="dp-location-remove" aria-label="Remove location">Remove</button>
                </div>
                <input type="hidden" name="LocationsForm.Locations[__INDEX__].Id" class="dp-location-id" value="" />

                <div class="dp-location-field">
                    <label class="dp-location-label">Name <span class="dp-location-optional">(optional)</span></label>
                    <input type="text" name="LocationsForm.Locations[__INDEX__].Name" class="dp-location-input dp-field-name" autocomplete="organization" />
                </div>

                <div class="dp-location-field">
                    <div class="dp-location-label">Location type</div>
                    <div class="dp-location-checks">
                        <label class="dp-location-check">
                            <input type="checkbox" name="LocationsForm.Locations[__INDEX__].InPerson" value="true" class="dp-field-inperson" checked />
                            <span>In person</span>
                        </label>
                        <label class="dp-location-check">
                            <input type="checkbox" name="LocationsForm.Locations[__INDEX__].VideoVisits" value="true" class="dp-field-video" />
                            <span>Video visits</span>
                        </label>
                    </div>
                </div>

                <div class="dp-location-field">
                    <div class="dp-location-label">Address</div>
                    <input type="text" name="LocationsForm.Locations[__INDEX__].Address1" class="dp-location-input" placeholder="Address 1" />
                    <input type="text" name="LocationsForm.Locations[__INDEX__].Address2" class="dp-location-input" placeholder="Address 2 (Office/Suite)" style="margin-top:10px;" />
                    <input type="text" name="LocationsForm.Locations[__INDEX__].City" class="dp-location-input" placeholder="City" style="margin-top:10px;" />
                    <div class="dp-location-row-2" style="margin-top:10px;">
                        <select name="LocationsForm.Locations[__INDEX__].State" class="dp-location-input dp-location-select">
                            <option value="">State</option>
                            @foreach (var state in Model.StateOptions)
                            {
                                <option value="@state.Code">@state.Name</option>
                            }
                        </select>
                        <input type="text" name="LocationsForm.Locations[__INDEX__].ZipCode" class="dp-location-input" placeholder="Zip" inputmode="numeric" />
                    </div>
                </div>

                <div class="dp-location-row-2 dp-location-row-phone">
                    <div class="dp-location-field">
                        <label class="dp-location-label">Practice phone number</label>
                        <input type="tel" name="LocationsForm.Locations[__INDEX__].PhoneNumber" class="dp-location-input dp-field-phone" />
                    </div>
                    <div class="dp-location-field dp-location-field-narrow">
                        <label class="dp-location-label">Ext <span class="dp-location-optional">(optional)</span></label>
                        <input type="text" name="LocationsForm.Locations[__INDEX__].PhoneExt" class="dp-location-input" inputmode="numeric" />
                    </div>
                </div>

                <div class="dp-location-field">
                    <label class="dp-location-label">Fax <span class="dp-location-optional">(optional)</span></label>
                    <input type="tel" name="LocationsForm.Locations[__INDEX__].Fax" class="dp-location-input" />
                </div>

                <div class="dp-location-field">
                    <label class="dp-location-label">Name of contact person <span class="dp-location-optional">(optional)</span></label>
                    <p class="dp-location-hint">This will not be visible to the public</p>
                    <input type="text" name="LocationsForm.Locations[__INDEX__].ContactPersonName" class="dp-location-input" />
                </div>

                <div class="dp-location-field">
                    <label class="dp-location-label">Email for appointment notifications</label>
                    <p class="dp-location-hint">This will not be visible to the public</p>
                    <input type="email" name="LocationsForm.Locations[__INDEX__].AppointmentNotificationEmail" class="dp-location-input" />
                </div>
            </div>
        </template>

        <script type="application/json" id="dp-locations-json">@Html.Raw(Model.LocationsJson)</script>
    }
    else if (Model.Section == "visit-reasons")
    {
        var durationOptions = new[] { 15, 20, 30, 45, 60, 75, 90, 120 };
        <form method="post" asp-page-handler="VisitReasons" class="dp-practice-form dp-visit-form" id="dp-visit-form">
            <div class="dp-practice-scroll">
                <div class="dp-practice-inner dp-visit-inner">
                    @if (Model.Saved)
                    {
                        <div class="dp-location-alert is-success">Visit reason preferences saved.</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="dp-location-alert is-error">@Model.ErrorMessage</div>
                    }

                    <header class="dp-visit-hero">
                        <h1>Visit reason preferences</h1>
                        <p>These selections help patients find you for the right care. Enable the categories you offer and set visit lengths for new and existing patients.</p>
                    </header>

                    <div class="dp-visit-list" id="dp-visit-list">
                        @for (var i = 0; i < Model.VisitReasonCategories.Count; i++)
                        {
                            var cat = Model.VisitReasonCategories[i];
                            <div class="dp-visit-row@(cat.Enabled ? " is-enabled" : "")" data-category="@cat.Key">
                                <input type="hidden" name="VisitReasonsForm.Categories[@i].Key" value="@cat.Key" />
                                <div class="dp-visit-row-main">
                                    <label class="dp-visit-check">
                                        <input type="checkbox"
                                               name="VisitReasonsForm.Categories[@i].Enabled"
                                               value="true"
                                               class="dp-visit-enabled"
                                               @(cat.Enabled ? "checked" : null) />
                                        <span class="dp-visit-check-box" aria-hidden="true"></span>
                                    </label>
                                    <div class="dp-visit-copy">
                                        <div class="dp-visit-title">@cat.Title</div>
                                        <div class="dp-visit-desc">@cat.Description</div>
                                    </div>
                                    <div class="dp-visit-meta">
                                        <div class="dp-visit-durations">
                                            <span>New <strong class="dp-visit-new-label">@cat.NewPatientMinutes min</strong></span>
                                            <span class="dp-visit-dot">·</span>
                                            <span>Existing <strong class="dp-visit-exist-label">@cat.ExistingPatientMinutes min</strong></span>
                                        </div>
                                        <button type="button" class="dp-visit-settings-btn" data-index="@i">Settings</button>
                                        <input type="hidden" name="VisitReasonsForm.Categories[@i].NewPatientMinutes" class="dp-visit-new-input" value="@cat.NewPatientMinutes" />
                                        <input type="hidden" name="VisitReasonsForm.Categories[@i].ExistingPatientMinutes" class="dp-visit-exist-input" value="@cat.ExistingPatientMinutes" />
                                    </div>
                                </div>

                                @if (cat.PopularItems.Count > 0)
                                {
                                    <div class="dp-visit-popular" @(cat.Enabled ? null : "hidden")>
                                        <p class="dp-visit-popular-prompt">Do providers at your practice see patients for these popular visit types?</p>
                                        <div class="dp-visit-popular-list">
                                            @for (var j = 0; j < cat.PopularItems.Count; j++)
                                            {
                                                var item = cat.PopularItems[j];
                                                <label class="dp-visit-popular-item">
                                                    <input type="checkbox"
                                                           name="VisitReasonsForm.Categories[@i].PopularSelectedKeys"
                                                           value="@item.Key"
                                                           @(item.Selected ? "checked" : null) />
                                                    <span>@item.Name</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <footer class="dp-practice-footer">
                <button type="submit" class="dp-btn dp-btn-primary" id="dp-visit-save" disabled>Save updates</button>
            </footer>
        </form>

        <div class="dp-visit-settings-backdrop" id="dp-visit-settings-modal" hidden>
            <div class="dp-visit-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="dp-visit-settings-title">
                <header class="dp-visit-settings-head">
                    <h2 id="dp-visit-settings-title">Category settings</h2>
                    <button type="button" class="dp-location-modal-close" id="dp-visit-settings-close" aria-label="Close">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </header>
                <div class="dp-visit-settings-body">
                    <p class="dp-visit-settings-cat" id="dp-visit-settings-cat"></p>
                    <div class="dp-visit-settings-fields">
                        <div class="dp-location-field">
                            <label class="dp-location-label" for="dp-visit-settings-new">New patient visit length</label>
                            <select id="dp-visit-settings-new" class="dp-location-input dp-location-select">
                                @foreach (var m in durationOptions)
                                {
                                    <option value="@m">@m minutes</option>
                                }
                            </select>
                        </div>
                        <div class="dp-location-field">
                            <label class="dp-location-label" for="dp-visit-settings-exist">Existing patient visit length</label>
                            <select id="dp-visit-settings-exist" class="dp-location-input dp-location-select">
                                @foreach (var m in durationOptions)
                                {
                                    <option value="@m">@m minutes</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <footer class="dp-location-modal-foot">
                    <button type="button" class="dp-btn" id="dp-visit-settings-cancel">Cancel</button>
                    <button type="button" class="dp-btn dp-btn-primary" id="dp-visit-settings-apply">Apply</button>
                </footer>
            </div>
        </div>
    }
    else if (Model.Section == "insurance")
    {
        var allPrograms = Model.InsuranceRows.SelectMany(r => r.Programs).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
        var allPlanTypes = Model.InsuranceRows.SelectMany(r => r.PlanTypes).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();

        <div class="dp-insurance">
            @if (Model.Saved)
            {
                <div class="dp-location-alert is-success">Insurance list updated.</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="dp-location-alert is-error">@Model.ErrorMessage</div>
            }

            <div class="dp-insurance-toolbar">
                <div class="dp-insurance-search">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="search" id="dp-insurance-search" placeholder="Search by carrier" autocomplete="off" />
                </div>
                <div class="dp-insurance-filters">
                    <div class="dp-insurance-filter" data-filter="program">
                        <button type="button" class="dp-insurance-pill" aria-expanded="false" aria-haspopup="true">
                            Program
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <div class="dp-insurance-filter-panel" hidden>
                            <label class="dp-insurance-filter-option"><input type="checkbox" value="__all__" checked data-all /> <span>All programs</span></label>
                            @foreach (var program in allPrograms)
                            {
                                <label class="dp-insurance-filter-option"><input type="checkbox" value="@program" /> <span>@program</span></label>
                            }
                        </div>
                    </div>
                    <div class="dp-insurance-filter" data-filter="plan">
                        <button type="button" class="dp-insurance-pill" aria-expanded="false" aria-haspopup="true">
                            Plan type
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <div class="dp-insurance-filter-panel" hidden>
                            <label class="dp-insurance-filter-option"><input type="checkbox" value="__all__" checked data-all /> <span>All plan types</span></label>
                            @foreach (var planType in allPlanTypes)
                            {
                                <label class="dp-insurance-filter-option"><input type="checkbox" value="@planType" /> <span>@planType</span></label>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="dp-insurance-table-wrap">
                <table class="dp-insurance-table" id="dp-insurance-table">
                    <thead>
                        <tr>
                            <th>Carrier</th>
                            <th>
                                Accepted programs
                                <span class="dp-insurance-info" title="Commercial, Medicare, and other network programs you participate in.">i</span>
                            </th>
                            <th>
                                Accepted plan types
                                <span class="dp-insurance-info" title="Plan categories such as PPO, HMO, or DHMO.">i</span>
                            </th>
                            <th class="dp-insurance-actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.InsuranceRows.Count == 0)
                        {
                            <tr class="dp-insurance-empty-row">
                                <td colspan="4" class="dp-locations-empty">No insurance carriers yet. Click <strong>Add</strong> to get started.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Model.InsuranceRows)
                            {
                                <tr class="dp-insurance-row"
                                    data-carrier="@row.CarrierName.ToLowerInvariant()"
                                    data-programs="@string.Join("|", row.Programs).ToLowerInvariant()"
                                    data-plans="@string.Join("|", row.PlanTypes).ToLowerInvariant()">
                                    <td class="dp-insurance-carrier">@row.CarrierName</td>
                                    <td>@row.AcceptedPrograms</td>
                                    <td>@row.AcceptedPlanTypes</td>
                                    <td class="dp-insurance-actions-col">
                                        <div class="dp-locations-menu">
                                            <button type="button" class="dp-locations-menu-btn" aria-label="Carrier actions" aria-expanded="false" aria-haspopup="true">
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
                                            </button>
                                            <div class="dp-locations-menu-panel" hidden role="menu">
                                                <button type="button" role="menuitem" class="dp-insurance-view-btn"
                                                        data-carrier="@row.CarrierName"
                                                        data-programs="@row.AcceptedPrograms"
                                                        data-plans="@row.AcceptedPlanTypes"
                                                        data-plannames="@string.Join(" · ", row.PlanNames)">View details</button>
                                                <form method="post" asp-page-handler="RemoveInsurance" class="dp-locations-delete-form">
                                                    <input type="hidden" name="carrierId" value="@row.CarrierId" />
                                                    <button type="submit" role="menuitem" onclick="return confirm('Remove @row.CarrierName from your accepted insurance list?');">Remove carrier</button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <p class="dp-insurance-no-results" id="dp-insurance-no-results" hidden>No carriers match your search or filters.</p>
            </div>
        </div>

        <div class="dp-location-modal-backdrop" id="dp-insurance-detail-modal" hidden>
            <div class="dp-location-modal" role="dialog" aria-modal="true" aria-labelledby="dp-insurance-detail-title">
                <header class="dp-location-modal-head">
                    <h2 id="dp-insurance-detail-title">Carrier details</h2>
                    <button type="button" class="dp-location-modal-close" id="dp-insurance-detail-close" aria-label="Close">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </header>
                <div class="dp-location-modal-body">
                    <dl class="dp-settings-dl">
                        <div><dt>Carrier</dt><dd id="dp-insurance-detail-carrier">—</dd></div>
                        <div><dt>Accepted programs</dt><dd id="dp-insurance-detail-programs">—</dd></div>
                        <div><dt>Accepted plan types</dt><dd id="dp-insurance-detail-plans">—</dd></div>
                        <div><dt>Plans</dt><dd id="dp-insurance-detail-plannames">—</dd></div>
                    </dl>
                </div>
                <footer class="dp-location-modal-foot">
                    <button type="button" class="dp-btn dp-btn-primary" id="dp-insurance-detail-done">Done</button>
                </footer>
            </div>
        </div>

        <div class="dp-location-modal-backdrop" id="dp-insurance-adv-modal" hidden>
            <div class="dp-location-modal" role="dialog" aria-modal="true" aria-labelledby="dp-insurance-adv-title">
                <header class="dp-location-modal-head">
                    <h2 id="dp-insurance-adv-title">Advanced preferences</h2>
                    <button type="button" class="dp-location-modal-close" id="dp-insurance-adv-close" aria-label="Close">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    </button>
                </header>
                <div class="dp-location-modal-body">
                    <p class="dp-page-sub" style="margin:0;">Network program and plan-type overrides per carrier will be available here soon. For now, programs and plan types are inferred from your carrier’s catalog plans.</p>
                </div>
                <footer class="dp-location-modal-foot">
                    <button type="button" class="dp-btn dp-btn-primary" id="dp-insurance-adv-done">Done</button>
                </footer>
            </div>
        </div>
    }
    else if (Model.Section == "working-hours")
    {
        var wh = Model.WorkingHours!;
        var days = Model.WorkingHoursForm.Days.Count > 0 ? Model.WorkingHoursForm.Days : wh.Hours.Days;
        <form method="post" asp-page-handler="WorkingHours" class="dp-practice-form dp-hours-form" id="dp-hours-form">
            <div class="dp-practice-scroll">
                <div class="dp-practice-inner dp-hours-inner">
                    @if (Model.Saved)
                    {
                        <div class="dp-location-alert is-success">Working hours saved.</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="dp-location-alert is-error">@Model.ErrorMessage</div>
                    }

                    <header class="dp-hours-hero">
                        <h1>Hours for @wh.DoctorDisplayName</h1>
                        <p>Review or make adjustments to the periods of time when you see patients. @Branding.SiteName will only offer appointments for times you are available within these hours.</p>
                    </header>

                    <div class="dp-hours-table" id="dp-hours-table">
                        <div class="dp-hours-head">
                            <div>Day</div>
                            <div>Start time</div>
                            <div>End time</div>
                            <div>Practice location</div>
                            <div></div>
                        </div>

                        @for (var di = 0; di < days.Count; di++)
                        {
                            var day = days[di];
                            <div class="dp-hours-day@(day.Enabled ? " is-enabled" : "")" data-day-index="@di">
                                <input type="hidden" name="WorkingHoursForm.Days[@di].Day" value="@day.Day" />
                                @for (var bi = 0; bi < day.Blocks.Count; bi++)
                                {
                                    var block = day.Blocks[bi];
                                    var selectedLocId = block.LocationIds.FirstOrDefault();
                                    var selectedLoc = wh.Locations.FirstOrDefault(l => l.Id == selectedLocId);
                                    <div class="dp-hours-row" data-block-index="@bi">
                                        <div class="dp-hours-day-col">
                                            @if (bi == 0)
                                            {
                                                <label class="dp-hours-day-check">
                                                    <input type="checkbox"
                                                           name="WorkingHoursForm.Days[@di].Enabled"
                                                           value="true"
                                                           class="dp-hours-enabled"
                                                           @(day.Enabled ? "checked" : null) />
                                                    <span class="dp-hours-check-box" aria-hidden="true"></span>
                                                    <span class="dp-hours-day-name">@day.Day</span>
                                                </label>
                                            }
                                        </div>
                                        <div>
                                            <select name="WorkingHoursForm.Days[@di].Blocks[@bi].StartTime" class="dp-hours-select dp-hours-start" @(day.Enabled ? null : "disabled")>
                                                @foreach (var t in Model.TimeOptions)
                                                {
                                                    if (t == block.StartTime)
                                                    {
                                                        <option value="@t" selected>@SettingsModel.FormatTimeLabel(t)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@t">@SettingsModel.FormatTimeLabel(t)</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <select name="WorkingHoursForm.Days[@di].Blocks[@bi].EndTime" class="dp-hours-select dp-hours-end" @(day.Enabled ? null : "disabled")>
                                                @foreach (var t in Model.TimeOptions)
                                                {
                                                    if (t == block.EndTime)
                                                    {
                                                        <option value="@t" selected>@SettingsModel.FormatTimeLabel(t)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@t">@SettingsModel.FormatTimeLabel(t)</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="dp-hours-location-cell">
                                            <div class="dp-hours-location@(selectedLoc != null ? " has-value" : "")">
                                                @if (selectedLoc != null)
                                                {
                                                    <span class="dp-hours-loc-chip">
                                                        <span class="dp-hours-loc-text">@selectedLoc.Label</span>
                                                        <button type="button" class="dp-hours-loc-clear" aria-label="Clear location">&times;</button>
                                                    </span>
                                                }
                                                <select name="WorkingHoursForm.Days[@di].Blocks[@bi].LocationIds"
                                                        class="dp-hours-loc-select"
                                                        @(day.Enabled ? null : "disabled")>
                                                    <option value="">Select location</option>
                                                    @foreach (var loc in wh.Locations)
                                                    {
                                                        if (loc.Id == selectedLocId)
                                                        {
                                                            <option value="@loc.Id" selected>@loc.Label</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@loc.Id">@loc.Label</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="dp-hours-add-col">
                                            @if (bi == 0)
                                            {
                                                <button type="button" class="dp-hours-add-block" aria-label="Add hours" @(day.Enabled ? null : "disabled")>
                                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="dp-hours-remove-block" aria-label="Remove hours" @(day.Enabled ? null : "disabled")>
                                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/></svg>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (wh.Locations.Count == 0)
                    {
                        <p class="dp-hours-note">No practice locations yet. <a href="/Doctor/Settings/locations">Add a location</a> to assign hours to an office.</p>
                    }
                </div>
            </div>

            <footer class="dp-practice-footer">
                <button type="submit" class="dp-btn dp-btn-primary">Save</button>
            </footer>
        </form>

        <template id="dp-hours-block-template">
            <div class="dp-hours-row" data-block-index="__BI__">
                <div class="dp-hours-day-col"></div>
                <div>
                    <select name="WorkingHoursForm.Days[__DI__].Blocks[__BI__].StartTime" class="dp-hours-select dp-hours-start">
                        @foreach (var t in Model.TimeOptions)
                        {
                            if (t == "09:00")
                            {
                                <option value="@t" selected>@SettingsModel.FormatTimeLabel(t)</option>
                            }
                            else
                            {
                                <option value="@t">@SettingsModel.FormatTimeLabel(t)</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <select name="WorkingHoursForm.Days[__DI__].Blocks[__BI__].EndTime" class="dp-hours-select dp-hours-end">
                        @foreach (var t in Model.TimeOptions)
                        {
                            if (t == "17:00")
                            {
                                <option value="@t" selected>@SettingsModel.FormatTimeLabel(t)</option>
                            }
                            else
                            {
                                <option value="@t">@SettingsModel.FormatTimeLabel(t)</option>
                            }
                        }
                    </select>
                </div>
                <div class="dp-hours-location-cell">
                    <div class="dp-hours-location">
                        <select name="WorkingHoursForm.Days[__DI__].Blocks[__BI__].LocationIds" class="dp-hours-loc-select">
                            <option value="">Select location</option>
                            @foreach (var loc in wh.Locations)
                            {
                                <option value="@loc.Id">@loc.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="dp-hours-add-col">
                    <button type="button" class="dp-hours-remove-block" aria-label="Remove hours">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/></svg>
                    </button>
                </div>
            </div>
        </template>
    }
    else if (Model.Section == "booking-link")
    {
        if (Model.BookingLinkCreateStep)
        {
            <div class="dp-booking-create">
                <div class="dp-booking-create-main">
                    <a class="dp-booking-back" href="/Doctor">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Back to Home
                    </a>
                    <h1>Create a Booking Link</h1>
                    <p class="dp-booking-create-lead">
                        Choose whether patients should book with your full practice or a specific provider. You can create additional Booking Links later if needed.
                    </p>

                    <div class="dp-booking-options" role="radiogroup" aria-label="Booking link type">
                        <label class="dp-booking-option is-selected">
                            <span class="dp-booking-option-icon" aria-hidden="true">
                                <svg viewBox="0 0 40 40" width="40" height="40" fill="none">
                                    <circle cx="14" cy="14" r="5" fill="#E8E8EA" stroke="#333" stroke-width="1.4"/>
                                    <circle cx="26" cy="14" r="5" fill="#E8E8EA" stroke="#333" stroke-width="1.4"/>
                                    <circle cx="20" cy="22" r="5" fill="#FFF04B" stroke="#333" stroke-width="1.4"/>
                                    <path d="M6 32c1.5-5 5-8 10-8s8.5 3 10 8" stroke="#333" stroke-width="1.4" stroke-linecap="round"/>
                                    <path d="M24 32c.8-3.2 2.8-5.2 6-5.2 2.6 0 4.4 1.4 5.4 4" stroke="#333" stroke-width="1.4" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <span class="dp-booking-option-body">
                                <strong>Practice profile link</strong>
                                <span>Sends patients to your practice profile, where they can view and book with any provider at your practice.</span>
                            </span>
                            <span class="dp-booking-radio" aria-hidden="true"></span>
                            <input type="radio" name="booking-link-type" value="practice" checked />
                        </label>
                    </div>
                </div>

                <aside class="dp-booking-copy-card">
                    <h2>Copy your Booking Link</h2>
                    <p>Add this link to your website, patient messages, and social profiles.</p>
                    <div class="dp-booking-url" id="dp-settings-booking-link" tabindex="0">@Model.BookingLink</div>
                    <button type="button" class="dp-booking-cta" id="dp-settings-copy-link">Copy link</button>
                    <p class="dp-muted" id="dp-settings-copy-note" hidden>Link copied.</p>
                    <a class="dp-booking-help" href="/Doctor/Settings/booking-link" id="dp-booking-help">Need help with set up?</a>
                </aside>
            </div>
        }
        else
        {
            <div class="dp-booking">
                <div class="dp-booking-visual">
                    <img class="dp-booking-hero" src="~/images/BobExampleImg_V2___f59b4.png" alt="Example of a booking link on a practice website" width="640" height="480" />
                </div>

                <div class="dp-booking-copy">
                    <h1>Never miss a patient with free, 24/7 online scheduling</h1>
                    <p class="dp-booking-lead">Just copy and paste your Booking Link across your patient channels</p>
                    <button type="button" class="dp-booking-learn" id="dp-booking-learn">Learn more</button>

                    <ul class="dp-booking-benefits">
                        <li>
                            <span class="dp-booking-icon" aria-hidden="true">
                                <svg viewBox="0 0 32 32" width="28" height="28" fill="none">
                                    <rect x="4" y="18" width="5" height="8" rx="1" fill="#FFF04B" stroke="#333" stroke-width="1.2"/>
                                    <rect x="13" y="12" width="5" height="14" rx="1" fill="#E8E8EA" stroke="#333" stroke-width="1.2"/>
                                    <rect x="22" y="6" width="5" height="20" rx="1" fill="#FFF04B" stroke="#333" stroke-width="1.2"/>
                                </svg>
                            </span>
                            <div>
                                <strong>More patients, no workflow changes</strong>
                                <p>Patients book instantly from your website, email, texts, and social profiles with no changes to your workflow.</p>
                            </div>
                        </li>
                        <li>
                            <span class="dp-booking-icon" aria-hidden="true">
                                <svg viewBox="0 0 32 32" width="28" height="28" fill="none">
                                    <circle cx="16" cy="16" r="11" fill="#FFF04B" stroke="#333" stroke-width="1.2"/>
                                    <path d="M16 9v8l5 3" stroke="#333" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </span>
                            <div>
                                <strong>Set it up in minutes</strong>
                                <p>Anyone on your team can copy and paste the link wherever patients engage with you.</p>
                            </div>
                        </li>
                        <li>
                            <span class="dp-booking-icon" aria-hidden="true">
                                <svg viewBox="0 0 32 32" width="28" height="28" fill="none">
                                    <circle cx="16" cy="16" r="11" fill="#E8E8EA" stroke="#333" stroke-width="1.2"/>
                                    <path d="M11 16.5h10M16 11.5v10" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
                                    <circle cx="22" cy="10" r="5" fill="#FFF04B" stroke="#333" stroke-width="1.2"/>
                                    <path d="M20.5 10h3M22 8.5v3" stroke="#333" stroke-width="1.2" stroke-linecap="round"/>
                                </svg>
                            </span>
                            <div>
                                <strong>Free with no hidden fees</strong>
                                <p>Every booking is free, with no per-booking fees, no hidden costs, and no surprises.</p>
                            </div>
                        </li>
                    </ul>

                    <a class="dp-booking-cta" href="/Doctor/Settings/booking-link?step=create">Get started</a>
                </div>
            </div>

            <dialog class="dp-feature-dialog" id="dp-booking-learn-dialog">
                <form method="dialog" class="dp-feature-dialog-inner">
                    <h2>About Booking Link</h2>
                    <p>
                        Your Booking Link is a personal @Branding.SiteName page where patients can view your profile and request appointments anytime.
                        Add it to your website “Book Now” button, Google Business Profile, email signature, and social pages.
                    </p>
                    <button type="submit" class="dp-btn dp-btn-primary">Got it</button>
                </form>
            </dialog>
        }
    }
    else if (Model.Section == "integrations")
    {
        var nh = Model.NexHealthConnection;
        var isIntegrated = nh is { IsEnabled: true };
        var locationName = !string.IsNullOrWhiteSpace(Model.Profile?.PracticeName)
            ? Model.Profile!.PracticeName
            : (!string.IsNullOrWhiteSpace(nh?.InstitutionId) ? nh!.InstitutionId : "Practice location");
        if (!string.IsNullOrWhiteSpace(nh?.LocationExternalId))
            locationName = $"{locationName} (#{nh.LocationExternalId})";

        <div class="dp-practice-form" style="max-width:820px;">
            <header class="dp-hours-hero" style="margin-bottom:1.5rem;">
                <h1>Integrations</h1>
                <p>PMS calendar connection for your practice. Setup is managed by @Branding.SiteName admin.</p>
            </header>

            @if (!isIntegrated)
            {
                <p class="dp-page-sub">Your practice is not integrated with NexHealth yet. Public booking uses the @Branding.SiteName calendar until admin connects NexHealth.</p>
            }
            else
            {
                <table class="dp-integrations-table">
                    <thead>
                        <tr>
                            <th>Location Name</th>
                            <th>Integration Status</th>
                            <th>Last updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@locationName</td>
                            <td><span class="dp-badge-integrated">INTEGRATED</span></td>
                            <td>
                                @{
                                    var updated = nh!.LastSyncAt ?? nh.LastTestAt;
                                }
                                @(updated.HasValue ? updated.Value.ToLocalTime().ToString("g") : "—")
                            </td>
                        </tr>
                    </tbody>
                </table>
                @if (!string.IsNullOrWhiteSpace(nh.LastError))
                {
                    <p class="dp-page-sub" style="color:#b91c1c;margin-top:1rem;">Last sync note: @nh.LastError</p>
                }
            }
        </div>
    }
    else if (Model.Section == "legal")
    {
        <div class="dp-legal">
            <ul class="dp-legal-links">
                <li><a href="/legal/User%20Agreement.pdf" download="User Agreement.pdf">User agreement</a></li>
                <li><a href="/legal/Advertising%20Addendum.pdf" download="Advertising Addendum.pdf">Advertising addendum</a></li>
                <li><a href="/Legal/CommunityStandards">@Branding.SiteName community standards</a></li>
                <li><a href="/Privacy">Privacy policy</a></li>
            </ul>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
  const btn = document.getElementById("dp-settings-copy-link");
  const linkEl = document.getElementById("dp-settings-booking-link");
  const note = document.getElementById("dp-settings-copy-note");
  const learnBtn = document.getElementById("dp-booking-learn");
  const learnDialog = document.getElementById("dp-booking-learn-dialog");

  function bookingLinkValue() {
    if (!linkEl) return "";
    if (linkEl.tagName === "INPUT") return linkEl.value || "";
    return (linkEl.textContent || "").trim();
  }

  async function copyBookingLink() {
    const value = bookingLinkValue();
    try {
      await navigator.clipboard.writeText(value);
      if (note) note.hidden = false;
    } catch {
      if (linkEl?.tagName === "INPUT") {
        linkEl.select();
        document.execCommand("copy");
      } else {
        const range = document.createRange();
        range.selectNodeContents(linkEl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        document.execCommand("copy");
        sel?.removeAllRanges();
      }
      if (note) note.hidden = false;
    }
  }

  learnBtn?.addEventListener("click", () => learnDialog?.showModal());

  btn?.addEventListener("click", copyBookingLink);

  const logoBtn = document.getElementById("dp-practice-logo-btn");
  const logoInput = document.getElementById("dp-practice-logo");
  const logoPreview = document.getElementById("dp-practice-logo-preview");
  logoBtn?.addEventListener("click", () => logoInput?.click());
  logoInput?.addEventListener("change", () => {
    const file = logoInput.files?.[0];
    if (!file || !logoPreview) return;
    const url = URL.createObjectURL(file);
    if (logoPreview.tagName === "IMG") {
      logoPreview.src = url;
    } else {
      const img = document.createElement("img");
      img.id = "dp-practice-logo-preview";
      img.className = "dp-practice-logo";
      img.alt = "";
      img.src = url;
      logoPreview.replaceWith(img);
    }
  });

  const desc = document.getElementById("PracticeInput_PracticeDescription");
  const count = document.getElementById("dp-practice-count");
  function updateCount() {
    if (count && desc) count.textContent = String(desc.value.length);
  }
  desc?.addEventListener("input", updateCount);
  updateCount();

  document.getElementById("dp-add-location-btn")?.addEventListener("click", () => {
    openLocationModal("add");
  });

  const locationModal = document.getElementById("dp-location-modal");
  const locationForm = document.getElementById("dp-location-form");
  const locationBlocks = document.getElementById("dp-location-blocks");
  const locationTemplate = document.getElementById("dp-location-block-template");
  const locationTitle = document.getElementById("dp-location-modal-title");
  const locationSubmit = document.getElementById("dp-location-submit");
  const addAnotherBtn = document.getElementById("dp-location-add-another");
  const addAnotherWrap = document.querySelector(".dp-location-add-another-wrap");
  let locationData = [];

  try {
    locationData = JSON.parse(document.getElementById("dp-locations-json")?.textContent || "[]");
  } catch {
    locationData = [];
  }

  function setModalOpen(open) {
    if (!locationModal) return;
    locationModal.hidden = !open;
    locationModal.setAttribute("aria-hidden", open ? "false" : "true");
    document.body.classList.toggle("dp-location-modal-open", open);
  }

  function clearBlocks() {
    if (!locationBlocks) return;
    locationBlocks.innerHTML = "";
  }

  function buildBlock(index, data) {
    if (index === 0 && locationBlocks?.querySelector(".dp-location-block")) {
      const block = locationBlocks.querySelector(".dp-location-block");
      block.dataset.index = "0";
      fillBlock(block, data, 0);
      return block;
    }

    if (index === 0) {
      const html = locationTemplate?.innerHTML
        .replaceAll("__INDEX__", "0")
        .replaceAll("__NUMBER__", "1") || "";
      const wrap = document.createElement("div");
      wrap.innerHTML = html.trim();
      const block = wrap.firstElementChild;
      const divider = block.querySelector(".dp-location-block-divider");
      if (divider) divider.remove();
      fillBlock(block, data, 0);
      locationBlocks?.appendChild(block);
      return block;
    }

    const html = locationTemplate?.innerHTML
      .replaceAll("__INDEX__", String(index))
      .replaceAll("__NUMBER__", String(index + 1)) || "";
    const wrap = document.createElement("div");
    wrap.innerHTML = html.trim();
    const block = wrap.firstElementChild;
    fillBlock(block, data, index);
    block.querySelector(".dp-location-remove")?.addEventListener("click", () => {
      block.remove();
      reindexBlocks();
    });
    locationBlocks?.appendChild(block);
    return block;
  }

  function fillBlock(block, data, index) {
    if (!block) return;
    const setVal = (selector, value) => {
      const el = block.querySelector(selector);
      if (!el) return;
      if (el.type === "checkbox") el.checked = !!value;
      else el.value = value ?? "";
    };
    setVal(".dp-location-id", data?.id ?? data?.Id ?? "");
    setVal(".dp-field-name", data?.name ?? data?.Name ?? "");
    setVal(".dp-field-inperson", data?.inPerson ?? data?.InPerson ?? true);
    setVal(".dp-field-video", data?.videoVisits ?? data?.VideoVisits ?? false);
    setVal("[name$='.Address1']", data?.address1 ?? data?.Address1 ?? "");
    setVal("[name$='.Address2']", data?.address2 ?? data?.Address2 ?? "");
    setVal("[name$='.City']", data?.city ?? data?.City ?? "");
    setVal("[name$='.State']", data?.state ?? data?.State ?? "");
    setVal("[name$='.ZipCode']", data?.zipCode ?? data?.ZipCode ?? "");
    setVal(".dp-field-phone", data?.phoneNumber ?? data?.PhoneNumber ?? "");
    setVal("[name$='.PhoneExt']", data?.phoneExt ?? data?.PhoneExt ?? "");
    setVal("[name$='.Fax']", data?.fax ?? data?.Fax ?? "");
    setVal("[name$='.ContactPersonName']", data?.contactPersonName ?? data?.ContactPersonName ?? "");
    setVal("[name$='.AppointmentNotificationEmail']", data?.appointmentNotificationEmail ?? data?.AppointmentNotificationEmail ?? "");
    block.dataset.index = String(index);
  }

  function reindexBlocks() {
    locationBlocks?.querySelectorAll(".dp-location-block").forEach((block, i) => {
      block.dataset.index = String(i);
      block.querySelectorAll("[name]").forEach(el => {
        const name = el.getAttribute("name");
        if (!name) return;
        el.setAttribute("name", name.replace(/Locations\[\d+\]/, `Locations[${i}]`));
      });
      const divider = block.querySelector(".dp-location-block-divider span");
      if (divider) divider.textContent = `Location ${i + 1}`;
    });
  }

  function openLocationModal(mode, locationId) {
    clearBlocks();
    if (mode === "edit" && locationId != null) {
      const data = locationData.find(l => (l.id ?? l.Id) === locationId);
      buildBlock(0, data || {});
      if (locationTitle) locationTitle.textContent = "Edit location";
      if (locationSubmit) locationSubmit.textContent = "Save changes";
      if (addAnotherWrap) addAnotherWrap.hidden = true;
    } else {
      buildBlock(0, {});
      if (locationTitle) locationTitle.textContent = "Add location";
      if (locationSubmit) locationSubmit.textContent = "Add location";
      if (addAnotherWrap) addAnotherWrap.hidden = false;
    }
    setModalOpen(true);
  }

  document.getElementById("dp-location-modal-close")?.addEventListener("click", () => setModalOpen(false));
  document.getElementById("dp-location-cancel")?.addEventListener("click", () => setModalOpen(false));
  locationModal?.addEventListener("click", (e) => {
    if (e.target === locationModal) setModalOpen(false);
  });

  addAnotherBtn?.addEventListener("click", () => {
    const count = locationBlocks?.querySelectorAll(".dp-location-block").length ?? 0;
    buildBlock(count, {});
  });

  document.querySelectorAll(".dp-locations-edit-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const id = parseInt(btn.getAttribute("data-location-id") || "", 10);
      if (!Number.isNaN(id)) openLocationModal("edit", id);
      closeAllLocationMenus();
    });
  });

  if (locationModal?.dataset.openOnLoad === "true") {
    openLocationModal("add");
  }

  function closeAllLocationMenus() {
    document.querySelectorAll(".dp-locations-menu-panel").forEach(p => {
      p.hidden = true;
      p.style.top = "";
      p.style.left = "";
    });
    document.querySelectorAll(".dp-locations-menu-btn").forEach(b => b.setAttribute("aria-expanded", "false"));
  }

  function positionLocationMenu(btn, panel) {
    const rect = btn.getBoundingClientRect();
    panel.hidden = false;
    const menuWidth = Math.max(panel.offsetWidth || 200, 200);
    const menuHeight = panel.offsetHeight || 90;
    let top = rect.bottom + 4;
    let left = rect.right - menuWidth;
    if (left < 8) left = 8;
    if (top + menuHeight > window.innerHeight - 8) {
      top = Math.max(8, rect.top - menuHeight - 4);
    }
    panel.style.top = `${top}px`;
    panel.style.left = `${left}px`;
  }

  document.querySelectorAll(".dp-locations-menu").forEach(menu => {
    const btn = menu.querySelector(".dp-locations-menu-btn");
    const panel = menu.querySelector(".dp-locations-menu-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = panel.hidden;
      closeAllLocationMenus();
      if (open) {
        positionLocationMenu(btn, panel);
        btn.setAttribute("aria-expanded", "true");
      }
    });
    panel.addEventListener("click", (e) => e.stopPropagation());
  });
  document.addEventListener("click", closeAllLocationMenus);
  window.addEventListener("scroll", closeAllLocationMenus, true);
  window.addEventListener("resize", closeAllLocationMenus);

  const visitForm = document.getElementById("dp-visit-form");
  const visitSave = document.getElementById("dp-visit-save");
  const visitSettingsModal = document.getElementById("dp-visit-settings-modal");
  let visitSettingsRow = null;
  let visitDirty = false;

  function markVisitDirty() {
    visitDirty = true;
    if (visitSave) visitSave.disabled = false;
  }

  function syncVisitRow(row) {
    const enabled = row.querySelector(".dp-visit-enabled")?.checked;
    row.classList.toggle("is-enabled", !!enabled);
    const popular = row.querySelector(".dp-visit-popular");
    if (popular) popular.hidden = !enabled;
  }

  document.querySelectorAll(".dp-visit-row").forEach(row => {
    syncVisitRow(row);
    row.querySelector(".dp-visit-enabled")?.addEventListener("change", () => {
      syncVisitRow(row);
      markVisitDirty();
    });
    row.querySelectorAll('input[type="checkbox"]').forEach(input => {
      if (input.classList.contains("dp-visit-enabled")) return;
      input.addEventListener("change", markVisitDirty);
    });
  });

  function openVisitSettings(row) {
    visitSettingsRow = row;
    const title = row.querySelector(".dp-visit-title")?.textContent || "Category";
    const catEl = document.getElementById("dp-visit-settings-cat");
    if (catEl) catEl.textContent = title;
    const newVal = row.querySelector(".dp-visit-new-input")?.value || "45";
    const existVal = row.querySelector(".dp-visit-exist-input")?.value || "45";
    const newSelect = document.getElementById("dp-visit-settings-new");
    const existSelect = document.getElementById("dp-visit-settings-exist");
    if (newSelect) newSelect.value = newVal;
    if (existSelect) existSelect.value = existVal;
    if (visitSettingsModal) visitSettingsModal.hidden = false;
  }

  function closeVisitSettings() {
    if (visitSettingsModal) visitSettingsModal.hidden = true;
    visitSettingsRow = null;
  }

  document.querySelectorAll(".dp-visit-settings-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const row = btn.closest(".dp-visit-row");
      if (row) openVisitSettings(row);
    });
  });

  document.getElementById("dp-visit-settings-close")?.addEventListener("click", closeVisitSettings);
  document.getElementById("dp-visit-settings-cancel")?.addEventListener("click", closeVisitSettings);
  visitSettingsModal?.addEventListener("click", (e) => {
    if (e.target === visitSettingsModal) closeVisitSettings();
  });

  document.getElementById("dp-visit-settings-apply")?.addEventListener("click", () => {
    if (!visitSettingsRow) return;
    const newVal = document.getElementById("dp-visit-settings-new")?.value || "45";
    const existVal = document.getElementById("dp-visit-settings-exist")?.value || "45";
    const newInput = visitSettingsRow.querySelector(".dp-visit-new-input");
    const existInput = visitSettingsRow.querySelector(".dp-visit-exist-input");
    const newLabel = visitSettingsRow.querySelector(".dp-visit-new-label");
    const existLabel = visitSettingsRow.querySelector(".dp-visit-exist-label");
    if (newInput) newInput.value = newVal;
    if (existInput) existInput.value = existVal;
    if (newLabel) newLabel.textContent = `${newVal} min`;
    if (existLabel) existLabel.textContent = `${existVal} min`;
    markVisitDirty();
    closeVisitSettings();
  });

  visitForm?.addEventListener("change", markVisitDirty);

  function bindModal(backdropId, openBtnId, closeIds) {
    const backdrop = document.getElementById(backdropId);
    const openBtn = openBtnId ? document.getElementById(openBtnId) : null;
    const open = () => { if (backdrop) backdrop.hidden = false; };
    const close = () => { if (backdrop) backdrop.hidden = true; };
    openBtn?.addEventListener("click", open);
    closeIds.forEach(id => document.getElementById(id)?.addEventListener("click", close));
    backdrop?.addEventListener("click", (e) => { if (e.target === backdrop) close(); });
    return { open, close, backdrop };
  }

  bindModal("dp-insurance-adv-modal", "dp-insurance-adv-btn", ["dp-insurance-adv-close", "dp-insurance-adv-done"]);
  const detailModal = bindModal("dp-insurance-detail-modal", null, ["dp-insurance-detail-close", "dp-insurance-detail-done"]);

  document.querySelectorAll(".dp-insurance-view-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      document.getElementById("dp-insurance-detail-carrier").textContent = btn.dataset.carrier || "—";
      document.getElementById("dp-insurance-detail-programs").textContent = btn.dataset.programs || "—";
      document.getElementById("dp-insurance-detail-plans").textContent = btn.dataset.plans || "—";
      document.getElementById("dp-insurance-detail-plannames").textContent = btn.dataset.plannames || "—";
      detailModal.open();
      closeAllLocationMenus();
    });
  });

  const insuranceSearch = document.getElementById("dp-insurance-search");
  const noResults = document.getElementById("dp-insurance-no-results");

  function selectedFilterValues(filterName) {
    const root = document.querySelector(`.dp-insurance-filter[data-filter="${filterName}"]`);
    if (!root) return [];
    const checked = [...root.querySelectorAll('input[type="checkbox"]:checked')];
    if (checked.some(c => c.dataset.all != null)) return [];
    return checked.map(c => c.value.toLowerCase());
  }

  function applyInsuranceFilters() {
    const q = (insuranceSearch?.value || "").trim().toLowerCase();
    const programs = selectedFilterValues("program");
    const plans = selectedFilterValues("plan");
    let visible = 0;
    document.querySelectorAll(".dp-insurance-row").forEach(row => {
      const carrier = row.getAttribute("data-carrier") || "";
      const rowPrograms = (row.getAttribute("data-programs") || "").split("|").filter(Boolean);
      const rowPlans = (row.getAttribute("data-plans") || "").split("|").filter(Boolean);
      const matchSearch = !q || carrier.includes(q);
      const matchProgram = programs.length === 0 || programs.some(p => rowPrograms.includes(p));
      const matchPlan = plans.length === 0 || plans.some(p => rowPlans.includes(p));
      const show = matchSearch && matchProgram && matchPlan;
      row.hidden = !show;
      if (show) visible++;
    });
    if (noResults) noResults.hidden = visible > 0 || document.querySelectorAll(".dp-insurance-row").length === 0;
  }

  insuranceSearch?.addEventListener("input", applyInsuranceFilters);

  document.querySelectorAll(".dp-insurance-filter").forEach(filter => {
    const btn = filter.querySelector(".dp-insurance-pill");
    const panel = filter.querySelector(".dp-insurance-filter-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = panel.hidden;
      document.querySelectorAll(".dp-insurance-filter-panel").forEach(p => { p.hidden = true; });
      document.querySelectorAll(".dp-insurance-pill").forEach(b => b.setAttribute("aria-expanded", "false"));
      panel.hidden = !open;
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
    panel.addEventListener("click", (e) => e.stopPropagation());
    panel.querySelectorAll('input[type="checkbox"]').forEach(input => {
      input.addEventListener("change", () => {
        const all = panel.querySelector('[data-all]');
        if (input.dataset.all != null) {
          panel.querySelectorAll('input[type="checkbox"]').forEach(c => {
            if (c !== input) c.checked = false;
          });
          input.checked = true;
        } else if (all) {
          all.checked = false;
          const any = [...panel.querySelectorAll('input[type="checkbox"]:not([data-all])')].some(c => c.checked);
          if (!any) all.checked = true;
        }
        applyInsuranceFilters();
      });
    });
  });

  document.addEventListener("click", () => {
    document.querySelectorAll(".dp-insurance-filter-panel").forEach(p => { p.hidden = true; });
    document.querySelectorAll(".dp-insurance-pill").forEach(b => b.setAttribute("aria-expanded", "false"));
  });

  const hoursForm = document.getElementById("dp-hours-form");
  const hoursTemplate = document.getElementById("dp-hours-block-template");

  function syncHoursDay(day) {
    const enabled = day.querySelector(".dp-hours-enabled")?.checked;
    day.classList.toggle("is-enabled", !!enabled);
    day.querySelectorAll("select, .dp-hours-add-block, .dp-hours-remove-block, .dp-hours-loc-clear").forEach(el => {
      if (el.classList?.contains("dp-hours-enabled")) return;
      el.disabled = !enabled;
    });
  }

  function reindexHoursDay(day) {
    const di = day.dataset.dayIndex;
    day.querySelectorAll(".dp-hours-row").forEach((row, bi) => {
      row.dataset.blockIndex = String(bi);
      row.querySelectorAll("[name]").forEach(el => {
        const name = el.getAttribute("name");
        if (!name) return;
        el.setAttribute("name", name
          .replace(/Days\[\d+\]/, `Days[${di}]`)
          .replace(/Blocks\[\d+\]/, `Blocks[${bi}]`));
      });
      const addCol = row.querySelector(".dp-hours-add-col");
      if (!addCol) return;
      if (bi === 0) {
        addCol.innerHTML = `<button type="button" class="dp-hours-add-block" aria-label="Add hours"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>`;
      } else {
        addCol.innerHTML = `<button type="button" class="dp-hours-remove-block" aria-label="Remove hours"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/></svg></button>`;
      }
    });
    syncHoursDay(day);
  }

  function refreshLocationChip(wrap) {
    const select = wrap.querySelector(".dp-hours-loc-select");
    if (!select) return;
    const opt = select.options[select.selectedIndex];
    const has = select.value && opt;
    wrap.classList.toggle("has-value", !!has);
    wrap.querySelector(".dp-hours-loc-chip")?.remove();
    if (has) {
      const chip = document.createElement("span");
      chip.className = "dp-hours-loc-chip";
      chip.innerHTML = `<span class="dp-hours-loc-text"></span><button type="button" class="dp-hours-loc-clear" aria-label="Clear location">&times;</button>`;
      chip.querySelector(".dp-hours-loc-text").textContent = opt.textContent || "";
      wrap.insertBefore(chip, select);
    }
  }

  document.querySelectorAll(".dp-hours-day").forEach(day => {
    syncHoursDay(day);
    day.querySelector(".dp-hours-enabled")?.addEventListener("change", () => syncHoursDay(day));
  });

  document.getElementById("dp-hours-table")?.addEventListener("click", (e) => {
    const addBtn = e.target.closest(".dp-hours-add-block");
    const removeBtn = e.target.closest(".dp-hours-remove-block");
    const clearBtn = e.target.closest(".dp-hours-loc-clear");
    if (clearBtn) {
      const wrap = clearBtn.closest(".dp-hours-location");
      const select = wrap?.querySelector(".dp-hours-loc-select");
      if (select) {
        select.value = "";
        refreshLocationChip(wrap);
      }
      return;
    }
    if (addBtn) {
      const day = addBtn.closest(".dp-hours-day");
      if (!day || !hoursTemplate) return;
      const di = day.dataset.dayIndex || "0";
      const bi = day.querySelectorAll(".dp-hours-row").length;
      const html = hoursTemplate.innerHTML.replaceAll("__DI__", di).replaceAll("__BI__", String(bi));
      const wrap = document.createElement("div");
      wrap.innerHTML = html.trim();
      const row = wrap.firstElementChild;
      day.appendChild(row);
      reindexHoursDay(day);
      return;
    }
    if (removeBtn) {
      const day = removeBtn.closest(".dp-hours-day");
      const row = removeBtn.closest(".dp-hours-row");
      if (!day || !row || day.querySelectorAll(".dp-hours-row").length <= 1) return;
      row.remove();
      reindexHoursDay(day);
    }
  });

  document.getElementById("dp-hours-table")?.addEventListener("change", (e) => {
    if (e.target.classList.contains("dp-hours-loc-select")) {
      const wrap = e.target.closest(".dp-hours-location");
      if (wrap) refreshLocationChip(wrap);
    }
  });

  hoursForm?.addEventListener("submit", () => {
    hoursForm.querySelectorAll("select[disabled]").forEach(el => { el.disabled = false; });
  });
})();
</script>
}
