@page
@model Docovee.Pages.Doctor.PerformanceModel
@{
    ViewData["Title"] = "Performance overview";
    ViewData["Nav"] = "performance";

    var o = Model.Overview;
    var totalSource = Math.Max(1, o.MarketplaceBookings + o.NuviMatchingBookings);
    var marketplacePct = (int)Math.Round(100.0 * o.MarketplaceBookings / totalSource);
    var nuviPct = 100 - marketplacePct;
    if (o.MarketplaceBookings + o.NuviMatchingBookings == 0)
    {
        marketplacePct = 0;
        nuviPct = 0;
    }

    var maxDaily = o.DailySeries.Count == 0
        ? 1
        : Math.Max(1, o.DailySeries.Max(d => d.MarketplaceCount + d.NuviMatchingCount));

    string Money(int cents) => (cents / 100m).ToString("C");
    string Compare(int current, int prior)
    {
        if (prior <= 0 && current <= 0) return "No activity in this period yet";
        if (prior <= 0) return $"Compared to 0 at this time last month";
        return $"Compared to {prior} at this time last month";
    }
}

<div class="dp-content">
    <div class="dp-page-head">
        <div>
            <h1>Performance overview</h1>
            <select class="dp-select" style="width:auto;margin-top:10px;" disabled>
                <option>@o.PeriodLabel</option>
            </select>
        </div>
        <div class="dp-page-actions">
            <a class="dp-btn" href="/Doctor/Settings/billing">Manage spend</a>
            <a class="dp-btn dp-btn-primary" href="/Doctor/Calendar">Appointment report</a>
        </div>
    </div>

    <div class="dp-tabs">
        <a class="dp-tab active" href="/Doctor/Performance">Bookings</a>
        <a class="dp-tab" href="/Doctor/Settings/billing">Billing</a>
    </div>

    <div class="dp-card" style="margin-bottom:20px;">
        <h2>Quality score</h2>
        <p class="dp-billing-hint">
            Your quality score: <strong>@Model.Sponsorship.QualityScore</strong>/100
            (minimum @Model.Sponsorship.MinRequired required to enable sponsorship)
            @(Model.Sponsorship.Enabled ? " · Sponsorship is on" : "")
            @(Model.Sponsorship.Paused ? " · Sponsorship paused" : "")
        </p>
        <div class="dp-quality-bar" aria-hidden="true">
            <span style="width:@(Model.Sponsorship.QualityScore)%;"></span>
        </div>
        @if (Model.Sponsorship.Components.Count > 0)
        {
            <ul class="dp-quality-tips">
                @foreach (var c in Model.Sponsorship.Components)
                {
                    <li>@c.Name (@c.WeightPercent%): @c.Score/100</li>
                }
            </ul>
        }
        @if (Model.Sponsorship.Tips.Count > 0)
        {
            <p class="dp-section-label">How to improve</p>
            <ul class="dp-quality-tips">
                @foreach (var tip in Model.Sponsorship.Tips)
                {
                    <li>@tip</li>
                }
            </ul>
        }
        <p class="dp-billing-hint"><a href="/Doctor/Settings/billing">Manage sponsorship in Billing</a></p>
    </div>

    <div class="dp-kpi-row">
        <div class="dp-card">
            <div style="font-size:13px;color:var(--dp-muted);">Bookings</div>
            <div class="dp-kpi-value">@o.Bookings</div>
            <div class="dp-metric-compare">@Compare(o.Bookings, o.BookingsPriorPeriod)</div>
        </div>
        <div class="dp-card">
            <div style="font-size:13px;color:var(--dp-muted);">Completed appointments</div>
            <div class="dp-kpi-value">@o.CompletedAppointments</div>
            <div class="dp-metric-compare">@Compare(o.CompletedAppointments, o.CompletedPriorPeriod)</div>
        </div>
        <div class="dp-card">
            <div style="font-size:13px;color:var(--dp-muted);">Spend</div>
            <div class="dp-kpi-value">@Money(o.SpendCents)</div>
            <div class="dp-metric-compare">
                @if (o.Bookings > 0)
                {
                    <text>Average cost per booking is @Money(o.AverageCostPerBookingCents)</text>
                }
                else
                {
                    <text>Successful Stripe charges this month (visit + sponsorship)</text>
                }
            </div>
        </div>
    </div>

    <div class="dp-charts-row">
        <div class="dp-card">
            <h2>Booking source over time</h2>
            @if (o.DailySeries.Count == 0 || o.Bookings == 0)
            {
                <p class="dp-billing-hint">No NuviDoc bookings in this period yet.</p>
            }
            else
            {
                <div class="dp-bars-chart">
                    @foreach (var day in o.DailySeries)
                    {
                        var total = day.MarketplaceCount + day.NuviMatchingCount;
                        var mPct = total == 0 ? 0 : (int)Math.Round(100.0 * day.MarketplaceCount / maxDaily);
                        var nPct = total == 0 ? 0 : (int)Math.Round(100.0 * day.NuviMatchingCount / maxDaily);
                        <div class="dp-bars-col">
                            <div class="dp-bars-stack">
                                <span style="height:@(mPct)%;background:#7bc47f;" title="Marketplace: @day.MarketplaceCount"></span>
                                <span style="height:@(nPct)%;background:var(--dp-yellow);" title="Nuvi matching: @day.NuviMatchingCount"></span>
                            </div>
                            <div class="lbl">@day.Date.ToString("MMM d")</div>
                        </div>
                    }
                </div>
                <div class="dp-legend" style="flex-direction:row;gap:16px;margin-top:14px;">
                    <div class="dp-legend-row"><span class="dp-dot green"></span> Marketplace</div>
                    <div class="dp-legend-row"><span class="dp-dot yellow"></span> Nuvi matching</div>
                </div>
            }
        </div>

        <div class="dp-card">
            <h2>Bookings breakdown</h2>
            <div class="dp-section-label" style="margin-top:0;">Source</div>
            <div class="dp-bar-track">
                @if (o.MarketplaceBookings + o.NuviMatchingBookings == 0)
                {
                    <div class="dp-bar-seg" style="width:100%;background:#e5e7eb;"></div>
                }
                else
                {
                    <div class="dp-bar-seg green" style="width:@(marketplacePct)%;"></div>
                    <div class="dp-bar-seg yellow" style="width:@(nuviPct)%;"></div>
                }
            </div>
            <div class="dp-legend">
                <div class="dp-legend-row">
                    <span class="dp-dot green"></span>
                    <span>@Branding.SiteName Marketplace</span>
                    <span class="count">@o.MarketplaceBookings</span>
                    <span class="pct">@(o.MarketplaceBookings + o.NuviMatchingBookings == 0 ? 0 : marketplacePct)%</span>
                </div>
                <div class="dp-legend-row">
                    <span class="dp-dot yellow"></span>
                    <span>Nuvi matching</span>
                    <span class="count">@o.NuviMatchingBookings</span>
                    <span class="pct">@(o.MarketplaceBookings + o.NuviMatchingBookings == 0 ? 0 : nuviPct)%</span>
                </div>
            </div>

            <div class="dp-section-label">Patient type</div>
            <div class="dp-legend">
                <div class="dp-legend-row"><span>New patients (NuviDoc)</span><span class="count">@o.NewPatientBookings</span></div>
            </div>
        </div>
    </div>
</div>
