@page
@using Docovee.DS.Entities
@model Docovee.Pages.Doctor.CalendarModel
@{
    ViewData["Title"] = "Calendar";
    ViewData["Nav"] = "calendar";
    var prevWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
    var todayWeek = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var monthStart = new DateOnly(Model.MonthFocus.Year, Model.MonthFocus.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.MonthFocus.Year, Model.MonthFocus.Month);
    var lead = (int)monthStart.DayOfWeek;
    var today = DateOnly.FromDateTime(DateTime.Today);
}
@Html.AntiForgeryToken()

<div class="dp-cal-layout">
    <div class="dp-cal-main">
        <div class="dp-cal-toolbar">
            <h1>@Model.WeekStart.ToString("MMM yyyy")</h1>
            <a class="dp-btn dp-btn-sm" href="/Doctor/Calendar?week=@todayWeek">Today</a>
            <div class="dp-cal-nav">
                <a class="dp-icon-btn" href="/Doctor/Calendar?week=@prevWeek">‹</a>
                <a class="dp-icon-btn" href="/Doctor/Calendar?week=@nextWeek">›</a>
            </div>
            <div style="margin-left:auto;font-size:13px;color:var(--dp-muted);">
                @Model.Appointments.Count appointment@(Model.Appointments.Count == 1 ? "" : "s") this week
            </div>
        </div>

        <div class="dp-provider-bar">
            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <img src="@Model.PhotoUrl" alt="" />
            }
            else
            {
                <span class="dp-logo-mark" style="width:32px;height:32px;font-size:12px;">D</span>
            }
            @Model.ProviderName
        </div>

        <div class="dp-week">
            <div class="dp-week-head"></div>
            @foreach (var day in Model.WeekDays)
            {
                <div class="dp-week-head">
                    @day.ToString("ddd")
                    <span class="day-num">@day.Day</span>
                </div>
            }

            @foreach (var hour in Model.HourStarts)
            {
                var label = DateTime.Today.AddHours(hour).ToString("h tt");
                <div class="dp-time-label">@label</div>
                @foreach (var day in Model.WeekDays)
                {
                    var appt = Model.FindAppointment(day, hour);
                    <div class="dp-slot">
                        @if (appt != null)
                        {
                            var isPms = CalendarModel.IsPmsBooked(appt);
                            <button type="button"
                                    class="dp-appt@(isPms ? " dp-appt-pms" : "")"
                                    data-appointment-id="@appt.Id"
                                    data-pms-booked="@(isPms ? "true" : "false")"
                                    title="@(isPms ? AppointmentSources.PmsBookedDisplayLabel : $"View patient — {appt.PatientName}")"
                                    onclick="dpOpenPatientPanel(@appt.Id)">
                                @CalendarModel.DisplayAppointmentLabel(appt)
                                @if (!isPms)
                                {
                                    <small>@appt.VisitReason</small>
                                }
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="dp-drawer-backdrop" id="dp-drawer-backdrop" hidden></div>
<aside class="dp-drawer" id="dp-patient-drawer" aria-hidden="true" aria-label="Patient details">
    <div class="dp-drawer-inner">
        <button type="button" class="dp-drawer-close" id="dp-drawer-close" aria-label="Close">&times;</button>

        <div class="dp-drawer-scroll">
            <div class="dp-drawer-loading" id="dp-drawer-loading" hidden>Loading…</div>
            <div class="dp-drawer-error" id="dp-drawer-error" hidden></div>

            <div class="dp-drawer-body" id="dp-drawer-body" hidden>
                <div class="dp-drawer-top">
                    <div class="dp-drawer-badge" id="dp-drawer-badge"></div>
                    <div class="dp-drawer-actions" aria-hidden="true">
                        <span class="dp-drawer-action" title="Notes">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
                        </span>
                        <span class="dp-drawer-action" title="Flag">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 21V4h9l-1.5 3.5L14 11H5"/></svg>
                        </span>
                        <span class="dp-drawer-action" title="Message">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h16v10H8l-4 3V6z"/></svg>
                        </span>
                        <span class="dp-drawer-action" title="More">
                            <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="18" cy="12" r="1.5"/></svg>
                        </span>
                    </div>
                </div>
                <h2 class="dp-drawer-name" id="dp-drawer-name"></h2>
                <p class="dp-drawer-sub" id="dp-drawer-sub"></p>

                <div class="dp-drawer-section is-open" data-drawer-section>
                    <button type="button" class="dp-drawer-section-toggle" aria-expanded="true">
                        <span>Appointment details</span>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="dp-drawer-section-body">
                        <dl class="dp-drawer-dl">
                            <div><dt>Appointment time</dt><dd id="dp-drawer-time"></dd></div>
                            <div><dt>Visit reason</dt><dd id="dp-drawer-reason"></dd></div>
                            <div><dt>Provider</dt><dd id="dp-drawer-provider"></dd></div>
                            <div><dt>Location</dt><dd id="dp-drawer-location"></dd></div>
                        </dl>
                    </div>
                </div>

                <div class="dp-drawer-section is-open" data-drawer-section>
                    <button type="button" class="dp-drawer-section-toggle" aria-expanded="true">
                        <span>Insurance</span>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="dp-drawer-section-body">
                        <div class="dp-ins-head" id="dp-drawer-ins-head" hidden>
                            <span class="dp-ins-pill" id="dp-drawer-ins-pill">New submissions</span>
                            <div class="dp-ins-network" id="dp-drawer-ins-network" hidden>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
                                <span>In-network</span>
                            </div>
                            <div class="dp-ins-network is-out" id="dp-drawer-ins-out" hidden>
                                <span>Out-of-network / unverified</span>
                            </div>
                        </div>
                        <dl class="dp-drawer-dl">
                            <div><dt>Carrier</dt><dd id="dp-drawer-ins-carrier"></dd></div>
                            <div><dt>Plan name</dt><dd id="dp-drawer-ins-plan"></dd></div>
                            <div><dt>Member ID</dt><dd id="dp-drawer-ins-member"></dd></div>
                            <div><dt>Submitted on</dt><dd id="dp-drawer-ins-submitted"></dd></div>
                        </dl>
                        <p class="dp-ins-empty" id="dp-drawer-ins-empty" hidden>No insurance details on file for this patient.</p>
                    </div>
                </div>

                <div class="dp-drawer-section is-open" data-drawer-section>
                    <button type="button" class="dp-drawer-section-toggle" aria-expanded="true">
                        <span>Demographic information</span>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="dp-drawer-section-body">
                        <dl class="dp-drawer-dl">
                            <div><dt>Age</dt><dd id="dp-drawer-age"></dd></div>
                            <div><dt>Patient type</dt><dd id="dp-drawer-type"></dd></div>
                            <div><dt>Member since</dt><dd id="dp-drawer-member"></dd></div>
                        </dl>
                    </div>
                </div>

                <div class="dp-drawer-section" data-drawer-section>
                    <button type="button" class="dp-drawer-section-toggle" aria-expanded="false">
                        <span>Contact information</span>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="dp-drawer-section-body">
                        <dl class="dp-drawer-dl">
                            <div><dt>Phone</dt><dd id="dp-drawer-phone"></dd></div>
                            <div><dt>Email</dt><dd id="dp-drawer-email"></dd></div>
                        </dl>
                    </div>
                </div>

                <div class="dp-drawer-section" data-drawer-section>
                    <button type="button" class="dp-drawer-section-toggle" aria-expanded="false">
                        <span>Booking activity</span>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="dp-drawer-section-body">
                        <ul class="dp-drawer-history" id="dp-drawer-history"></ul>
                    </div>
                </div>
            </div>
        </div>

        <footer class="dp-drawer-footer" id="dp-drawer-footer" hidden>
            <div class="dp-drawer-footer-upcoming" id="dp-drawer-footer-upcoming">
                <button type="button" class="dp-drawer-footer-link" id="dp-drawer-request-call">Request a call</button>
                <div class="dp-drawer-edit">
                    <button type="button" class="dp-drawer-footer-edit" id="dp-drawer-edit-btn" aria-expanded="false" aria-haspopup="true" aria-controls="dp-drawer-edit-menu">
                        Edit appointment
                        <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
                    </button>
                    <div class="dp-drawer-edit-menu" id="dp-drawer-edit-menu" hidden role="menu">
                        <button type="button" role="menuitem" data-edit-action="modify">Modify appointment</button>
                        <button type="button" role="menuitem" data-edit-action="cancel">Cancel appointment</button>
                    </div>
                </div>
                <button type="button" class="dp-drawer-footer-confirm" id="dp-drawer-confirm">Confirm patient can be seen</button>
            </div>
            <button type="button" class="dp-drawer-footer-noshow" id="dp-drawer-noshow" hidden>Mark as no show</button>
            <button type="button" class="dp-drawer-footer-showed" id="dp-drawer-showed" hidden>Mark patient showed</button>
        </footer>
    </div>
</aside>

@section Scripts {
<script>
(function () {
  const backdrop = document.getElementById("dp-drawer-backdrop");
  const drawer = document.getElementById("dp-patient-drawer");
  const closeBtn = document.getElementById("dp-drawer-close");
  const loading = document.getElementById("dp-drawer-loading");
  const errorEl = document.getElementById("dp-drawer-error");
  const body = document.getElementById("dp-drawer-body");
  const footer = document.getElementById("dp-drawer-footer");
  const footerUpcoming = document.getElementById("dp-drawer-footer-upcoming");
  const requestCallBtn = document.getElementById("dp-drawer-request-call");
  const editBtn = document.getElementById("dp-drawer-edit-btn");
  const editMenu = document.getElementById("dp-drawer-edit-menu");
  const confirmBtn = document.getElementById("dp-drawer-confirm");
  const noShowBtn = document.getElementById("dp-drawer-noshow");
  const showedBtn = document.getElementById("dp-drawer-showed");
  let currentAppointmentId = null;
  let currentPhoneDigits = "";
  let toastTimer = null;

  function setText(id, value, fallback) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = value && String(value).trim() ? value : (fallback || "Not available");
  }

  function setHtmlLink(id, hrefPrefix, value) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!value || !String(value).trim()) {
      el.textContent = "Not provided";
      return;
    }
    const a = document.createElement("a");
    a.href = hrefPrefix + value;
    a.textContent = value;
    el.replaceChildren(a);
  }

  function showToast(message) {
    let toast = document.getElementById("dp-drawer-toast");
    if (!toast) {
      toast = document.createElement("div");
      toast.id = "dp-drawer-toast";
      toast.className = "dp-drawer-toast";
      drawer.querySelector(".dp-drawer-inner")?.appendChild(toast);
    }
    toast.textContent = message;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { toast.hidden = true; }, 2800);
  }

  function closeEditMenu() {
    if (!editMenu || !editBtn) return;
    editMenu.hidden = true;
    editBtn.setAttribute("aria-expanded", "false");
  }

  function openDrawer() {
    backdrop.hidden = false;
    drawer.classList.add("is-open");
    drawer.setAttribute("aria-hidden", "false");
    document.body.classList.add("dp-drawer-open");
  }

  function closeDrawer() {
    drawer.classList.remove("is-open");
    drawer.setAttribute("aria-hidden", "true");
    backdrop.hidden = true;
    if (footer) footer.hidden = true;
    closeEditMenu();
    document.body.classList.remove("dp-drawer-open");
  }

  window.dpOpenPatientPanel = async function (appointmentId) {
    currentAppointmentId = appointmentId;
    currentPhoneDigits = "";
    openDrawer();
    loading.hidden = false;
    errorEl.hidden = true;
    body.hidden = true;
    if (footer) footer.hidden = true;
    closeEditMenu();

    try {
      const res = await fetch("/Doctor/Calendar?handler=Panel&appointmentId=" + encodeURIComponent(appointmentId), {
        headers: { "Accept": "application/json" }
      });
      if (!res.ok) throw new Error("Could not load patient details.");
      const data = await res.json();

      if (data.isPmsBooked) {
        const badge = document.getElementById("dp-drawer-badge");
        badge.textContent = data.statusLabel || "PMS Booked";
        badge.className = "dp-drawer-badge status-confirmed";
        setText("dp-drawer-name", data.patientName || "PMS Booked");
        setText("dp-drawer-sub", "Booked in your practice management system", "");
        setText("dp-drawer-time", data.startsAt);
        setText("dp-drawer-reason", "PMS Booked");
        setText("dp-drawer-provider", null);
        setText("dp-drawer-location", null);
        document.querySelectorAll("[data-drawer-section]").forEach(function (section) {
          const label = section.querySelector(".dp-drawer-section-toggle span")?.textContent || "";
          if (label !== "Appointment details") {
            section.hidden = true;
          } else {
            section.hidden = false;
            section.classList.add("is-open");
          }
        });
        document.getElementById("dp-drawer-ins-empty").hidden = false;
        document.getElementById("dp-drawer-ins-head").hidden = true;
        document.getElementById("dp-drawer-history").replaceChildren();
        loading.hidden = true;
        body.hidden = false;
        if (footer) footer.hidden = true;
        return;
      }

      document.querySelectorAll("[data-drawer-section]").forEach(function (section) {
        section.hidden = false;
      });

      const badge = document.getElementById("dp-drawer-badge");
      badge.textContent = data.statusLabel || data.status || "";
      badge.className = "dp-drawer-badge " + statusBadgeClass(data.status);

      setText("dp-drawer-name", data.patientName);
      const patientType = data.patientType || (data.hasAccount ? "Existing patient" : "New patient");
      const subParts = [];
      if (data.dateOfBirth) subParts.push("DOB: " + data.dateOfBirth);
      subParts.push(patientType);
      setText("dp-drawer-sub", subParts.join(" | "), "");

      setText("dp-drawer-time", data.startsAt);
      setText("dp-drawer-reason", data.visitReason);
      setText("dp-drawer-provider", data.providerName);
      setText("dp-drawer-location", data.location || data.practiceName);

      const ins = data.insurance || {};
      const insHead = document.getElementById("dp-drawer-ins-head");
      const insEmpty = document.getElementById("dp-drawer-ins-empty");
      const insNetwork = document.getElementById("dp-drawer-ins-network");
      const insOut = document.getElementById("dp-drawer-ins-out");
      const insFields = [
        "dp-drawer-ins-carrier",
        "dp-drawer-ins-plan",
        "dp-drawer-ins-member",
        "dp-drawer-ins-submitted"
      ].map(function (id) { return document.getElementById(id).closest("div"); });

      if (ins.hasDetails) {
        insEmpty.hidden = true;
        insHead.hidden = false;
        insFields.forEach(function (el) { if (el) el.hidden = false; });
        document.getElementById("dp-drawer-ins-pill").hidden = !ins.submittedOn;
        insNetwork.hidden = ins.inNetwork !== true;
        insOut.hidden = !(ins.inNetwork === false && !ins.isSelfPay);
        setText("dp-drawer-ins-carrier", ins.isSelfPay ? "Self-pay" : ins.carrier, "Not specified");
        setText("dp-drawer-ins-plan", ins.planName, "Not specified");
        setText("dp-drawer-ins-member", ins.memberId, "Not specified");
        setText("dp-drawer-ins-submitted", ins.submittedOn, "Not specified");
      } else {
        insHead.hidden = true;
        insEmpty.hidden = false;
        insFields.forEach(function (el) { if (el) el.hidden = true; });
      }

      if (data.ageYears != null && data.dateOfBirth) {
        setText("dp-drawer-age", data.ageYears + " (DOB: " + data.dateOfBirth + ")");
      } else if (data.dateOfBirth) {
        setText("dp-drawer-age", "DOB: " + data.dateOfBirth);
      } else {
        setText("dp-drawer-age", null);
      }
      setText("dp-drawer-type", patientType);
      setText("dp-drawer-member", data.memberSince, data.hasAccount ? "Not available" : "—");

      const phoneDigits = (data.phone || "").replace(/\D/g, "");
      currentPhoneDigits = phoneDigits;
      if (requestCallBtn) requestCallBtn.disabled = !phoneDigits;
      setHtmlLink("dp-drawer-phone", "tel:", phoneDigits ? data.phone : null);
      if (phoneDigits) {
        const phoneEl = document.getElementById("dp-drawer-phone").querySelector("a");
        if (phoneEl) phoneEl.href = "tel:" + phoneDigits;
      }
      setHtmlLink("dp-drawer-email", "mailto:", data.email);

      const history = document.getElementById("dp-drawer-history");
      history.replaceChildren();
      if (!data.history || !data.history.length) {
        const li = document.createElement("li");
        li.className = "dp-drawer-empty";
        li.textContent = "No booking activity found.";
        history.appendChild(li);
      } else {
        data.history.forEach(function (row) {
          const li = document.createElement("li");
          li.innerHTML =
            "<div class=\"when\">" + escapeHtml(row.startsAt) + "</div>" +
            "<div class=\"reason\">" + escapeHtml(row.visitReason) + "</div>" +
            "<div class=\"status\">" + escapeHtml(row.statusLabel) + "</div>";
          history.appendChild(li);
        });
      }

      const alreadyConfirmed = String(data.status || "").toLowerCase() === "confirmed";
      if (confirmBtn) {
        confirmBtn.disabled = alreadyConfirmed || data.canConfirm === false;
        confirmBtn.textContent = alreadyConfirmed ? "Patient confirmed" : "Confirm patient can be seen";
      }

      let isPast = !!data.isPast;
      if (!isPast && data.startsAtIso) {
        const starts = new Date(data.startsAtIso);
        if (!Number.isNaN(starts.getTime())) {
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          const apptDay = new Date(starts);
          apptDay.setHours(0, 0, 0, 0);
          isPast = apptDay < today;
        }
      }
      footer?.classList.toggle("is-past", isPast);
      if (footerUpcoming) footerUpcoming.hidden = isPast;
      if (noShowBtn) {
        noShowBtn.hidden = !isPast;
        const alreadyNoShow = String(data.status || "").toLowerCase() === "patientnoshow";
        noShowBtn.disabled = alreadyNoShow || data.canMarkNoShow === false;
        noShowBtn.textContent = alreadyNoShow ? "Marked as no show" : "Mark as no show";
      }
      if (showedBtn) {
        showedBtn.hidden = !isPast;
        const alreadyCompleted = String(data.status || "").toLowerCase() === "completed";
        showedBtn.disabled = alreadyCompleted || data.canMarkCompleted === false;
        showedBtn.textContent = alreadyCompleted ? "Patient showed — billed" : "Mark patient showed";
      }

      loading.hidden = true;
      body.hidden = false;
      if (footer) footer.hidden = false;
    } catch (err) {
      loading.hidden = true;
      errorEl.hidden = false;
      errorEl.textContent = err.message || "Something went wrong.";
      if (footer) footer.hidden = true;
    }
  };

  function escapeHtml(value) {
    return String(value == null ? "" : value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function statusBadgeClass(status) {
    const s = String(status || "").toLowerCase();
    if (s === "confirmed") return "status-confirmed";
    if (s === "unconfirmed") return "status-unconfirmed";
    if (s.includes("reschedule")) return "status-reschedule";
    if (s === "patientnoshow") return "status-noshow";
    if (s === "completed") return "status-completed";
    if (s.includes("cancel")) return "status-cancelled";
    return "status-unconfirmed";
  }

  function antiForgeryToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
  }

  async function updateAppointmentStatus(status, busyEl) {
    if (!currentAppointmentId) return null;
    if (busyEl) busyEl.disabled = true;
    try {
      const form = new URLSearchParams();
      form.set("appointmentId", String(currentAppointmentId));
      form.set("status", status);
      const token = antiForgeryToken();
      if (token) form.set("__RequestVerificationToken", token);

      const res = await fetch("/Doctor/Calendar?handler=UpdateStatus", {
        method: "POST",
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
          "RequestVerificationToken": token,
          "Accept": "application/json"
        },
        body: form.toString()
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.message || "Could not update appointment.");
      return data;
    } finally {
      // caller may re-enable or keep disabled based on new status
    }
  }

  function applyStatusToDrawer(data) {
    const badge = document.getElementById("dp-drawer-badge");
    if (badge) {
      badge.textContent = data.statusLabel || data.status || "";
      badge.className = "dp-drawer-badge " + statusBadgeClass(data.status);
    }
    const status = String(data.status || "").toLowerCase();
    if (confirmBtn) {
      const confirmed = status === "confirmed";
      confirmBtn.disabled = confirmed;
      confirmBtn.textContent = confirmed ? "Patient confirmed" : "Confirm patient can be seen";
    }
    if (noShowBtn) {
      const noshow = status === "patientnoshow";
      noShowBtn.disabled = noshow;
      noShowBtn.textContent = noshow ? "Marked as no show" : "Mark as no show";
    }
    if (showedBtn) {
      const completed = status === "completed";
      showedBtn.disabled = completed;
      showedBtn.textContent = completed ? "Patient showed — billed" : "Mark patient showed";
    }
  }

  requestCallBtn?.addEventListener("click", () => {
    if (!currentPhoneDigits) {
      showToast("No phone number on file for this patient.");
      return;
    }
    window.location.href = "tel:" + currentPhoneDigits;
  });

  editBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const open = editMenu.hidden;
    editMenu.hidden = !open;
    editBtn.setAttribute("aria-expanded", open ? "true" : "false");
  });

  editMenu?.querySelectorAll("[data-edit-action]").forEach(btn => {
    btn.addEventListener("click", async () => {
      const action = btn.getAttribute("data-edit-action");
      closeEditMenu();
      if (action === "modify") {
        showToast("Modify appointment flow coming soon.");
        return;
      }
      if (action === "cancel") {
        if (!currentAppointmentId) return;
        if (!window.confirm("Cancel this appointment? The patient will see this as practice canceled.")) return;
        try {
          const data = await updateAppointmentStatus("PracticeCanceled", null);
          if (!data) return;
          applyStatusToDrawer(data);
          showToast("Marked as practice canceled.");
          if (data.remainsOnCalendar === false) {
            setTimeout(() => window.location.reload(), 700);
          }
        } catch (err) {
          showToast(err.message || "Could not cancel appointment.");
        }
      }
    });
  });

  confirmBtn?.addEventListener("click", async () => {
    if (!currentAppointmentId || confirmBtn.disabled) return;
    try {
      const data = await updateAppointmentStatus("Confirmed", confirmBtn);
      if (!data) return;
      applyStatusToDrawer(data);
      showToast("Marked as confirmed.");
    } catch (err) {
      confirmBtn.disabled = false;
      showToast(err.message || "Could not confirm appointment.");
    }
  });

  noShowBtn?.addEventListener("click", async () => {
    if (!currentAppointmentId || noShowBtn.disabled) return;
    try {
      const data = await updateAppointmentStatus("PatientNoShow", noShowBtn);
      if (!data) return;
      applyStatusToDrawer(data);
      showToast("Marked as patient no-show.");
      if (data.remainsOnCalendar === false) {
        setTimeout(() => window.location.reload(), 700);
      }
    } catch (err) {
      noShowBtn.disabled = false;
      showToast(err.message || "Could not mark no-show.");
    }
  });

  showedBtn?.addEventListener("click", async () => {
    if (!currentAppointmentId || showedBtn.disabled) return;
    try {
      const data = await updateAppointmentStatus("Completed", showedBtn);
      if (!data) return;
      applyStatusToDrawer(data);
      showToast(data.billingMessage || "Patient marked as showed.");
      if (data.remainsOnCalendar === false) {
        setTimeout(() => window.location.reload(), 900);
      }
    } catch (err) {
      showedBtn.disabled = false;
      showToast(err.message || "Could not mark patient as showed.");
    }
  });

  document.addEventListener("click", (e) => {
    if (!editMenu || editMenu.hidden) return;
    if (editMenu.contains(e.target) || editBtn.contains(e.target)) return;
    closeEditMenu();
  });

  closeBtn.addEventListener("click", closeDrawer);
  backdrop.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && drawer.classList.contains("is-open")) closeDrawer();
  });

  document.querySelectorAll("[data-drawer-section]").forEach(function (section) {
    const toggle = section.querySelector(".dp-drawer-section-toggle");
    if (!toggle) return;
    toggle.addEventListener("click", function () {
      const open = section.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
  });

  const params = new URLSearchParams(window.location.search);
  const openId = params.get("appointmentId");
  if (openId) dpOpenPatientPanel(Number(openId));
})();
</script>
}
