@page
@model Docovee.Pages.Doctor.CalendarModel
@{
    ViewData["Title"] = "Calendar";
    ViewData["Nav"] = "calendar";
    var prevWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
    var todayWeek = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var monthStart = new DateOnly(Model.MonthFocus.Year, Model.MonthFocus.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.MonthFocus.Year, Model.MonthFocus.Month);
    var lead = (int)monthStart.DayOfWeek;
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="dp-cal-layout">
    <aside class="dp-cal-rail">
        <div class="dp-mini-cal">
            <div class="dp-mini-cal-head">
                <span>@Model.MonthFocus.ToString("MMMM yyyy")</span>
                <span>
                    <a class="dp-icon-btn" href="/Doctor/Calendar?week=@monthStart.AddMonths(-1).ToString("yyyy-MM-dd")" aria-label="Previous month">‹</a>
                    <a class="dp-icon-btn" href="/Doctor/Calendar?week=@monthStart.AddMonths(1).ToString("yyyy-MM-dd")" aria-label="Next month">›</a>
                </span>
            </div>
            <div class="dp-mini-grid">
                @foreach (var d in new[] { "S", "M", "T", "W", "T", "F", "S" })
                {
                    <div class="dow">@d</div>
                }
                @for (var i = 0; i < lead; i++)
                {
                    <div class="dp-mini-day muted"></div>
                }
                @for (var day = 1; day <= daysInMonth; day++)
                {
                    var d = new DateOnly(Model.MonthFocus.Year, Model.MonthFocus.Month, day);
                    var href = $"/Doctor/Calendar?week={d:yyyy-MM-dd}";
                    <a class="dp-mini-day @(d == today ? "today" : "") @(Model.WeekDays.Contains(d) ? "in-week" : "")" href="@href">@day</a>
                }
            </div>
        </div>

        <div class="dp-filter-block">
            <div class="dp-filter-label">Display</div>
            <label><input type="checkbox" checked disabled /> Appointments</label>
        </div>

        <div class="dp-filter-block">
            <div class="dp-filter-label">Providers</div>
            <label><input type="checkbox" checked disabled /> @Model.ProviderName</label>
        </div>
    </aside>

    <div class="dp-cal-main">
        <div class="dp-cal-toolbar">
            <h1>@Model.WeekStart.ToString("MMM yyyy")</h1>
            <a class="dp-btn dp-btn-sm" href="/Doctor/Calendar?week=@todayWeek">Today</a>
            <div class="dp-cal-nav">
                <a class="dp-icon-btn" href="/Doctor/Calendar?week=@prevWeek">‹</a>
                <a class="dp-icon-btn" href="/Doctor/Calendar?week=@nextWeek">›</a>
            </div>
            <div style="margin-left:auto;font-size:13px;color:var(--dp-muted);">
                @Model.Appointments.Count appointment@(Model.Appointments.Count == 1 ? "" : "s") this week
            </div>
        </div>

        <div class="dp-provider-bar">
            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <img src="@Model.PhotoUrl" alt="" />
            }
            else
            {
                <span class="dp-logo-mark" style="width:32px;height:32px;font-size:12px;">D</span>
            }
            @Model.ProviderName
        </div>

        <div class="dp-week">
            <div class="dp-week-head"></div>
            @foreach (var day in Model.WeekDays)
            {
                <div class="dp-week-head">
                    @day.ToString("ddd")
                    <span class="day-num">@day.Day</span>
                </div>
            }

            @foreach (var hour in Model.HourStarts)
            {
                var label = DateTime.Today.AddHours(hour).ToString("h tt");
                <div class="dp-time-label">@label</div>
                @foreach (var day in Model.WeekDays)
                {
                    var appt = Model.FindAppointment(day, hour);
                    <div class="dp-slot">
                        @if (appt != null)
                        {
                            <div class="dp-appt" title="@appt.PatientName — @appt.VisitReason (@appt.Status)">
                                @CalendarModel.ShortName(appt.PatientName)
                                <small>@appt.VisitReason</small>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
