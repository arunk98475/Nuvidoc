@page
@model Docovee.Pages.Doctor.InboxModel
@{
    ViewData["Title"] = "Inbox";
    ViewData["Nav"] = "inbox";
    var f = Model.Filter ?? "all";
}

<div class="dp-split">
    <aside class="dp-rail">
        <div class="dp-rail-title">Filters</div>
        <a class="dp-rail-item @(f == "all" ? "active" : "")" href="/Doctor/Inbox"><span>All</span></a>
        <a class="dp-rail-item @(f == "new" ? "active" : "")" href="/Doctor/Inbox?filter=new">
            <span>New bookings</span>
            @if (Model.NewCount > 0) { <span class="dp-rail-count">@Model.NewCount</span> }
        </a>
        <a class="dp-rail-item @(f == "reschedule" ? "active" : "")" href="/Doctor/Inbox?filter=reschedule">
            <span>Reschedules</span>
            @if (Model.RescheduleCount > 0) { <span class="dp-rail-count">@Model.RescheduleCount</span> }
        </a>
        <a class="dp-rail-item @(f == "cancelled" ? "active" : "")" href="/Doctor/Inbox?filter=cancelled">
            <span>Cancellations</span>
            @if (Model.CancelledCount > 0) { <span class="dp-rail-count">@Model.CancelledCount</span> }
        </a>
    </aside>

    <div class="dp-panel">
        <div class="dp-page-head">
            <h1>Inbox</h1>
            <div class="dp-page-actions">
                <a class="dp-btn dp-btn-sm" href="/Doctor/Calendar">Open calendar</a>
            </div>
        </div>

        <form class="dp-search" method="get" action="/Doctor/Inbox">
            @if (!string.IsNullOrEmpty(Model.Filter) && Model.Filter != "all")
            {
                <input type="hidden" name="filter" value="@Model.Filter" />
            }
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" name="q" value="@Model.Search" placeholder="Search by patient name" />
        </form>

        <div class="dp-table-wrap">
            <table class="dp-table">
                <thead>
                    <tr>
                        <th>Last updated</th>
                        <th>Patient</th>
                        <th>Appointment date</th>
                        <th>Reason</th>
                        <th>Notifications</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Appointments.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="padding:28px 16px;color:var(--dp-muted);text-align:center;">
                            No bookings yet. When a patient requests a visit from your public profile, it will show up here.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var a in Model.Appointments)
                    {
                        <tr>
                            <td>@InboxModel.RelativeTime(a.UpdatedAt)</td>
                            <td>
                                <div>@a.PatientName</div>
                                @if (!string.IsNullOrWhiteSpace(a.PatientPhone))
                                {
                                    <div style="font-size:12px;color:var(--dp-muted);">@a.PatientPhone</div>
                                }
                            </td>
                            <td>@a.StartsAt.ToString("MMM d, yyyy · h:mm tt")</td>
                            <td>@a.VisitReason</td>
                            <td><span class="dp-tag @InboxModel.StatusCss(a.Status)">@InboxModel.StatusLabel(a.Status)</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="dp-footer-links">
            <a href="/Doctor/Calendar">Go to Calendar</a>
        </div>
    </div>
</div>
