@page "/doctors/{id:int}"
@model Docovee.Pages.Doctors.ProfileModel
@{
    Layout = null;
    var doctor = Model.Doctor;
    var locationParts = new[] { doctor.City, doctor.State, doctor.ZipCode }
        .Where(p => !string.IsNullOrWhiteSpace(p) && p != "NA");
    var location = string.Join(", ", locationParts);
    var cityState = string.Join(", ", new[] { doctor.City, doctor.State }.Where(p => !string.IsNullOrWhiteSpace(p) && p != "NA"));
    var procedures = string.IsNullOrWhiteSpace(doctor.Top3Procedures)
        ? Array.Empty<string>()
        : doctor.Top3Procedures.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    var mapQuery = string.Join(", ", new[] { doctor.Address, doctor.City, doctor.State, doctor.ZipCode }
        .Where(p => !string.IsNullOrWhiteSpace(p) && p != "NA"));
    var reviewCount = doctor.Reviews.Count;
    var avgRating = doctor.GoogleRating > 0
        ? doctor.GoogleRating
        : (reviewCount > 0 ? (decimal)doctor.Reviews.Average(r => r.Rating) : 0m);
    var totalReviews = doctor.GoogleReviewCount > 0 ? doctor.GoogleReviewCount : reviewCount;
    var isNewPatient = string.Equals(Request.Query["isNewPatient"], "true", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(Request.Query["isNewPatient"]);
    ViewData["Title"] = $"{doctor.Name} — {doctor.Specialty} | {Branding.SiteName}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@doctor.Name — @doctor.Specialty in @location. Book an appointment with @Branding.SiteName." />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
</head>
<body class="pp-page">

<nav>
    <div class="nav-left">
        <partial name="Shared/_SiteLogo" />
    </div>
    <div class="nav-right">
        <a href="/" class="nav-link">Find a Dentist</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/Account/Logout" class="nav-link">Logout</a>
        }
        else
        {
            <partial name="Shared/_AuthNav" />
        }
    </div>
</nav>

<div class="pp-wrap">
    <div class="pp-breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        @if (!string.IsNullOrWhiteSpace(cityState))
        {
            <span>@cityState</span>
            <span aria-hidden="true">›</span>
        }
        <span>@doctor.Specialty</span>
        <span aria-hidden="true">›</span>
        <span>@doctor.Name</span>
    </div>

    <div class="pp-grid">
        <div class="pp-main">
            <header class="pp-hero">
                <div class="pp-hero-top">
                    @if (!string.IsNullOrWhiteSpace(doctor.PhotoUrl))
                    {
                        <img class="pp-photo" src="@doctor.PhotoUrl" alt="@doctor.Name" />
                    }
                    else
                    {
                        <div class="pp-avatar" aria-hidden="true">@doctor.AvatarInitials</div>
                    }
                    <div class="pp-hero-info">
                        <h1 class="pp-name">@doctor.Name</h1>
                        <p class="pp-specialty">@doctor.Specialty</p>

                        @if (avgRating > 0)
                        {
                            <div class="pp-rating">
                                <span class="pp-stars" aria-label="@avgRating.ToString("0.0") out of 5">@RenderStars(avgRating)</span>
                                <strong>@avgRating.ToString("0.0")</strong>
                                <a class="pp-rating-link" href="#reviews">@totalReviews reviews</a>
                            </div>
                        }

                        <p class="pp-location-line">
                            @if (!string.IsNullOrWhiteSpace(doctor.PracticeName))
                            {
                                <strong>@doctor.PracticeName</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(location))
                            {
                                <span>@location</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(mapQuery))
                            {
                                <a class="pp-inline-link" href="#location">View map</a>
                            }
                        </p>

                        <div class="pp-facts">
                            <span class="pp-fact">Accepts new patients</span>
                            <span class="pp-fact">In-person visits</span>
                            @if (doctor.YearsOfPractice is > 0)
                            {
                                <span class="pp-fact">@doctor.YearsOfPractice+ years experience</span>
                            }
                            @if (doctor.OffersDentalImplants)
                            {
                                <span class="pp-fact">Dental implants</span>
                            }
                            @if (doctor.OffersTmj)
                            {
                                <span class="pp-fact">TMJ care</span>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(doctor.Niche))
                {
                    <p class="pp-tagline">@doctor.Niche</p>
                }
            </header>

            <nav class="pp-tabs" aria-label="Profile sections">
                <a class="pp-tab is-active" href="#overview">Overview</a>
                <a class="pp-tab" href="#insurances">Insurances</a>
                <a class="pp-tab" href="#location">Locations</a>
                <a class="pp-tab" href="#reviews">Reviews</a>
            </nav>

            <section class="pp-panel" id="overview">
                <h2 class="pp-section-title">About</h2>
                <p class="pp-body">
                    @doctor.Name is a @doctor.Specialty.ToLowerInvariant()
                    @if (!string.IsNullOrWhiteSpace(cityState))
                    {
                        <text> serving patients in @cityState</text>
                    }
                    .
                    @if (doctor.YearsOfPractice is > 0)
                    {
                        <text> With @doctor.YearsOfPractice years in practice, patients often highlight attentive care and a welcoming office experience.</text>
                    }
                    else
                    {
                        <text> Patients often highlight attentive care and a welcoming office experience.</text>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(doctor.SummaryOfReviews))
                {
                    <blockquote class="pp-highlight">
                        <strong>What patients say</strong>
                        <p>@doctor.SummaryOfReviews</p>
                    </blockquote>
                }

                @if (procedures.Length > 0)
                {
                    <h3 class="pp-subhead">Popular procedures</h3>
                    <div class="pp-chip-row">
                        @foreach (var proc in procedures)
                        {
                            <span class="pp-chip">@proc</span>
                        }
                    </div>
                }

                @if (doctor.OffersDentalImplants || doctor.OffersTmj || doctor.OffersBotox)
                {
                    <h3 class="pp-subhead">Special focus</h3>
                    <div class="pp-chip-row">
                        @if (doctor.OffersDentalImplants) { <span class="pp-chip">Dental implants</span> }
                        @if (doctor.OffersTmj) { <span class="pp-chip">TMJ</span> }
                        @if (doctor.OffersBotox) { <span class="pp-chip">Botox</span> }
                    </div>
                }

                @if (doctor.Languages.Count > 0)
                {
                    <h3 class="pp-subhead">Languages spoken</h3>
                    <p class="pp-body">@string.Join(", ", doctor.Languages)</p>
                }

                @if (doctor.YearsOfPractice is > 0 || doctor.GraduationYear is > 0)
                {
                    <h3 class="pp-subhead">Education & experience</h3>
                    <ul class="pp-list">
                        @if (doctor.YearsOfPractice is > 0)
                        {
                            <li>@doctor.YearsOfPractice+ years of practice</li>
                        }
                        @if (doctor.GraduationYear is > 0)
                        {
                            <li>Graduated @doctor.GraduationYear</li>
                        }
                    </ul>
                }

                @if (!string.IsNullOrWhiteSpace(doctor.VideoUrl))
                {
                    var videoUrl = doctor.VideoUrl!;
                    var embedUrl = GetVideoEmbedUrl(videoUrl);
                    <h3 class="pp-subhead">Meet @doctor.Name.Split(' ').FirstOrDefault()</h3>
                    @if (!string.IsNullOrEmpty(embedUrl))
                    {
                        <div class="pp-video-frame">
                            <iframe src="@embedUrl" title="Introduction video" allowfullscreen loading="lazy"></iframe>
                        </div>
                    }
                    else if (IsDirectVideoFile(videoUrl))
                    {
                        <div class="pp-video-frame">
                            <video controls preload="metadata" src="@videoUrl"></video>
                        </div>
                    }
                    else
                    {
                        <a class="pp-video-link" href="@videoUrl" target="_blank" rel="noopener noreferrer">▶ Watch introduction video</a>
                    }
                }
            </section>

            <section class="pp-panel" id="insurances">
                <h2 class="pp-section-title">In-network insurances</h2>
                <p class="pp-body">
                    Check that you're covered. Enter your insurance below in the booking card, or browse plans this office accepts.
                </p>

                @if (doctor.AcceptedInsurances.Count == 0)
                {
                    <p class="pp-muted">This office has not published insurance details yet. Please call to confirm coverage before your visit.</p>
                }
                else
                {
                    <p class="pp-muted pp-ins-count">@doctor.AcceptedInsurances.Sum(i => Math.Max(1, i.Plans.Count))+ in-network plans</p>
                    <div class="pp-insurer-grid">
                        @foreach (var ins in doctor.AcceptedInsurances)
                        {
                            <div class="pp-insurer-card">
                                <div class="pp-insurer-name">@ins.CarrierName</div>
                                @if (ins.Plans.Count > 0)
                                {
                                    <ul class="pp-insurer-plans">
                                        @foreach (var plan in ins.Plans.Take(4))
                                        {
                                            <li>@plan</li>
                                        }
                                    </ul>
                                    @if (ins.Plans.Count > 4)
                                    {
                                        <div class="pp-insurer-more">+ @(ins.Plans.Count - 4) more plans</div>
                                    }
                                }
                                else
                                {
                                    <div class="pp-insurer-more">Most plans accepted — verify in booking</div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="pp-panel" id="location">
                <h2 class="pp-section-title">Office location</h2>
                <div class="pp-location-card">
                    <div class="pp-location-copy">
                        @if (!string.IsNullOrWhiteSpace(doctor.PracticeName))
                        {
                            <h3 class="pp-subhead">@doctor.PracticeName</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(doctor.Address))
                        {
                            <p class="pp-body">@doctor.Address</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(location))
                        {
                            <p class="pp-body">@location</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(doctor.OfficePhoneNumber))
                        {
                            <a class="pp-phone-btn" href="tel:@RegexPhone(doctor.OfficePhoneNumber)">
                                Call @doctor.OfficePhoneNumber
                            </a>
                        }
                        <p class="pp-hint">Typical office hours: Mon–Fri 8:00 AM – 5:00 PM</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(mapQuery))
                    {
                        var mapSrc = $"https://maps.google.com/maps?q={Uri.EscapeDataString(mapQuery)}&z=15&output=embed";
                        <div class="pp-map-frame">
                            <iframe src="@mapSrc" title="Office map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                        <a class="pp-map-link" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(mapQuery)" target="_blank" rel="noopener noreferrer">
                            Get directions
                        </a>
                    }
                </div>
            </section>

            <section class="pp-panel" id="reviews">
                <div class="pp-reviews-head">
                    <h2 class="pp-section-title">Patient reviews</h2>
                    @if (avgRating > 0)
                    {
                        <div class="pp-reviews-score">
                            <span class="pp-stars">@RenderStars(avgRating)</span>
                            <strong>@avgRating.ToString("0.0")</strong>
                            <span class="pp-muted">(@totalReviews)</span>
                        </div>
                    }
                </div>

                @if (doctor.Reviews.Count == 0)
                {
                    <p class="pp-muted">No patient reviews yet.</p>
                }
                else
                {
                    <div class="pp-reviews">
                        @foreach (var review in doctor.Reviews)
                        {
                            <article class="pp-review">
                                <div class="pp-review-top">
                                    <div class="pp-review-avatar" aria-hidden="true">
                                        @(string.IsNullOrWhiteSpace(review.ReviewerName) ? "?" : review.ReviewerName.Trim()[0].ToString().ToUpperInvariant())
                                    </div>
                                    <div>
                                        <strong>@review.ReviewerName</strong>
                                        <div class="pp-stars">@RenderStars(review.Rating)</div>
                                    </div>
                                </div>
                                <p class="pp-review-text">“@review.ReviewText”</p>
                                @if (!string.IsNullOrWhiteSpace(review.WaitingTime) || !string.IsNullOrWhiteSpace(review.Recommendation))
                                {
                                    <div class="pp-review-meta">
                                        @if (!string.IsNullOrWhiteSpace(review.WaitingTime))
                                        {
                                            <span>Wait time: <strong>@review.WaitingTime</strong></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(review.Recommendation))
                                        {
                                            <span>@review.Recommendation</span>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="pp-sidebar">
            <div class="pp-booking-card" id="pp-booking">
                <h2 class="pp-booking-title">Book a visit</h2>
                <p class="pp-booking-sub">See availability and request an appointment — the office will confirm.</p>

                <div class="pp-insurance-check">
                    <label class="pp-field-label" for="pp-insurance-carrier">Insurance carrier and plan</label>
                    <select id="pp-insurance-carrier" class="pp-select" aria-label="Insurance carrier">
                        <option value="">I'll choose insurance later</option>
                        <option value="none">I'm paying without insurance</option>
                        @foreach (var carrier in Model.InsuranceCatalog)
                        {
                            <option value="@carrier.Id">@carrier.Name</option>
                        }
                    </select>
                    <select id="pp-insurance-plan" class="pp-select" aria-label="Insurance plan" disabled>
                        <option value="">Select a plan</option>
                    </select>
                    <p class="pp-network-status" id="pp-network-status" hidden></p>
                </div>

                <div class="pp-patient-toggle" role="group" aria-label="Patient type">
                    <button type="button" class="pp-toggle-btn@(isNewPatient ? " is-active" : "")" id="pp-new-patient" data-new="true">New patient</button>
                    <button type="button" class="pp-toggle-btn@(!isNewPatient ? " is-active" : "")" id="pp-existing-patient" data-new="false">Existing patient</button>
                </div>

                <label class="pp-field-label" for="pp-visit-reason">Reason for visit</label>
                <select id="pp-visit-reason" class="pp-select">
                    <partial name="Shared/_VisitReasonOptions" />
                </select>

                <div class="pp-avail-label">Available times</div>
                <div class="pp-day-tabs" role="tablist" aria-label="Available days">
                    @for (var i = 0; i < Model.BookingDays.Count; i++)
                    {
                        var day = Model.BookingDays[i];
                        <button type="button"
                                class="pp-day-tab@(i == 0 ? " is-active" : "")"
                                data-day-index="@i"
                                onclick="ppSelectDay(@i)">
                            <span class="pp-day-name">@day.DayLabel</span>
                            <span class="pp-day-date">@day.DateLabel</span>
                        </button>
                    }
                </div>

                @for (var i = 0; i < Model.BookingDays.Count; i++)
                {
                    var day = Model.BookingDays[i];
                    <div class="pp-slot-grid@(i == 0 ? " is-active" : "")" data-day-panel="@i"@Html.Raw(i == 0 ? "" : " hidden")>
                        @foreach (var slot in day.Slots)
                        {
                            if (slot.Available)
                            {
                                <button type="button"
                                        class="pp-slot"
                                        data-date="@day.DateIso"
                                        data-day="@day.DateLabel"
                                        data-time="@slot.TimeLabel"
                                        onclick="ppSelectSlot(this)">
                                    @slot.TimeLabel
                                </button>
                            }
                            else
                            {
                                <button type="button" class="pp-slot is-unavailable" disabled title="Already booked">
                                    @slot.TimeLabel
                                </button>
                            }
                        }
                    </div>
                }

                <div class="pp-patient-details" id="pp-patient-details">
                    <label class="pp-field-label" for="pp-patient-name">Your name</label>
                    <input id="pp-patient-name" class="pp-select" type="text" autocomplete="name"
                           value="@Model.PrefillName" placeholder="Legal full name" />

                    <label class="pp-field-label" for="pp-patient-phone">Phone</label>
                    <input id="pp-patient-phone" class="pp-select" type="tel" autocomplete="tel"
                           value="@Model.PrefillPhone" placeholder="(555) 555-5555" />

                    <label class="pp-field-label" for="pp-patient-email">Email <span class="pp-hint-inline">(optional)</span></label>
                    <input id="pp-patient-email" class="pp-select" type="email" autocomplete="email"
                           value="@Model.PrefillEmail" placeholder="you@email.com" />

                    <label class="pp-field-label" for="pp-patient-dob">Date of birth</label>
                    <input id="pp-patient-dob" class="pp-select" type="date" autocomplete="bday"
                           value="@Model.PrefillDateOfBirth" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>

                <button type="button" class="pp-book-btn" id="pp-book-btn" disabled onclick="ppConfirmBooking()">
                    Select a time to continue
                </button>
                <p class="pp-booking-note" id="pp-booking-note" hidden></p>
            </div>
        </aside>
    </div>
</div>

<footer class="site-footer site-footer-rich">
    <div class="site-footer-inner">
        <div class="site-footer-brand">@Branding.SiteName.ToLowerInvariant().</div>
        <div class="site-footer-copy">© @DateTime.UtcNow.Year @Branding.SiteName · Not medical advice · For emergencies call 911</div>
    </div>
</footer>

<script>
(function () {
  const doctorId = @doctor.Id;
  const acceptedCarrierIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(doctor.AcceptedInsuranceCarrierIds));
  const insuranceCatalog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      Model.InsuranceCatalog,
      new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
  let selectedSlot = null;
  let submitting = false;
  let isNewPatient = @(isNewPatient ? "true" : "false");

  const carrierSelect = document.getElementById("pp-insurance-carrier");
  const planSelect = document.getElementById("pp-insurance-plan");
  const networkStatus = document.getElementById("pp-network-status");

  function updatePlans() {
    const carrierId = carrierSelect.value;
    planSelect.innerHTML = '<option value="">Select a plan</option>';
    planSelect.disabled = true;

    if (!carrierId || carrierId === "none") {
      updateNetworkStatus();
      return;
    }

    const carrier = insuranceCatalog.find((c) => String(c.id) === String(carrierId) || String(c.Id) === String(carrierId));
    const plans = (carrier && (carrier.plans || carrier.Plans)) || [];
    plans.forEach((p) => {
      const opt = document.createElement("option");
      opt.value = p.name || p.Name;
      opt.textContent = p.name || p.Name;
      planSelect.appendChild(opt);
    });
    planSelect.disabled = plans.length === 0;
    updateNetworkStatus();
  }

  function updateNetworkStatus() {
    const carrierId = carrierSelect.value;
    networkStatus.hidden = true;
    networkStatus.className = "pp-network-status";

    if (!carrierId) return;

    if (carrierId === "none") {
      networkStatus.hidden = false;
      networkStatus.textContent = "You'll pay without insurance for this visit.";
      return;
    }

    const accepted = acceptedCarrierIds.map(String).includes(String(carrierId));
    networkStatus.hidden = false;
    if (accepted) {
      networkStatus.classList.add("is-in-network");
      networkStatus.textContent = "In-network — this office accepts your insurance carrier.";
    } else {
      networkStatus.classList.add("is-out-network");
      networkStatus.textContent = "This carrier may be out-of-network. Call the office to confirm coverage.";
    }
  }

  carrierSelect?.addEventListener("change", updatePlans);
  planSelect?.addEventListener("change", updateNetworkStatus);

  document.querySelectorAll(".pp-toggle-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      document.querySelectorAll(".pp-toggle-btn").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      isNewPatient = btn.dataset.new === "true";
      const url = new URL(window.location.href);
      url.searchParams.set("isNewPatient", isNewPatient ? "true" : "false");
      window.history.replaceState({}, "", url.pathname + url.search + url.hash);
    });
  });

  document.querySelectorAll(".pp-tab").forEach((tab) => {
    tab.addEventListener("click", function () {
      document.querySelectorAll(".pp-tab").forEach((t) => t.classList.remove("is-active"));
      tab.classList.add("is-active");
    });
  });

  window.ppSelectDay = function (index) {
    document.querySelectorAll(".pp-day-tab").forEach((tab) => {
      tab.classList.toggle("is-active", Number(tab.dataset.dayIndex) === index);
    });
    document.querySelectorAll("[data-day-panel]").forEach((panel) => {
      const active = Number(panel.dataset.dayPanel) === index;
      panel.classList.toggle("is-active", active);
      panel.hidden = !active;
    });
  };

  window.ppSelectSlot = function (btn) {
    if (btn.disabled) return;
    document.querySelectorAll(".pp-slot").forEach((el) => el.classList.remove("is-selected"));
    btn.classList.add("is-selected");
    selectedSlot = { date: btn.dataset.date, day: btn.dataset.day, time: btn.dataset.time };
    const bookBtn = document.getElementById("pp-book-btn");
    bookBtn.disabled = false;
    bookBtn.textContent = "Request " + selectedSlot.day + " · " + selectedSlot.time;
    const note = document.getElementById("pp-booking-note");
    note.hidden = true;
    note.classList.remove("is-error");
    document.getElementById("pp-patient-details")?.scrollIntoView({ behavior: "smooth", block: "nearest" });
  };

  window.ppConfirmBooking = async function () {
    if (!selectedSlot || submitting) return;

    const name = (document.getElementById("pp-patient-name").value || "").trim();
    const phone = (document.getElementById("pp-patient-phone").value || "").trim();
    const email = (document.getElementById("pp-patient-email").value || "").trim();
    const dateOfBirth = (document.getElementById("pp-patient-dob").value || "").trim();
    const reason = document.getElementById("pp-visit-reason").value;
    const note = document.getElementById("pp-booking-note");
    const bookBtn = document.getElementById("pp-book-btn");

    if (!reason) {
      note.hidden = false;
      note.classList.add("is-error");
      note.textContent = "Please select a reason for visit.";
      return;
    }

    if (name.length < 2) {
      note.hidden = false;
      note.classList.add("is-error");
      note.textContent = "Please enter your name so the office can reach you.";
      return;
    }

    if (!dateOfBirth) {
      note.hidden = false;
      note.classList.add("is-error");
      note.textContent = "Please enter your date of birth.";
      return;
    }

    submitting = true;
    bookBtn.disabled = true;
    bookBtn.textContent = "Sending request…";
    note.hidden = true;

    try {
      const res = await fetch("/api/bookings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          doctorId: doctorId,
          patientName: name,
          patientPhone: phone || null,
          patientEmail: email || null,
          dateOfBirth: dateOfBirth,
          visitReason: reason,
          date: selectedSlot.date,
          timeLabel: selectedSlot.time,
          source: "PublicProfile",
          isNewPatient: isNewPatient,
          insuranceCarrierId: (carrierSelect?.value && carrierSelect.value !== "none") ? Number(carrierSelect.value) : null,
          insurancePlan: (planSelect?.value || "").trim() || null
        })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) {
        throw new Error(data.message || "Could not send booking request. Please try again.");
      }
      note.hidden = false;
      note.classList.remove("is-error");
      note.textContent = data.message
        || ("Thanks! Your request for " + selectedSlot.day + " at " + selectedSlot.time
          + " was sent. The office will confirm your appointment.");
      bookBtn.textContent = "Request sent";
      selectedSlot = null;
    } catch (err) {
      note.hidden = false;
      note.classList.add("is-error");
      note.textContent = err.message || "Something went wrong. Please try again.";
      bookBtn.disabled = false;
      bookBtn.textContent = "Try again";
      submitting = false;
    }
  };
})();
</script>
</body>
</html>

@functions {
    private static string RenderStars(decimal rating)
    {
        var full = (int)Math.Round(rating, MidpointRounding.AwayFromZero);
        full = Math.Clamp(full, 0, 5);
        return new string('★', full) + new string('☆', 5 - full);
    }

    private static string RenderStars(int rating) => RenderStars((decimal)rating);

    private static string RegexPhone(string phone) =>
        new string(phone.Where(char.IsDigit).ToArray());

    private static string? GetVideoEmbedUrl(string url)
    {
        var trimmed = url.Trim();
        var yt = System.Text.RegularExpressions.Regex.Match(
            trimmed,
            @"(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([\w-]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (yt.Success)
            return $"https://www.youtube.com/embed/{yt.Groups[1].Value}";

        var vimeo = System.Text.RegularExpressions.Regex.Match(
            trimmed,
            @"vimeo\.com\/(?:video\/)?(\d+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (vimeo.Success)
            return $"https://player.vimeo.com/video/{vimeo.Groups[1].Value}";

        var loom = System.Text.RegularExpressions.Regex.Match(
            trimmed,
            @"loom\.com\/share\/([\w-]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (loom.Success)
            return $"https://www.loom.com/embed/{loom.Groups[1].Value}";

        return null;
    }

    private static bool IsDirectVideoFile(string url) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            url,
            @"\.(mp4|webm|ogg|mov|m4v)(\?|$)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
}
