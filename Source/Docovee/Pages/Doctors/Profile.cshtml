@functions {
    private static string RenderStars(decimal rating)
    {
        var full = (int)Math.Round(rating, MidpointRounding.AwayFromZero);
        full = Math.Clamp(full, 0, 5);
        return new string('★', full) + new string('☆', 5 - full);
    }
    private static string RenderStars(int rating) => RenderStars((decimal)rating);
    private static string RegexPhone(string phone) => new string(phone.Where(char.IsDigit).ToArray());

    private static string DoctorShortName(string name)
    {
        var trimmed = name.Trim();
        if (trimmed.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase))
            trimmed = trimmed[3..].TrimStart();
        else if (trimmed.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase))
            trimmed = trimmed[3..].TrimStart();

        var parts = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[^1] : trimmed;
    }

    private static string FormatCityList(IReadOnlyList<string> cities)
    {
        if (cities.Count == 0)
            return "";
        if (cities.Count == 1)
            return cities[0];
        if (cities.Count == 2)
            return $"{cities[0]} and {cities[1]}";
        return string.Join(", ", cities.Take(cities.Count - 1)) + ", and " + cities[^1];
    }

    private static decimal? AverageWaitScore(IEnumerable<PublicDoctorReviewDto> reviews)
    {
        var scores = reviews
            .Select(r => ScoreWaitingTime(r.WaitingTime))
            .Where(s => s.HasValue)
            .Select(s => s!.Value)
            .ToList();
        return scores.Count > 0 ? Math.Round(scores.Average(), 2) : null;
    }

    private static decimal? AverageRecommendationScore(IEnumerable<PublicDoctorReviewDto> reviews)
    {
        var scores = reviews
            .Select(r => ScoreRecommendation(r.Recommendation))
            .Where(s => s.HasValue)
            .Select(s => s!.Value)
            .ToList();
        return scores.Count > 0 ? Math.Round(scores.Average(), 2) : null;
    }

    private static decimal? ScoreWaitingTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;
        return value.Trim().ToLowerInvariant() switch
        {
            "excellent" => 5m,
            "good" => 4m,
            "average" => 3m,
            "bad" => 2m,
            _ => null
        };
    }

    private static decimal? ScoreRecommendation(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;
        return value.Trim().ToLowerInvariant() switch
        {
            "highly recommended" => 5m,
            "neutral" => 3m,
            "not recommended" => 1m,
            _ => null
        };
    }

    private static string? GetVideoEmbedUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return null;
        var trimmed = url.Trim();
        var yt = System.Text.RegularExpressions.Regex.Match(
            trimmed,
            @"(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([\w-]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (yt.Success)
            return $"https://www.youtube.com/embed/{yt.Groups[1].Value}";

        var vimeo = System.Text.RegularExpressions.Regex.Match(
            trimmed,
            @"vimeo\.com\/(?:video\/)?(\d+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (vimeo.Success)
            return $"https://player.vimeo.com/video/{vimeo.Groups[1].Value}";

        var loom = System.Text.RegularExpressions.Regex.Match(
            trimmed,
            @"loom\.com\/share\/([\w-]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (loom.Success)
            return $"https://www.loom.com/embed/{loom.Groups[1].Value}";

        return null;
    }

    private static bool IsDirectVideoFile(string url) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            url,
            @"\.(mp4|webm|ogg|mov|m4v)(\?|$)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
}
