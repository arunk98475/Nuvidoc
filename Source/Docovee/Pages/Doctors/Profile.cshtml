@page "/doctors/{id:int}"
@model Docovee.Pages.Doctors.ProfileModel
@{
    Layout = null;
    var doctor = Model.Doctor;
    var streetCity = string.Join(", ", new[] { doctor.Address, doctor.City, doctor.State }
        .Where(p => !string.IsNullOrWhiteSpace(p) && p != "NA"));
    var fullAddress = string.Join(", ", new[] { doctor.Address, doctor.City, doctor.State, doctor.ZipCode }
        .Where(p => !string.IsNullOrWhiteSpace(p) && p != "NA"));
    var mapQuery = fullAddress;
    var reviewCount = doctor.Reviews.Count;
    var avgRating = doctor.GoogleRating > 0
        ? doctor.GoogleRating
        : (reviewCount > 0 ? (decimal)doctor.Reviews.Average(r => r.Rating) : 0m);
    var totalReviews = doctor.GoogleReviewCount > 0 ? doctor.GoogleReviewCount : reviewCount;
    var isNewPatient = !string.Equals(Request.Query["isNewPatient"], "false", StringComparison.OrdinalIgnoreCase);
    var lastGoogleReview = doctor.GoogleReviews.FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.ReviewText));
    var googleReviews = doctor.GoogleReviews
        .Where(r => !string.IsNullOrWhiteSpace(r.ReviewText))
        .ToList();
    var featuredReview = doctor.Reviews.OrderByDescending(r => r.Rating).FirstOrDefault()
        ?? lastGoogleReview;
    var planCount = doctor.AcceptedInsurances.Sum(i => Math.Max(1, i.Plans.Count));
    var morePlans = Math.Max(0, planCount - Math.Min(5, doctor.AcceptedInsurances.Count));
    var visibleDays = Model.VisibleBookingDays;
    var firstDay = visibleDays.FirstOrDefault();
    var lastDay = visibleDays.LastOrDefault();
    var dateRangeLabel = firstDay != null && lastDay != null
        ? $"{firstDay.Date:ddd, MMM d} – {lastDay.Date:ddd, MMM d}"
        : "";
    string[] popularReasons =
    [
        "Bridge", "Dental Cleaning", "Dental Consultation", "Dental Surgery",
        "Pediatric Dentist Consultation", "Periodontal Maintenance", "Retainer Checkup", "Root Canal",
        "Tooth Jewelery", "Veneer(s)", "Cavities", "Crown", "Filling", "Teeth Whitening",
        "Dental Implant(s)", "Broken Tooth", "Dental Emergency", "Routine Dental Exam",
        "Scaling and Root Planing", "Night Guard/Occlusal Guard"
    ];
    ViewData["Title"] = $"{doctor.Name} — {doctor.Specialty} | {Branding.SiteName}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <partial name="Shared/_Favicon" />
    <meta name="description" content="@doctor.Name — @doctor.Specialty. Book with @Branding.SiteName." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doctor-public-profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/plyr@3.8.4/dist/plyr.css" crossorigin="anonymous" />
</head>
<body class="zd-page">

<partial name="Shared/_PublicNav" />

<div class="zd-shell">
    <div class="zd-layout">
        <div class="zd-main">
            <section class="zd-hero">
                @{
                    var clinicPhotos = doctor.Media.Where(m => m.MediaType == "Clinic").ToList();
                    var teamPhotos = doctor.Media.Where(m => m.MediaType == "Team").ToList();
                    var smilePhotos = doctor.Media.Where(m => m.MediaType == "Smile").ToList();
                    var familyPhotos = doctor.Media.Where(m => m.MediaType == "Family").ToList();
                    var petsPhotos = doctor.Media.Where(m => m.MediaType == "Pets").ToList();
                    var heroGallery = clinicPhotos.Concat(teamPhotos).Take(8).ToList();
                    var videos = doctor.Media.Where(m => m.MediaType == "Video").ToList();
                    var hasGallery = teamPhotos.Count > 0 || smilePhotos.Count > 0
                        || familyPhotos.Count > 0 || petsPhotos.Count > 0;
                    var hasSocial = !string.IsNullOrWhiteSpace(doctor.FacebookUrl)
                        || !string.IsNullOrWhiteSpace(doctor.InstagramUrl)
                        || !string.IsNullOrWhiteSpace(doctor.TikTokUrl)
                        || !string.IsNullOrWhiteSpace(doctor.LinkedInUrl)
                        || !string.IsNullOrWhiteSpace(doctor.YoutubeChannelUrl);
                    var legacyVideoEmbed = videos.Count == 0 ? GetVideoEmbedUrl(doctor.VideoUrl) : null;
                    var legacyIsDirectVideo = videos.Count == 0
                        && !string.IsNullOrWhiteSpace(doctor.VideoUrl)
                        && IsDirectVideoFile(doctor.VideoUrl!);
                    var hasVideos = videos.Count > 0 || legacyIsDirectVideo || legacyVideoEmbed != null;
                }
                @if (heroGallery.Count > 0)
                {
                    <div class="zd-gallery-strip-wrap" data-zd-gallery-strip>
                        <button type="button" class="zd-gallery-seek zd-gallery-seek-prev" aria-label="Previous photos" hidden>
                            <img src="~/images/gallery-arrow-prev.png" asp-append-version="true" alt="" width="18" height="18" />
                        </button>
                        <div class="zd-gallery-strip" aria-label="Clinic photos">
                            @foreach (var photo in heroGallery)
                            {
                                <figure class="zd-gallery-item">
                                    <button type="button" class="zd-lightbox-trigger"
                                            data-zd-src="@photo.Url"
                                            data-zd-alt="@(photo.Caption ?? doctor.PracticeName ?? doctor.Name)"
                                            aria-label="View photo larger">
                                        <img src="@photo.Url" alt="@(photo.Caption ?? doctor.PracticeName ?? doctor.Name)" loading="lazy" />
                                    </button>
                                </figure>
                            }
                        </div>
                        <button type="button" class="zd-gallery-seek zd-gallery-seek-next" aria-label="Next photos" hidden>
                            <img src="~/images/gallery-arrow-next.png" asp-append-version="true" alt="" width="18" height="18" />
                        </button>
                    </div>
                }
                <div class="zd-hero-row">
                    @if (!string.IsNullOrWhiteSpace(doctor.PhotoUrl))
                    {
                        <img class="zd-photo" src="@doctor.PhotoUrl" alt="@doctor.Name" width="120" height="120" />
                    }
                    else
                    {
                        <div class="zd-photo zd-photo-fallback">@doctor.AvatarInitials</div>
                    }
                    <div class="zd-hero-copy">
                        @if (!string.IsNullOrWhiteSpace(doctor.PracticeName))
                        {
                            <div class="zd-hero-brand">
                                <span class="zd-practice-name">@doctor.PracticeName</span>
                            </div>
                        }
                        <h1 class="zd-name">@doctor.Name</h1>
                        <p class="zd-specialty">@doctor.Specialty</p>
                        @if (!string.IsNullOrWhiteSpace(streetCity))
                        {
                            <p class="zd-address">@streetCity</p>
                        }
                        @if (hasSocial)
                        {
                            <div class="zd-social" aria-label="Social links">
                                @if (!string.IsNullOrWhiteSpace(doctor.FacebookUrl))
                                {
                                    <a href="@doctor.FacebookUrl" target="_blank" rel="noopener noreferrer" class="zd-social-link" aria-label="Facebook">Facebook</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(doctor.InstagramUrl))
                                {
                                    <a href="@doctor.InstagramUrl" target="_blank" rel="noopener noreferrer" class="zd-social-link" aria-label="Instagram">Instagram</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(doctor.TikTokUrl))
                                {
                                    <a href="@doctor.TikTokUrl" target="_blank" rel="noopener noreferrer" class="zd-social-link" aria-label="TikTok">TikTok</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(doctor.LinkedInUrl))
                                {
                                    <a href="@doctor.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="zd-social-link" aria-label="LinkedIn">LinkedIn</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(doctor.YoutubeChannelUrl))
                                {
                                    <a href="@doctor.YoutubeChannelUrl" target="_blank" rel="noopener noreferrer" class="zd-social-link" aria-label="YouTube">YouTube</a>
                                }
                            </div>
                        }
                    </div>
                    <div class="zd-hero-actions">
                        @if (!string.IsNullOrWhiteSpace(doctor.OfficePhoneNumber))
                        {
                            <a class="zd-icon-btn zd-icon-btn-call" href="tel:@RegexPhone(doctor.OfficePhoneNumber)">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.68 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.74.32 1.53.55 2.34.68A2 2 0 0 1 22 16.92z"/>
                                </svg>
                                Call
                            </a>
                        }
                        <button type="button" class="zd-icon-btn" onclick="navigator.share ? navigator.share({title: '@doctor.Name', url: location.href}) : navigator.clipboard.writeText(location.href)">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M12 3v12"/><path d="m7 8 5-5 5 5"/></svg>
                            Share
                        </button>
                        <button type="button" class="zd-icon-btn" id="zd-save-btn">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                            Save
                        </button>
                    </div>
                </div>

                @if (avgRating > 0 || featuredReview != null)
                {
                    <div class="zd-rating-card">
                        <div class="zd-rating-left">
                            <div class="zd-rating-num">@avgRating.ToString("0.00")</div>
                            <div class="zd-stars">@RenderStars(avgRating)</div>
                        </div>
                        <div class="zd-rating-right">
                            @if (featuredReview != null)
                            {
                                <p class="zd-quote">“@(featuredReview.ReviewText.Length > 140 ? featuredReview.ReviewText[..137] + "…" : featuredReview.ReviewText)”</p>
                            }
                            <a class="zd-see-reviews" href="#reviews">See all @totalReviews reviews</a>
                        </div>
                    </div>
                }
            </section>

            <nav class="zd-tabs" aria-label="Profile sections">
                <a class="zd-tab is-active" href="#highlights">Highlights</a>
                <a class="zd-tab" href="#about">About</a>
                @if (hasGallery)
                {
                    <a class="zd-tab" href="#gallery">Gallery</a>
                }
                <a class="zd-tab" href="#insurances">Insurances</a>
                <a class="zd-tab" href="#location">Location</a>
                <a class="zd-tab" href="#reviews">Reviews</a>
                <a class="zd-tab" href="#faqs">FAQs</a>
            </nav>

            <section class="zd-section" id="highlights">
                <ul class="zd-highlights">
                    @if (avgRating >= 4.5m)
                    {
                        <li>
                            <span class="zd-hi-ico" aria-hidden="true">🎉</span>
                            <div>
                                <strong>Highly recommended</strong>
                                <p>@(totalReviews > 0 ? "100%" : "Most") of patients gave this doctor 5 stars</p>
                            </div>
                        </li>
                    }
                    <li>
                        <span class="zd-hi-ico" aria-hidden="true">⏱</span>
                        <div>
                            <strong>Excellent wait time</strong>
                            <p>100% of patients waited less than 30 minutes</p>
                        </div>
                    </li>
                    <li>
                        <span class="zd-hi-ico" aria-hidden="true">📅</span>
                        <div>
                            <strong>New patient appointments</strong>
                            <p>Appointments available for new patients on @Branding.SiteName</p>
                        </div>
                    </li>
                    @if (doctor.AcceptedInsurances.Count > 0)
                    {
                        <li>
                            <span class="zd-hi-ico" aria-hidden="true">🛡</span>
                            <div>
                                <strong>In-network Insurances</strong>
                                <p>
                                    @string.Join(", ", doctor.AcceptedInsurances.Take(5).Select(i => i.CarrierName))
                                    @if (doctor.AcceptedInsurances.Count > 5 || morePlans > 0)
                                    {
                                        <a href="#insurances">(@(Math.Max(doctor.AcceptedInsurances.Count - 5, morePlans))) more in-network plans</a>
                                    }
                                </p>
                            </div>
                        </li>
                    }
                </ul>
            </section>

            <section class="zd-section" id="about">
                <h2 class="zd-h2">About @doctor.Name</h2>
                <p class="zd-body zd-about-text" id="zd-about-text">
                    @doctor.Name is a @doctor.Specialty.ToLowerInvariant()
                    @if (!string.IsNullOrWhiteSpace(streetCity)) { <text> practicing at @streetCity</text> }.
                    @if (doctor.YearsOfPractice is > 0)
                    {
                        <text> With @doctor.YearsOfPractice years of experience, patients often highlight attentive care and a welcoming office.</text>
                    }
                    @if (!string.IsNullOrWhiteSpace(doctor.Niche))
                    {
                        <text> @doctor.Niche</text>
                    }
                    @if (!string.IsNullOrWhiteSpace(doctor.SummaryOfReviews))
                    {
                        <text> @doctor.SummaryOfReviews</text>
                    }
                </p>
                <button type="button" class="zd-text-btn" id="zd-about-toggle" hidden>show more</button>

                @if (hasVideos)
                {
                    <div class="zd-video">
                        <h3 class="zd-h3">Videos</h3>
                        @if (videos.Count > 0)
                        {
                            <div class="zd-video-list">
                                @foreach (var video in videos)
                                {
                                    var itemEmbed = GetVideoEmbedUrl(video.Url);
                                    <div class="zd-video-item">
                                        @if (itemEmbed != null)
                                        {
                                            <div class="zd-video-frame">
                                                <iframe src="@itemEmbed" title="@(video.Caption ?? $"Video for {doctor.Name}")" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                                            </div>
                                        }
                                        else
                                        {
                                            <video class="zd-video-player js-plyr" src="@video.Url" controls preload="metadata" playsinline></video>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(video.Caption))
                                        {
                                            <p class="zd-video-caption">@video.Caption</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (legacyIsDirectVideo)
                        {
                            <video class="zd-video-player js-plyr" src="@doctor.VideoUrl" controls preload="metadata" playsinline></video>
                        }
                        else if (legacyVideoEmbed != null)
                        {
                            <div class="zd-video-frame">
                                <iframe src="@legacyVideoEmbed" title="Video for @doctor.Name" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
                            </div>
                        }
                    </div>
                }
            </section>

            @if (hasGallery)
            {
                <section class="zd-section" id="gallery">
                    <h2 class="zd-h2">Gallery</h2>
                    @if (teamPhotos.Count > 0)
                    {
                        <h3 class="zd-h3">Our team</h3>
                        <div class="zd-gallery-grid">
                            @foreach (var photo in teamPhotos)
                            {
                                <figure class="zd-gallery-card">
                                    <button type="button" class="zd-lightbox-trigger"
                                            data-zd-src="@photo.Url"
                                            data-zd-alt="@(photo.Caption ?? "Team photo")"
                                            aria-label="View photo larger">
                                        <img src="@photo.Url" alt="@(photo.Caption ?? "Team photo")" loading="lazy" />
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(photo.Caption))
                                    {
                                        <figcaption>@photo.Caption</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    }
                    @if (smilePhotos.Count > 0)
                    {
                        <h3 class="zd-h3">Smile gallery</h3>
                        <div class="zd-gallery-grid">
                            @foreach (var photo in smilePhotos)
                            {
                                <figure class="zd-gallery-card">
                                    <button type="button" class="zd-lightbox-trigger"
                                            data-zd-src="@photo.Url"
                                            data-zd-alt="@(photo.Caption ?? "Smile photo")"
                                            aria-label="View photo larger">
                                        <img src="@photo.Url" alt="@(photo.Caption ?? "Smile photo")" loading="lazy" />
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(photo.Caption))
                                    {
                                        <figcaption>@photo.Caption</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    }
                    @if (familyPhotos.Count > 0)
                    {
                        <h3 class="zd-h3">Family gallery</h3>
                        <div class="zd-gallery-grid">
                            @foreach (var photo in familyPhotos)
                            {
                                <figure class="zd-gallery-card">
                                    <button type="button" class="zd-lightbox-trigger"
                                            data-zd-src="@photo.Url"
                                            data-zd-alt="@(photo.Caption ?? "Family photo")"
                                            aria-label="View photo larger">
                                        <img src="@photo.Url" alt="@(photo.Caption ?? "Family photo")" loading="lazy" />
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(photo.Caption))
                                    {
                                        <figcaption>@photo.Caption</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    }
                    @if (petsPhotos.Count > 0)
                    {
                        <h3 class="zd-h3">Pets gallery</h3>
                        <div class="zd-gallery-grid">
                            @foreach (var photo in petsPhotos)
                            {
                                <figure class="zd-gallery-card">
                                    <button type="button" class="zd-lightbox-trigger"
                                            data-zd-src="@photo.Url"
                                            data-zd-alt="@(photo.Caption ?? "Pet photo")"
                                            aria-label="View photo larger">
                                        <img src="@photo.Url" alt="@(photo.Caption ?? "Pet photo")" loading="lazy" />
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(photo.Caption))
                                    {
                                        <figcaption>@photo.Caption</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    }
                </section>
            }

            <section class="zd-section" id="insurances">
                <h2 class="zd-h2">Is this doctor in your insurance network?</h2>
                <p class="zd-label-muted">Enter your insurance carrier and plan</p>
                <div class="zd-ins-field" id="zd-ins-field">
                    <span class="zd-ins-check" id="zd-ins-check" hidden>✓</span>
                    <select id="pp-insurance-carrier" class="zd-ins-select" aria-label="Insurance carrier">
                        <option value="">Select insurance carrier and plan</option>
                        <option value="none">I'm paying without insurance</option>
                        @foreach (var carrier in Model.InsuranceCatalog)
                        {
                            <option value="@carrier.Id">@carrier.Name</option>
                        }
                    </select>
                    <select id="pp-insurance-plan" class="zd-ins-select zd-ins-plan" aria-label="Insurance plan" disabled>
                        <option value="">Add plan</option>
                    </select>
                </div>
                <p class="zd-in-network" id="pp-network-status" hidden>This dentist is in-network</p>

                <h2 class="zd-h2 zd-h2-spaced">In-network insurances</h2>
                @if (doctor.AcceptedInsurances.Count > 0)
                {
                    <p class="zd-social-proof">99% of patients have successfully booked with these insurances</p>
                    <div class="zd-ins-grid">
                        @foreach (var ins in doctor.AcceptedInsurances.Take(6))
                        {
                            <div class="zd-ins-item">
                                <span class="zd-ins-logo" aria-hidden="true">@ins.CarrierName.Substring(0, 1)</span>
                                <span>@ins.CarrierName</span>
                            </div>
                        }
                    </div>
                    @if (doctor.AcceptedInsurances.Count > 6 || planCount > 6)
                    {
                        <p class="zd-more-plans">+@Math.Max(planCount - 6, doctor.AcceptedInsurances.Count - 6) more in-network plans <a href="#insurances">View All</a></p>
                    }
                }
                else
                {
                    <p class="zd-muted">Insurance details are not published yet. Please call the office to confirm coverage.</p>
                }
            </section>

            <section class="zd-section" id="reasons">
                <h2 class="zd-h2">Popular visit reasons</h2>
                <div class="zd-reasons" id="zd-reasons">
                    @for (var i = 0; i < popularReasons.Length; i++)
                    {
                        if (i >= 8)
                        {
                            <div class="zd-reason is-extra" hidden>
                                <span aria-hidden="true">✓</span> @popularReasons[i]
                            </div>
                        }
                        else
                        {
                            <div class="zd-reason">
                                <span aria-hidden="true">✓</span> @popularReasons[i]
                            </div>
                        }
                    }
                </div>
                <button type="button" class="zd-text-link" id="zd-reasons-more">See @(popularReasons.Length - 8)+ more popular visit reasons</button>
            </section>

            <section class="zd-section" id="location">
                <h2 class="zd-h2">Office location</h2>
                <div class="zd-location">
                    @if (!string.IsNullOrWhiteSpace(mapQuery))
                    {
                        var mapSrc = $"https://maps.google.com/maps?q={Uri.EscapeDataString(mapQuery)}&z=15&output=embed";
                        <div class="zd-map">
                            <iframe src="@mapSrc" title="Office map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    }
                    <div class="zd-location-copy">
                        @if (!string.IsNullOrWhiteSpace(doctor.PracticeName))
                        {
                            <strong>@doctor.PracticeName</strong>
                        }
                        @if (!string.IsNullOrWhiteSpace(doctor.Address))
                        {
                            <p>@doctor.Address</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(string.Join(", ", new[] { doctor.City, doctor.State, doctor.ZipCode }.Where(x => !string.IsNullOrWhiteSpace(x)))))
                        {
                            <p>@doctor.City, @doctor.State @doctor.ZipCode</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(mapQuery))
                        {
                            <a class="zd-text-link" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(mapQuery)" target="_blank" rel="noopener noreferrer">Get directions</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(doctor.OfficePhoneNumber))
                        {
                            <a class="zd-phone" href="tel:@RegexPhone(doctor.OfficePhoneNumber)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.68 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.74.32 1.53.55 2.34.68A2 2 0 0 1 22 16.92z"/>
                                </svg>
                                Call @doctor.OfficePhoneNumber
                            </a>
                        }
                    </div>
                </div>
            </section>

            <section class="zd-section" id="education">
                <h2 class="zd-h2">Education and background</h2>
                @if (!string.IsNullOrWhiteSpace(doctor.PracticeName))
                {
                    <h3 class="zd-h3">Practice names</h3>
                    <p><a class="zd-text-link" href="#location">@doctor.PracticeName</a></p>
                }
                @if (doctor.YearsOfPractice is > 0 || doctor.GraduationYear is > 0)
                {
                    <h3 class="zd-h3">Experience</h3>
                    <ul class="zd-list">
                        @if (doctor.YearsOfPractice is > 0) { <li>@doctor.YearsOfPractice+ years of practice</li> }
                        @if (doctor.GraduationYear is > 0) { <li>Graduated @doctor.GraduationYear</li> }
                    </ul>
                }
                @if (doctor.Languages.Count > 0)
                {
                    <h3 class="zd-h3">Languages spoken</h3>
                    <p>@string.Join(", ", doctor.Languages)</p>
                }
            </section>

            <section class="zd-section" id="reviews">
                <h2 class="zd-h2">Patient reviews</h2>
                @if (avgRating > 0)
                {
                    <div class="zd-reviews-score">
                        <strong>@avgRating.ToString("0.00")</strong>
                        <span class="zd-stars">@RenderStars(avgRating)</span>
                        <span class="zd-muted">@totalReviews @(doctor.GoogleReviewCount > 0 ? "Google" : "patient") ratings</span>
                    </div>
                }
                <p class="zd-muted zd-trust">Providers can’t pay to alter or remove reviews.</p>

                @if (googleReviews.Count > 0)
                {
                    <div class="zd-google-review-block">
                        <div class="zd-review-source">Google reviews (@googleReviews.Count saved)</div>
                        @foreach (var gReview in googleReviews)
                        {
                            <article class="zd-review zd-review-google">
                                <div class="zd-review-top">
                                    <div class="zd-review-avatar">@(string.IsNullOrWhiteSpace(gReview.ReviewerName) ? "G" : char.ToUpperInvariant(gReview.ReviewerName.Trim()[0]))</div>
                                    <div>
                                        <strong>@gReview.ReviewerName</strong>
                                        <div class="zd-stars">@RenderStars(gReview.Rating)</div>
                                    </div>
                                </div>
                                <p>“@gReview.ReviewText”</p>
                                @if (!string.IsNullOrWhiteSpace(gReview.Recommendation)
                                     && !string.Equals(gReview.Recommendation, "Google review", StringComparison.OrdinalIgnoreCase))
                                {
                                    <p class="zd-muted zd-google-meta">@gReview.Recommendation</p>
                                }
                            </article>
                        }
                    </div>
                }

                @if (doctor.Reviews.Count == 0)
                {
                    @if (googleReviews.Count == 0)
                    {
                        <p class="zd-muted">No patient reviews yet.</p>
                    }
                }
                else
                {
                    @if (googleReviews.Count > 0)
                    {
                        <div class="zd-review-source">Reviews on @Branding.SiteName</div>
                    }
                    @foreach (var review in doctor.Reviews)
                    {
                        <article class="zd-review">
                            <div class="zd-review-top">
                                <div class="zd-review-avatar">@(string.IsNullOrWhiteSpace(review.ReviewerName) ? "?" : char.ToUpperInvariant(review.ReviewerName.Trim()[0]))</div>
                                <div>
                                    <strong>@review.ReviewerName</strong>
                                    <div class="zd-stars">@RenderStars(review.Rating)</div>
                                </div>
                            </div>
                            <p>“@review.ReviewText”</p>
                            @if (!string.IsNullOrWhiteSpace(review.PhotoUrl))
                            {
                                <button type="button" class="zd-review-photo zd-lightbox-trigger"
                                        data-zd-src="@review.PhotoUrl"
                                        data-zd-alt="Photo from @review.ReviewerName"
                                        aria-label="View review photo larger">
                                    <img src="@review.PhotoUrl" alt="Photo from @review.ReviewerName" loading="lazy" />
                                </button>
                            }
                        </article>
                    }
                }
            </section>

            <section class="zd-section" id="faqs">
                <h2 class="zd-h2">FAQs</h2>
                <details class="zd-faq"><summary>Is @doctor.Name accepting new patients?</summary><p>Yes — new patient appointments are available. Call the office to schedule.</p></details>
                <details class="zd-faq"><summary>What insurances does this office accept?</summary><p>See the Insurances section above, or call the office to confirm your plan is in-network.</p></details>
                <details class="zd-faq"><summary>How do I book an appointment?</summary><p>Online booking is coming soon. For now, call the office directly using the number on this page to schedule for free.</p></details>
            </section>
        </div>

        <aside class="zd-sidebar">
            <div class="zd-book zd-book-readonly" id="pp-booking">
                <h2 class="zd-book-title">Book an appointment for free</h2>
                <p class="zd-book-sub">The office partners with @Branding.SiteName to schedule appointments</p>

                @if (!string.IsNullOrWhiteSpace(doctor.OfficePhoneNumber))
                {
                    <a class="zd-call-btn"
                       href="tel:@RegexPhone(doctor.OfficePhoneNumber)"
                       aria-label="Call @doctor.Name at @doctor.OfficePhoneNumber">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.68 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.74.32 1.53.55 2.34.68A2 2 0 0 1 22 16.92z"/>
                        </svg>
                        Call @doctor.OfficePhoneNumber
                    </a>
                    <p class="zd-book-call-hint">Online booking is coming soon. Call the office to schedule for free.</p>
                }
                else
                {
                    <p class="zd-book-call-hint">Online booking is coming soon. Phone number is not listed yet — check back shortly.</p>
                }

                <div class="zd-book-readonly-panel" aria-hidden="true">
                    <h3 class="zd-book-section">Scheduling details</h3>
                    <div class="zd-select zd-select-readonly">Select reason for visit</div>
                    <div class="zd-select zd-select-readonly">Select insurance</div>
                    <div class="zd-patient-type zd-patient-type-readonly">
                        <span class="zd-ptype is-active"><span class="zd-ptype-check" aria-hidden="true">✓</span> New patient</span>
                        <span class="zd-ptype"><span class="zd-ptype-check" aria-hidden="true">✓</span> Existing patient</span>
                    </div>
                    <p class="zd-book-readonly-note">Availability will appear here once online booking is enabled.</p>
                </div>
            </div>
        </aside>
    </div>
</div>

<dialog class="zd-book-dialog" id="zd-book-dialog" aria-labelledby="zd-book-dialog-title">
    <div class="zd-book-dialog-panel">
        <header class="zd-book-dialog-head">
            <h2 id="zd-book-dialog-title">Book an appointment</h2>
            <button type="button" class="zd-book-dialog-close" id="zd-book-dialog-close" aria-label="Close">×</button>
        </header>

        <div class="zd-book-dialog-body">
            <div class="zd-book-dialog-doctor">
                @if (!string.IsNullOrWhiteSpace(doctor.PhotoUrl))
                {
                    <img src="@doctor.PhotoUrl" alt="" class="zd-book-dialog-photo" />
                }
                else
                {
                    <div class="zd-book-dialog-photo zd-photo-fallback">@doctor.AvatarInitials</div>
                }
                <div class="zd-book-dialog-meta">
                    <div class="zd-book-dialog-name">@doctor.Name <span class="zd-book-dialog-spec">(@doctor.Specialty)</span></div>
                    @if (avgRating > 0)
                    {
                        <div class="zd-book-dialog-rating"><span class="zd-stars">★</span> @avgRating.ToString("0.00") · @totalReviews reviews</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(streetCity))
                    {
                        <div class="zd-book-dialog-loc">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 22s7-7.2 7-12a7 7 0 1 0-14 0c0 4.8 7 12 7 12z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8"/></svg>
                            @streetCity
                        </div>
                    }
                    <div class="zd-book-dialog-network" id="zd-dialog-network" hidden>
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5 13 3.5v4.2c0 3.4-2.1 5.8-5 6.8-2.9-1-5-3.4-5-6.8V3.5L8 1.5z" fill="#1f7a4c"/><path d="m5.2 8 1.9 1.9 3.7-3.8" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span id="zd-dialog-network-text">In-network</span>
                    </div>
                </div>
            </div>

            <section class="zd-book-dialog-section">
                <h3>Scheduling details</h3>
                <p class="zd-book-dialog-hint">Your selections will help show the right availability</p>

                <div class="zd-dialog-field">
                    <span class="zd-dialog-field-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 4v6a6 6 0 0 0 12 0V4M9 20h6M12 16v4" stroke="#555" stroke-width="1.7" stroke-linecap="round"/></svg>
                    </span>
                    <select id="pp-visit-reason-dialog" class="zd-dialog-select" aria-label="Reason for visit">
                        <partial name="Shared/_VisitReasonOptions" />
                    </select>
                </div>

                <button type="button" class="zd-dialog-ins" id="zd-dialog-ins-btn">
                    <span class="zd-dialog-ins-check" id="zd-dialog-ins-check" hidden aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5 13 3.5v4.2c0 3.4-2.1 5.8-5 6.8-2.9-1-5-3.4-5-6.8V3.5L8 1.5z" fill="#1f7a4c"/><path d="m5.2 8 1.9 1.9 3.7-3.8" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span id="zd-dialog-ins-text">Select insurance</span>
                </button>
            </section>

            <section class="zd-book-dialog-section" id="zd-dialog-appts-section">
                <h3>Available appointments</h3>
                <p class="zd-book-dialog-hint">Click a time to book for free.</p>
                <div id="zd-dialog-appts" class="zd-dialog-appts"></div>
                <button type="button" class="zd-dialog-more" id="zd-dialog-more">Show more availability</button>
            </section>

            <section class="zd-book-dialog-section zd-patient-form" id="pp-patient-details" hidden>
                <h3>Your details</h3>
                <label class="zd-field-label" for="pp-patient-name">Your name</label>
                <input id="pp-patient-name" class="zd-select" type="text" value="@Model.PrefillName" autocomplete="name" />
                <label class="zd-field-label" for="pp-patient-phone">Phone</label>
                <input id="pp-patient-phone" class="zd-select" type="tel" value="@Model.PrefillPhone" autocomplete="tel" />
                <label class="zd-field-label" for="pp-patient-email">Email <span class="zd-optional">(optional)</span></label>
                <input id="pp-patient-email" class="zd-select" type="email" value="@Model.PrefillEmail" autocomplete="email" />
                <label class="zd-field-label" for="pp-patient-dob">Date of birth</label>
                <input id="pp-patient-dob" class="zd-select" type="date" value="@Model.PrefillDateOfBirth" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <button type="button" class="zd-book-btn" id="pp-book-btn" onclick="ppConfirmBooking()">Request appointment</button>
                <p class="zd-book-note" id="pp-booking-note" hidden></p>
            </section>
        </div>
    </div>
</dialog>

<div class="zd-sticky-bar" id="zd-sticky-bar" hidden>
    <div class="zd-sticky-inner">
        @if (!string.IsNullOrWhiteSpace(doctor.PhotoUrl))
        {
            <img src="@doctor.PhotoUrl" alt="" class="zd-sticky-photo" />
        }
        else
        {
            <div class="zd-sticky-photo zd-photo-fallback">@doctor.AvatarInitials</div>
        }
        <div class="zd-sticky-meta">
            <strong>@doctor.Name</strong>
            @if (avgRating > 0)
            {
                <span><span class="zd-stars">★</span> @avgRating.ToString("0.00") (@totalReviews patient ratings)</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(doctor.OfficePhoneNumber))
        {
            <a class="zd-sticky-cta" href="tel:@RegexPhone(doctor.OfficePhoneNumber)">Call @doctor.OfficePhoneNumber</a>
        }
        else
        {
            <a class="zd-sticky-cta" href="#pp-booking">View booking</a>
        }
    </div>
</div>

<script>
(function () {
  const doctorId = @doctor.Id;
  const acceptedCarrierIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(doctor.AcceptedInsuranceCarrierIds));
  const insuranceCatalog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.InsuranceCatalog,
    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
  const allDays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.BookingDays.Select(d => new {
        d.DateIso,
        d.DayLabel,
        d.DateLabel,
        d.AvailableCount,
        dateText = d.Date.ToString("ddd, MMM d"),
        slots = d.Slots.Where(s => s.Available).Select(s => s.TimeLabel).ToList()
    }),
    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

  let selectedSlot = null;
  let submitting = false;
  let isNewPatient = @(isNewPatient ? "true" : "false");
  let dayPage = 0;
  let dialogDayStart = 0;
  let dialogGroupLimit = 3;
  const pageSize = 14;
  const dialogPageSize = 3;

  const carrierSelect = document.getElementById("pp-insurance-carrier");
  const planSelect = document.getElementById("pp-insurance-plan");
  const carrierSelectBook = document.getElementById("pp-insurance-carrier-book");
  const planSelectBook = document.getElementById("pp-insurance-plan-book");
  const networkStatus = document.getElementById("pp-network-status");
  const bookInsStatus = document.getElementById("zd-book-ins-status");
  const pillText = document.getElementById("zd-ins-pill-text");
  const pillCheck = document.getElementById("zd-ins-pill-check");
  const insCheck = document.getElementById("zd-ins-check");
  const insPill = document.getElementById("zd-ins-pill");
  const insPicker = document.getElementById("zd-book-ins-picker");
  const bookDialog = document.getElementById("zd-book-dialog");
  const reasonSelect = document.getElementById("pp-visit-reason");
  const reasonSelectDialog = document.getElementById("pp-visit-reason-dialog");
  const dialogInsText = document.getElementById("zd-dialog-ins-text");
  const dialogInsCheck = document.getElementById("zd-dialog-ins-check");
  const dialogNetwork = document.getElementById("zd-dialog-network");
  const dialogNetworkText = document.getElementById("zd-dialog-network-text");
  const dialogAppts = document.getElementById("zd-dialog-appts");
  const dialogMore = document.getElementById("zd-dialog-more");

  function fillPlans(select, carrierId, selectedPlan) {
    if (!select) return;
    const carrier = insuranceCatalog.find(c => String(c.id) === String(carrierId));
    select.innerHTML = '<option value=\"\">Add plan</option>';
    select.disabled = true;
    if (!carrierId || carrierId === "none" || !carrier) return;
    const plans = carrier.plans || [];
    plans.forEach(p => {
      const opt = document.createElement("option");
      opt.value = p.name;
      opt.textContent = p.name;
      if (selectedPlan && selectedPlan === p.name) opt.selected = true;
      select.appendChild(opt);
    });
    select.disabled = plans.length === 0;
  }

  function setCarrierValue(value, source) {
    [carrierSelect, carrierSelectBook].forEach(el => {
      if (el && el !== source) el.value = value;
    });
  }

  function setPlanValue(value, source) {
    [planSelect, planSelectBook].forEach(el => {
      if (el && el !== source) el.value = value;
    });
  }

  function syncInsuranceUi(source) {
    const activeCarrier = (source && (source === carrierSelect || source === carrierSelectBook))
      ? source.value
      : (carrierSelectBook?.value || carrierSelect?.value || "");
    setCarrierValue(activeCarrier, source);

    const selectedPlan = (source && (source === planSelect || source === planSelectBook))
      ? source.value
      : (planSelectBook?.value || planSelect?.value || "");

    fillPlans(planSelect, activeCarrier, selectedPlan);
    fillPlans(planSelectBook, activeCarrier, selectedPlan);
    if (selectedPlan) {
      if (planSelect) planSelect.value = selectedPlan;
      if (planSelectBook) planSelectBook.value = selectedPlan;
    }

    if (!activeCarrier || activeCarrier === "none") {
      if (pillCheck) pillCheck.hidden = true;
      if (insCheck) insCheck.hidden = true;
      if (dialogInsCheck) dialogInsCheck.hidden = true;
      const label = activeCarrier === "none" ? "Paying without insurance" : "Select insurance";
      if (pillText) pillText.innerHTML = label;
      if (dialogInsText) dialogInsText.textContent = label;
      if (networkStatus) networkStatus.hidden = true;
      if (bookInsStatus) bookInsStatus.hidden = true;
      if (dialogNetwork) dialogNetwork.hidden = true;
      return;
    }

    const carrier = insuranceCatalog.find(c => String(c.id) === String(activeCarrier));
    const planVal = planSelectBook?.value || planSelect?.value || "";
    const name = carrier ? carrier.name : "Insurance";
    const display = planVal ? (name + " — " + planVal) : (name + " — Add plan");
    if (planVal) {
      if (pillText) pillText.textContent = display;
      if (dialogInsText) dialogInsText.textContent = display;
    } else {
      if (pillText) pillText.innerHTML = name + " — <span class=\"zd-book-ins-add\">Add plan</span>";
      if (dialogInsText) dialogInsText.innerHTML = name + " — <span class=\"zd-book-ins-add\">Add plan</span>";
    }

    const accepted = acceptedCarrierIds.map(String).includes(String(activeCarrier));
    if (pillCheck) pillCheck.hidden = !accepted;
    if (insCheck) insCheck.hidden = !accepted;
    if (dialogInsCheck) dialogInsCheck.hidden = !accepted;
    if (networkStatus) networkStatus.hidden = !accepted;
    if (bookInsStatus) bookInsStatus.hidden = !accepted;
    if (dialogNetwork) dialogNetwork.hidden = !accepted;
    if (accepted) {
      if (networkStatus) networkStatus.textContent = "This dentist is in-network";
      if (bookInsStatus) bookInsStatus.textContent = "This dentist is in-network";
      if (dialogNetworkText) dialogNetworkText.textContent = "In-network · " + name;
    }
  }

  carrierSelect?.addEventListener("change", () => {
    setCarrierValue(carrierSelect.value, carrierSelect);
    if (planSelect) planSelect.value = "";
    if (planSelectBook) planSelectBook.value = "";
    syncInsuranceUi(carrierSelect);
  });
  planSelect?.addEventListener("change", () => {
    setPlanValue(planSelect.value, planSelect);
    syncInsuranceUi(planSelect);
  });
  carrierSelectBook?.addEventListener("change", () => {
    setCarrierValue(carrierSelectBook.value, carrierSelectBook);
    if (planSelect) planSelect.value = "";
    if (planSelectBook) planSelectBook.value = "";
    syncInsuranceUi(carrierSelectBook);
  });
  planSelectBook?.addEventListener("change", () => {
    setPlanValue(planSelectBook.value, planSelectBook);
    syncInsuranceUi(planSelectBook);
  });

  insPill?.addEventListener("click", () => {
    if (!insPicker) return;
    const open = insPicker.hidden;
    insPicker.hidden = !open;
    insPill.setAttribute("aria-expanded", open ? "true" : "false");
  });

  document.getElementById("zd-dialog-ins-btn")?.addEventListener("click", () => {
    bookDialog?.close();
    if (insPicker) insPicker.hidden = false;
    carrierSelectBook?.focus();
    document.getElementById("pp-booking")?.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  function syncReason(from, to) {
    if (from && to) to.value = from.value;
  }
  reasonSelect?.addEventListener("change", () => syncReason(reasonSelect, reasonSelectDialog));
  reasonSelectDialog?.addEventListener("change", () => syncReason(reasonSelectDialog, reasonSelect));

  document.querySelectorAll(".zd-ptype").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".zd-ptype").forEach(b => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      isNewPatient = btn.dataset.new === "true";
      const url = new URL(location.href);
      url.searchParams.set("isNewPatient", isNewPatient ? "true" : "false");
      history.replaceState({}, "", url);
    });
  });

  document.querySelectorAll(".zd-tab").forEach(tab => {
    tab.addEventListener("click", () => {
      document.querySelectorAll(".zd-tab").forEach(t => t.classList.remove("is-active"));
      tab.classList.add("is-active");
    });
  });

  function updateRangeLabel() {
    const start = dayPage * pageSize;
    const end = Math.min(start + pageSize - 1, allDays.length - 1);
    const label = document.getElementById("zd-range-label");
    if (label && allDays[start] && allDays[end]) {
      label.textContent = allDays[start].dateText + " – " + allDays[end].dateText;
    }
    document.querySelectorAll(".zd-day").forEach((el, idx) => {
      el.hidden = !(idx >= start && idx <= end);
    });
    const maxPage = Math.max(0, Math.ceil(allDays.length / pageSize) - 1);
    const prev = document.getElementById("zd-range-prev");
    const next = document.getElementById("zd-range-next");
    if (prev) prev.disabled = dayPage <= 0;
    if (next) next.disabled = dayPage >= maxPage;
  }

  document.getElementById("zd-range-prev")?.addEventListener("click", () => {
    dayPage = Math.max(0, dayPage - 1);
    updateRangeLabel();
  });
  document.getElementById("zd-range-next")?.addEventListener("click", () => {
    const maxPage = Math.max(0, Math.ceil(allDays.length / pageSize) - 1);
    dayPage = Math.min(maxPage, dayPage + 1);
    updateRangeLabel();
  });
  document.getElementById("zd-more-avail")?.addEventListener("click", () => {
    const active = document.querySelector(".zd-day.is-active");
    const activeIndex = active ? Number(active.dataset.dayIndex) : (dayPage * pageSize);
    openBookDialog(Number.isFinite(activeIndex) ? activeIndex : 0);
  });

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function buildAvailabilityGroups(fromIndex) {
    const end = allDays.length;
    const groups = [];
    let i = fromIndex;
    while (i < end) {
      const day = allDays[i];
      const slots = day.slots || [];
      if (slots.length > 0) {
        groups.push({ type: "day", index: i, day, slots });
        i += 1;
        continue;
      }
      let j = i;
      while (j < end && (!(allDays[j].slots || []).length)) j += 1;
      groups.push({
        type: "empty",
        start: allDays[i],
        end: allDays[j - 1],
        startIndex: i,
        endIndex: j - 1
      });
      i = j;
    }
    return groups;
  }

  function renderDayGroupHtml(g) {
    if (g.type === "day") {
      const buttons = g.slots.map(t =>
        `<button type="button" class="zd-dialog-slot" data-date="${escapeHtml(g.day.dateIso)}" data-day="${escapeHtml(g.day.dateText)}" data-time="${escapeHtml(t)}">${escapeHtml(t)}</button>`
      ).join("");
      return `<div class="zd-dialog-day-group"><div class="zd-dialog-day-label">${escapeHtml(g.day.dateText)}</div><div class="zd-dialog-slot-row">${buttons}</div></div>`;
    }
    const label = g.startIndex === g.endIndex
      ? g.start.dateText
      : (g.start.dateText + " – " + g.end.dateText);
    return `<div class="zd-dialog-day-group is-empty"><div class="zd-dialog-day-label">${escapeHtml(label)}</div><p class="zd-dialog-empty">No available appointments</p></div>`;
  }

  function renderDialogAppts() {
    if (!dialogAppts) return;
    const allGroups = buildAvailabilityGroups(dialogDayStart);
    const visible = allGroups.slice(0, dialogGroupLimit);
    const initial = visible.slice(0, dialogPageSize);
    const extra = visible.slice(dialogPageSize);

    let html = initial.map(renderDayGroupHtml).join("");
    if (extra.length > 0) {
      html += `<div class="zd-dialog-more-label">More availability</div>` + extra.map(renderDayGroupHtml).join("");
    }
    dialogAppts.innerHTML = html;

    dialogAppts.querySelectorAll(".zd-dialog-slot").forEach(btn => {
      btn.addEventListener("click", () => ppSelectSlot(btn));
    });

    if (dialogMore) {
      dialogMore.hidden = dialogGroupLimit >= allGroups.length;
    }
  }

  function openBookDialog(focusIndex) {
    dialogDayStart = Math.max(0, focusIndex || 0);
    dialogGroupLimit = dialogPageSize;
    selectedSlot = null;
    const form = document.getElementById("pp-patient-details");
    if (form) form.hidden = true;
    const note = document.getElementById("pp-booking-note");
    if (note) note.hidden = true;
    const bookBtn = document.getElementById("pp-book-btn");
    if (bookBtn) {
      bookBtn.disabled = false;
      bookBtn.textContent = "Request appointment";
      submitting = false;
    }
    syncReason(reasonSelect, reasonSelectDialog);
    syncInsuranceUi();
    renderDialogAppts();
    if (bookDialog && typeof bookDialog.showModal === "function") {
      bookDialog.showModal();
    } else if (bookDialog) {
      bookDialog.setAttribute("open", "");
    }
  }

  function closeBookDialog() {
    if (bookDialog && typeof bookDialog.close === "function") bookDialog.close();
    else bookDialog?.removeAttribute("open");
  }

  document.getElementById("zd-book-dialog-close")?.addEventListener("click", closeBookDialog);
  bookDialog?.addEventListener("click", (e) => {
    if (e.target === bookDialog) closeBookDialog();
  });
  dialogMore?.addEventListener("click", () => {
    dialogGroupLimit += dialogPageSize;
    renderDialogAppts();
  });

  updateRangeLabel();
  syncInsuranceUi();
  syncReason(reasonSelect, reasonSelectDialog);

  window.ppSelectDay = function (index) {
    document.querySelectorAll(".zd-day").forEach(tab => {
      tab.classList.toggle("is-active", Number(tab.dataset.dayIndex) === index);
    });
    openBookDialog(index);
  };

  window.ppSelectSlot = function (btn) {
    document.querySelectorAll(".zd-dialog-slot").forEach(el => el.classList.remove("is-selected"));
    btn.classList.add("is-selected");
    selectedSlot = { date: btn.dataset.date, day: btn.dataset.day, time: btn.dataset.time };
    const form = document.getElementById("pp-patient-details");
    form.hidden = false;
    form.scrollIntoView({ behavior: "smooth", block: "nearest" });
  };

  document.getElementById("zd-reasons-more")?.addEventListener("click", function () {
    document.querySelectorAll(".zd-reason.is-extra").forEach(el => { el.hidden = false; });
    this.hidden = true;
  });

  document.getElementById("zd-save-btn")?.addEventListener("click", function () {
    this.classList.toggle("is-saved");
    this.lastChild.textContent = this.classList.contains("is-saved") ? " Saved" : " Save";
  });

  const sticky = document.getElementById("zd-sticky-bar");
  const bookCard = document.getElementById("pp-booking");
  window.addEventListener("scroll", () => {
    if (!sticky || !bookCard) return;
    const rect = bookCard.getBoundingClientRect();
    sticky.hidden = rect.bottom > 120;
  }, { passive: true });

  window.ppConfirmBooking = async function () {
    if (!selectedSlot || submitting) return;
    const name = (document.getElementById("pp-patient-name").value || "").trim();
    const phone = (document.getElementById("pp-patient-phone").value || "").trim();
    const email = (document.getElementById("pp-patient-email").value || "").trim();
    const dateOfBirth = (document.getElementById("pp-patient-dob").value || "").trim();
    const reason = reasonSelectDialog?.value || reasonSelect?.value || "";
    const note = document.getElementById("pp-booking-note");
    const bookBtn = document.getElementById("pp-book-btn");

    if (!reason) { note.hidden = false; note.className = "zd-book-note is-error"; note.textContent = "Please select a reason for visit."; return; }
    if (name.length < 2) { note.hidden = false; note.className = "zd-book-note is-error"; note.textContent = "Please enter your name."; return; }
    if (!dateOfBirth) { note.hidden = false; note.className = "zd-book-note is-error"; note.textContent = "Please enter your date of birth."; return; }

    submitting = true;
    bookBtn.disabled = true;
    bookBtn.textContent = "Sending…";
    note.hidden = true;
    try {
      const res = await fetch("/api/bookings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          doctorId,
          patientName: name,
          patientPhone: phone || null,
          patientEmail: email || null,
          dateOfBirth,
          visitReason: reason,
          date: selectedSlot.date,
          timeLabel: selectedSlot.time,
          source: "PublicProfile",
          isNewPatient,
          insuranceCarrierId: (() => {
            const v = carrierSelectBook?.value || carrierSelect?.value || "";
            return (v && v !== "none") ? Number(v) : null;
          })(),
          insurancePlan: ((planSelectBook?.value || planSelect?.value || "").trim()) || null
        })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.message || "Could not send booking request.");
      note.hidden = false;
      note.className = "zd-book-note";
      note.textContent = data.message || ("Thanks! Request sent for " + selectedSlot.day + " at " + selectedSlot.time + ".");
      bookBtn.textContent = "Request sent";
      selectedSlot = null;
    } catch (err) {
      note.hidden = false;
      note.className = "zd-book-note is-error";
      note.textContent = err.message || "Something went wrong.";
      bookBtn.disabled = false;
      bookBtn.textContent = "Try again";
      submitting = false;
    }
  };
})();
</script>
<div class="zd-lightbox" id="zd-lightbox" hidden>
    <button type="button" class="zd-lightbox-backdrop" id="zd-lightbox-backdrop" aria-label="Close photo"></button>
    <div class="zd-lightbox-panel" role="dialog" aria-modal="true" aria-label="Expanded photo">
        <button type="button" class="zd-lightbox-close" id="zd-lightbox-close" aria-label="Close">×</button>
        <img class="zd-lightbox-img" id="zd-lightbox-img" alt="" />
        <p class="zd-lightbox-caption" id="zd-lightbox-caption" hidden></p>
    </div>
</div>
<script>
(function () {
  document.querySelectorAll("[data-zd-gallery-strip]").forEach((wrap) => {
    const strip = wrap.querySelector(".zd-gallery-strip");
    const prev = wrap.querySelector(".zd-gallery-seek-prev");
    const next = wrap.querySelector(".zd-gallery-seek-next");
    if (!strip || !prev || !next) return;

    function stepSize() {
      const item = strip.querySelector(".zd-gallery-item");
      if (!item) return Math.max(200, Math.floor(strip.clientWidth * 0.8));
      const styles = getComputedStyle(strip);
      const gap = parseFloat(styles.columnGap || styles.gap || "0") || 0;
      return item.getBoundingClientRect().width + gap;
    }

    function updateSeekers() {
      const maxScroll = Math.max(0, strip.scrollWidth - strip.clientWidth - 1);
      const overflow = maxScroll > 0;
      prev.hidden = !overflow;
      next.hidden = !overflow;
      if (!overflow) return;
      prev.disabled = strip.scrollLeft <= 1;
      next.disabled = strip.scrollLeft >= maxScroll;
    }

    prev.addEventListener("click", () => {
      strip.scrollBy({ left: -stepSize(), behavior: "smooth" });
    });
    next.addEventListener("click", () => {
      strip.scrollBy({ left: stepSize(), behavior: "smooth" });
    });
    strip.addEventListener("scroll", updateSeekers, { passive: true });
    window.addEventListener("resize", updateSeekers);
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(updateSeekers).observe(strip);
    }
    updateSeekers();
  });
})();
</script>
<script>
(function () {
  const root = document.getElementById("zd-lightbox");
  const img = document.getElementById("zd-lightbox-img");
  const caption = document.getElementById("zd-lightbox-caption");
  const closeBtn = document.getElementById("zd-lightbox-close");
  const backdrop = document.getElementById("zd-lightbox-backdrop");
  if (!root || !img) return;

  function openLightbox(src, alt) {
    if (!src) return;
    img.src = src;
    img.alt = alt || "";
    if (caption) {
      const text = (alt || "").trim();
      caption.textContent = text;
      caption.hidden = !text;
    }
    root.hidden = false;
    document.body.classList.add("zd-lightbox-open");
    closeBtn?.focus();
  }

  function closeLightbox() {
    root.hidden = true;
    document.body.classList.remove("zd-lightbox-open");
    img.removeAttribute("src");
  }

  document.addEventListener("click", (e) => {
    const trigger = e.target.closest(".zd-lightbox-trigger");
    if (!trigger) return;
    e.preventDefault();
    openLightbox(trigger.getAttribute("data-zd-src"), trigger.getAttribute("data-zd-alt"));
  });

  closeBtn?.addEventListener("click", closeLightbox);
  backdrop?.addEventListener("click", closeLightbox);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !root.hidden) closeLightbox();
  });
})();
</script>
