@page
@model Docovee.Pages.Account.AppointmentsModel
@{
    Layout = null;
    ViewData["Title"] = $"Appointment history — {Branding.SiteName}";
    ViewData["PatientDisplayName"] = Model.Profile?.FullName;
    ViewData["PatientNotifyCount"] = Model.UnreadNotificationCount;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <partial name="Shared/_Favicon" />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
</head>
<body class="pat-body">
<nav class="pac-topbar">
    <div class="nav-left">
        <partial name="Shared/_SiteLogo" />
    </div>
    <div class="nav-right">
        <partial name="Shared/_PatientAccountMenu" />
    </div>
</nav>

<main class="pat-main pat-main-solo">
    @if (Model.ReviewSubmitted)
    {
        <div class="alert-success">Thank you — your review has been submitted.</div>
    }
    @if (!string.IsNullOrEmpty(Model.ReviewError))
    {
        <div class="alert-error">@Model.ReviewError</div>
    }

    <div class="pat-panel-head">
        <h1>Appointment history</h1>
        <p>Past visits — leave a review after your doctor confirms the appointment and @Model.ReviewEligibleDaysAfterConfirmed day@(Model.ReviewEligibleDaysAfterConfirmed == 1 ? "" : "s") have passed.</p>
    </div>

    @if (Model.PastAppointments.Count == 0)
    {
        <div class="pi-list">
            <div class="pi-row">
                <div class="pi-row-body">
                    <div class="pi-value">No past appointments yet.</div>
                    <p class="pi-hint"><a class="pi-link" href="/?chat=1">Find a doctor</a> with @Branding.ChatBotName.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="pi-list">
            @foreach (var a in Model.PastAppointments)
            {
                <div class="pi-row pi-row-stack">
                    <div class="pi-row-top">
                        <div class="pi-row-body">
                            <div class="pi-label">@a.StartsAt.ToString("MMM d, yyyy") · @a.StartsAt.ToString("h:mm tt")</div>
                            <div class="pi-value">@a.DoctorName</div>
                            <p class="pi-hint">@a.DoctorSpecialty@(!string.IsNullOrEmpty(a.DoctorLocation) ? $" · {a.DoctorLocation}" : "")</p>
                            <p class="pi-hint">@a.VisitReason · @AppointmentsModel.StatusLabel(a.Status)</p>
                        </div>
                        <a class="pi-action" href="/doctors/@a.DoctorId">Profile</a>
                    </div>

                    @if (!Docovee.DS.Entities.AppointmentStatuses.IsCanceled(a.Status))
                    {
                        if (a.HasReview)
                        {
                            <div class="patient-review-submitted">
                                <div class="patient-review-stars">@string.Concat(Enumerable.Repeat("★", a.ReviewRating ?? 0))@string.Concat(Enumerable.Repeat("☆", 5 - (a.ReviewRating ?? 0)))</div>
                                <p>@a.ReviewText</p>
                                <div class="patient-review-meta-row">
                                    @if (!string.IsNullOrWhiteSpace(a.ReviewWaitingTime))
                                    {
                                        <span><strong>Waiting time:</strong> @a.ReviewWaitingTime</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.ReviewRecommendation))
                                    {
                                        <span><strong>Recommendation:</strong> @a.ReviewRecommendation</span>
                                    }
                                </div>
                                <div class="profile-list-meta">Submitted @a.ReviewedAt?.ToString("MMM d, yyyy")</div>
                            </div>
                        }
                        else if (a.CanLeaveReview)
                        {
                            <form method="post" asp-page-handler="SubmitReview" class="patient-review-form" enctype="multipart/form-data">
                                <input type="hidden" name="doctorId" value="@a.DoctorId" />
                                <label class="review-label">Review @a.DoctorName</label>
                                <div class="review-rating-row">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        <label class="review-star-label">
                                            <input type="radio" name="rating" value="@star" required @(star == 5 ? "checked" : null) />
                                            <span>@star</span>
                                        </label>
                                    }
                                </div>

                                <label class="review-label">Waiting time</label>
                                <div class="review-choice-row">
                                    @foreach (var option in new[] { "Excellent", "Good", "Average", "Bad" })
                                    {
                                        <label class="review-choice-label">
                                            <input type="radio" name="waitingTime" value="@option" required @(option == "Good" ? "checked" : null) />
                                            <span>@option</span>
                                        </label>
                                    }
                                </div>

                                <label class="review-label">How would you recommend this doctor?</label>
                                <div class="review-choice-row">
                                    @foreach (var option in new[] { "Highly Recommended", "Neutral", "Not Recommended" })
                                    {
                                        <label class="review-choice-label">
                                            <input type="radio" name="recommendation" value="@option" required @(option == "Highly Recommended" ? "checked" : null) />
                                            <span>@option</span>
                                        </label>
                                    }
                                </div>

                                <label class="review-label" for="review-@a.Id">Your review</label>
                                <textarea id="review-@a.Id" name="reviewText" class="review-textarea" rows="3" required placeholder="Share your experience with this doctor..."></textarea>
                                <label class="review-label" for="review-photo-@a.Id">Photo <span class="hint">(optional)</span></label>
                                <input id="review-photo-@a.Id" type="file" name="ReviewPhoto" accept="image/*" class="review-photo-input" />
                                <button type="submit" class="btn-primary btn-sm">Submit review</button>
                            </form>
                        }
                        else if (Docovee.DS.Entities.AppointmentStatuses.IsConfirmedWithDoctor(a.Status)
                                 && a.ReviewAvailableOn is DateOnly availableOn
                                 && availableOn > DateOnly.FromDateTime(DateTime.Today))
                        {
                            <p class="pi-hint" style="margin:0;">
                                Review available on @availableOn.ToString("MMM d, yyyy") (@Model.ReviewEligibleDaysAfterConfirmed day@(Model.ReviewEligibleDaysAfterConfirmed == 1 ? "" : "s") after your confirmed visit).
                            </p>
                        }
                    }
                </div>
            }
        </div>
    }

    @if (Model.Profile!.ViewedDoctors.Any(d => !d.HasReview && Model.PastAppointments.All(a => a.DoctorId != d.DoctorId)))
    {
        <div class="pat-panel-head" style="margin-top:32px;">
            <h1 style="font-size:22px;">Doctors you’ve contacted</h1>
            <p>Doctors from @Branding.ChatBotName chat that aren’t in your appointment history yet.</p>
        </div>
        <div class="pi-list">
            @foreach (var doctor in Model.Profile.ViewedDoctors.Where(d => Model.PastAppointments.All(a => a.DoctorId != d.DoctorId)))
            {
                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-value">@doctor.Name</div>
                        <p class="pi-hint">@doctor.Specialty · @doctor.Location</p>
                        @if (doctor.HasReview)
                        {
                            <div class="patient-review-submitted" style="margin-top:10px;">
                                <div class="patient-review-stars">@string.Concat(Enumerable.Repeat("★", doctor.ReviewRating ?? 0))@string.Concat(Enumerable.Repeat("☆", 5 - (doctor.ReviewRating ?? 0)))</div>
                                <p>@doctor.ReviewText</p>
                            </div>
                        }
                    </div>
                    <a class="pi-action" href="/doctors/@doctor.DoctorId">View</a>
                </div>
            }
        </div>
    }
</main>
</body>
</html>
