@page
@model Docovee.Pages.Account.ProfileModel
@{
    Layout = null;
    ViewData["Title"] = $"My Profile — {Branding.SiteName}";
    var section = Model.Section;
    var edit = Model.EditField;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
</head>
<body class="pat-body">
<div class="pat-shell">
    <aside class="pat-sidebar" aria-label="Account menu">
        <a class="pat-logo" href="/">
            <span class="pat-logo-mark">@(Branding.SiteName.Length > 0 ? Branding.SiteName[0].ToString().ToUpperInvariant() : "N")</span>
            <span>@Branding.SiteName</span>
        </a>
        <div class="pat-nav" role="navigation" aria-label="Profile sections">
            <a class="pat-nav-item @(section == "personal" ? "active" : "")" href="/Account/Profile?section=personal">Personal information</a>
            <a class="pat-nav-item @(section == "security" ? "active" : "")" href="/Account/Profile?section=security">Login and security</a>
            <a class="pat-nav-item @(section == "notifications" ? "active" : "")" href="/Account/Profile?section=notifications">
                <span>Notifications</span>
                @if (Model.UpcomingAppointments.Count > 0)
                {
                    <span class="pat-nav-badge">@Model.UpcomingAppointments.Count</span>
                }
            </a>
            <a class="pat-nav-item @(section == "history" ? "active" : "")" href="/Account/Profile?section=history">Appointment history</a>
        </div>

        <div class="pat-sidebar-foot">
            <a href="/">Find a doctor</a>
            <a href="/Account/Logout">Sign out</a>
        </div>
    </aside>

    <main class="pat-main">
        @if (Model.Saved)
        {
            <div class="alert-success">Your personal information has been updated.</div>
        }
        @if (Model.PasswordChanged)
        {
            <div class="alert-success">Your password has been changed.</div>
        }
        @if (Model.ReviewSubmitted)
        {
            <div class="alert-success">Thank you — your review has been submitted.</div>
        }
        @if (!string.IsNullOrEmpty(Model.ReviewError))
        {
            <div class="alert-error">@Model.ReviewError</div>
        }
        @if (!string.IsNullOrEmpty(Model.FormError))
        {
            <div class="alert-error">@Model.FormError</div>
        }
        @if (!string.IsNullOrEmpty(Model.FormSuccess))
        {
            <div class="alert-success">@Model.FormSuccess</div>
        }

        @if (section == "personal")
        {
            <div class="pat-panel-head">
                <h1>Personal information</h1>
            </div>

            <div class="pi-list">
                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Name</div>
                        @if (edit == "name")
                        {
                            <form method="post" asp-page-handler="UpdatePersonal" class="pi-edit-form">
                                <input type="hidden" asp-for="PersonalInput.Username" />
                                <input type="hidden" asp-for="PersonalInput.DateOfBirth" />
                                <input type="hidden" asp-for="PersonalInput.Phone" />
                                <input asp-for="PersonalInput.FullName" class="pi-input" autocomplete="name" />
                                <div class="pi-edit-actions">
                                    <button type="submit" class="pi-save">Save</button>
                                    <a class="pi-cancel" href="/Account/Profile?section=personal">Cancel</a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="pi-value">@Model.Profile!.FullName</div>
                        }
                    </div>
                    @if (edit != "name")
                    {
                        <a class="pi-action" href="/Account/Profile?section=personal&edit=name">Edit</a>
                    }
                </div>

                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Date of birth</div>
                        @if (edit == "dob")
                        {
                            <form method="post" asp-page-handler="UpdatePersonal" class="pi-edit-form">
                                <input type="hidden" asp-for="PersonalInput.Username" />
                                <input type="hidden" asp-for="PersonalInput.FullName" />
                                <input type="hidden" asp-for="PersonalInput.Phone" />
                                <input asp-for="PersonalInput.DateOfBirth" type="date" class="pi-input" />
                                <div class="pi-edit-actions">
                                    <button type="submit" class="pi-save">Save</button>
                                    <a class="pi-cancel" href="/Account/Profile?section=personal">Cancel</a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="pi-value">@Model.Profile!.DateOfBirth.ToString("MMMM d, yyyy")</div>
                        }
                    </div>
                    @if (edit != "dob")
                    {
                        <a class="pi-action" href="/Account/Profile?section=personal&edit=dob">Edit</a>
                    }
                </div>

                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Phone Number</div>
                        @if (edit == "phone")
                        {
                            <form method="post" asp-page-handler="UpdatePersonal" class="pi-edit-form">
                                <input type="hidden" asp-for="PersonalInput.Username" />
                                <input type="hidden" asp-for="PersonalInput.FullName" />
                                <input type="hidden" asp-for="PersonalInput.DateOfBirth" />
                                <input asp-for="PersonalInput.Phone" type="tel" class="pi-input" autocomplete="tel" />
                                <div class="pi-edit-actions">
                                    <button type="submit" class="pi-save">Save</button>
                                    <a class="pi-cancel" href="/Account/Profile?section=personal">Cancel</a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="pi-value">@(string.IsNullOrWhiteSpace(Model.Profile!.Phone) ? "—" : Model.Profile.Phone)</div>
                            <p class="pi-hint">Having a verified phone number helps us send appointment reminders and important updates.</p>
                        }
                    </div>
                    @if (edit != "phone")
                    {
                        <a class="pi-action" href="/Account/Profile?section=personal&edit=phone">@(string.IsNullOrWhiteSpace(Model.Profile!.Phone) ? "Add" : "Edit")</a>
                    }
                </div>

                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Email Address</div>
                        <div class="pi-value">@Model.Profile!.Username</div>
                        <p class="pi-hint">
                            <a class="pi-link" href="/Account/Profile?section=security">Verify your email address</a>
                            to keep your account secure and receive booking confirmations.
                        </p>
                    </div>
                    <span class="pi-action pi-action-muted">Edit</span>
                </div>

                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Member since</div>
                        <div class="pi-value">@Model.Profile!.MemberSince.ToString("MMMM d, yyyy")</div>
                    </div>
                </div>
            </div>
        }
        else if (section == "security")
        {
            <div class="pat-panel-head">
                <h1>Login and security</h1>
            </div>

            <div class="pi-list">
                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Password</div>
                        @if (edit == "password")
                        {
                            <form method="post" asp-page-handler="ChangePassword" class="pi-edit-form">
                                <label class="pi-sublabel" for="NewPassword">New password</label>
                                <input id="NewPassword" name="NewPassword" type="password" class="pi-input" autocomplete="new-password" />
                                <label class="pi-sublabel" for="ConfirmPassword">Confirm new password</label>
                                <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="pi-input" autocomplete="new-password" />
                                <p class="pi-hint">At least 6 characters.</p>
                                <div class="pi-edit-actions">
                                    <button type="submit" class="pi-save">Update password</button>
                                    <a class="pi-cancel" href="/Account/Profile?section=security">Cancel</a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="pi-value">••••••••</div>
                        }
                    </div>
                    @if (edit != "password")
                    {
                        <a class="pi-action" href="/Account/Profile?section=security&edit=password">Edit</a>
                    }
                </div>

                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Email verification</div>
                        <div class="pi-value">@Model.Profile!.Username</div>
                        <p class="pi-hint">Verification emails will send once the site email service is set up.</p>
                        <form method="post" asp-page-handler="RequestEmailVerification" class="pi-inline-form">
                            <button type="submit" class="pi-link-btn">Send verification email</button>
                        </form>
                    </div>
                </div>

                <div class="pi-row">
                    <div class="pi-row-body">
                        <div class="pi-label">Phone number verification</div>
                        <div class="pi-value">@(string.IsNullOrWhiteSpace(Model.Profile!.Phone) ? "No phone on file" : Model.Profile.Phone)</div>
                        <p class="pi-hint">SMS verification will be available in a future update.</p>
                        <form method="post" asp-page-handler="RequestPhoneVerification" class="pi-inline-form">
                            <button type="submit" class="pi-link-btn" @(string.IsNullOrWhiteSpace(Model.Profile.Phone) ? "disabled" : null)>Send verification code</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else if (section == "notifications")
        {
            <div class="pat-panel-head">
                <h1>Notifications</h1>
                <p>Upcoming appointments and booking updates.</p>
            </div>

            @if (Model.UpcomingAppointments.Count == 0)
            {
                <div class="pi-list">
                    <div class="pi-row">
                        <div class="pi-row-body">
                            <div class="pi-value">No upcoming appointments.</div>
                            <p class="pi-hint"><a class="pi-link" href="/">Find a doctor</a> to book a visit.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="pi-list">
                    @foreach (var a in Model.UpcomingAppointments)
                    {
                        <div class="pi-row">
                            <div class="pi-row-body">
                                <div class="pi-label">@a.StartsAt.ToString("ddd, MMM d") · @a.StartsAt.ToString("h:mm tt")</div>
                                <div class="pi-value">@a.DoctorName</div>
                                <p class="pi-hint">@a.DoctorSpecialty@(!string.IsNullOrEmpty(a.DoctorLocation) ? $" · {a.DoctorLocation}" : "")</p>
                                <p class="pi-hint">@a.VisitReason · @ProfileModel.StatusLabel(a.Status)</p>
                            </div>
                            <a class="pi-action" href="/doctors/@a.DoctorId">View</a>
                        </div>
                    }
                </div>
            }
        }
        else if (section == "history")
        {
            <div class="pat-panel-head">
                <h1>Appointment history</h1>
                <p>Past visits — leave a review after your doctor confirms the appointment and @Model.ReviewEligibleDaysAfterConfirmed day@(Model.ReviewEligibleDaysAfterConfirmed == 1 ? "" : "s") have passed.</p>
            </div>

            @if (Model.PastAppointments.Count == 0)
            {
                <div class="pi-list">
                    <div class="pi-row">
                        <div class="pi-row-body">
                            <div class="pi-value">No past appointments yet.</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="pi-list">
                    @foreach (var a in Model.PastAppointments)
                    {
                        <div class="pi-row pi-row-stack">
                            <div class="pi-row-top">
                                <div class="pi-row-body">
                                    <div class="pi-label">@a.StartsAt.ToString("MMM d, yyyy") · @a.StartsAt.ToString("h:mm tt")</div>
                                    <div class="pi-value">@a.DoctorName</div>
                                    <p class="pi-hint">@a.DoctorSpecialty@(!string.IsNullOrEmpty(a.DoctorLocation) ? $" · {a.DoctorLocation}" : "")</p>
                                    <p class="pi-hint">@a.VisitReason · @ProfileModel.StatusLabel(a.Status)</p>
                                </div>
                                <a class="pi-action" href="/doctors/@a.DoctorId">Profile</a>
                            </div>

                            @if (!Docovee.DS.Entities.AppointmentStatuses.IsCanceled(a.Status))
                            {
                                if (a.HasReview)
                                {
                                    <div class="patient-review-submitted">
                                        <div class="patient-review-stars">@string.Concat(Enumerable.Repeat("★", a.ReviewRating ?? 0))@string.Concat(Enumerable.Repeat("☆", 5 - (a.ReviewRating ?? 0)))</div>
                                        <p>@a.ReviewText</p>
                                        <div class="patient-review-meta-row">
                                            @if (!string.IsNullOrWhiteSpace(a.ReviewWaitingTime))
                                            {
                                                <span><strong>Waiting time:</strong> @a.ReviewWaitingTime</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(a.ReviewRecommendation))
                                            {
                                                <span><strong>Recommendation:</strong> @a.ReviewRecommendation</span>
                                            }
                                        </div>
                                        <div class="profile-list-meta">Submitted @a.ReviewedAt?.ToString("MMM d, yyyy")</div>
                                    </div>
                                }
                                else if (a.CanLeaveReview)
                                {
                                    <form method="post" asp-page-handler="SubmitReview" class="patient-review-form">
                                        <input type="hidden" name="doctorId" value="@a.DoctorId" />
                                        <label class="review-label">Review @a.DoctorName</label>
                                        <div class="review-rating-row">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                <label class="review-star-label">
                                                    <input type="radio" name="rating" value="@star" required @(star == 5 ? "checked" : null) />
                                                    <span>@star</span>
                                                </label>
                                            }
                                        </div>

                                        <label class="review-label">Waiting time</label>
                                        <div class="review-choice-row">
                                            @foreach (var option in new[] { "Excellent", "Good", "Average", "Bad" })
                                            {
                                                <label class="review-choice-label">
                                                    <input type="radio" name="waitingTime" value="@option" required @(option == "Good" ? "checked" : null) />
                                                    <span>@option</span>
                                                </label>
                                            }
                                        </div>

                                        <label class="review-label">How would you recommend this doctor?</label>
                                        <div class="review-choice-row">
                                            @foreach (var option in new[] { "Highly Recommended", "Neutral", "Not Recommended" })
                                            {
                                                <label class="review-choice-label">
                                                    <input type="radio" name="recommendation" value="@option" required @(option == "Highly Recommended" ? "checked" : null) />
                                                    <span>@option</span>
                                                </label>
                                            }
                                        </div>

                                        <label class="review-label" for="review-@a.Id">Your review</label>
                                        <textarea id="review-@a.Id" name="reviewText" class="review-textarea" rows="3" required placeholder="Share your experience with this doctor..."></textarea>
                                        <button type="submit" class="btn-primary btn-sm">Submit review</button>
                                    </form>
                                }
                                else if (Docovee.DS.Entities.AppointmentStatuses.IsConfirmedWithDoctor(a.Status)
                                         && a.ReviewAvailableOn is DateOnly availableOn
                                         && availableOn > DateOnly.FromDateTime(DateTime.Today))
                                {
                                    <p class="pi-hint" style="margin:0;">
                                        Review available on @availableOn.ToString("MMM d, yyyy") (@Model.ReviewEligibleDaysAfterConfirmed day@(Model.ReviewEligibleDaysAfterConfirmed == 1 ? "" : "s") after your confirmed visit).
                                    </p>
                                }
                            }
                        </div>
                    }
                </div>
            }

            @if (Model.Profile!.ViewedDoctors.Any(d => !d.HasReview && Model.PastAppointments.All(a => a.DoctorId != d.DoctorId)))
            {
                <div class="pat-panel-head" style="margin-top:32px;">
                    <h1 style="font-size:22px;">Doctors you’ve contacted</h1>
                    <p>Doctors from Nuvi chat that aren’t in your appointment history yet.</p>
                </div>
                <div class="pi-list">
                    @foreach (var doctor in Model.Profile.ViewedDoctors.Where(d => Model.PastAppointments.All(a => a.DoctorId != d.DoctorId)))
                    {
                        <div class="pi-row">
                            <div class="pi-row-body">
                                <div class="pi-value">@doctor.Name</div>
                                <p class="pi-hint">@doctor.Specialty · @doctor.Location</p>
                                @if (doctor.HasReview)
                                {
                                    <div class="patient-review-submitted" style="margin-top:10px;">
                                        <div class="patient-review-stars">@string.Concat(Enumerable.Repeat("★", doctor.ReviewRating ?? 0))@string.Concat(Enumerable.Repeat("☆", 5 - (doctor.ReviewRating ?? 0)))</div>
                                        <p>@doctor.ReviewText</p>
                                    </div>
                                }
                            </div>
                            <a class="pi-action" href="/doctors/@doctor.DoctorId">View</a>
                        </div>
                    }
                </div>
            }
        }
    </main>
</div>
</body>
</html>
