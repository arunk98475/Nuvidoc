@page
@model Docovee.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = $"Forgot password — {Branding.SiteName}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <partial name="Shared/_Favicon" />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
</head>
<body class="dl-body">
<div class="dl-page">
    <div class="dl-card">
        <div class="dl-brand">
            <img class="dl-mark" src="~/images/favicon_large.png" asp-append-version="true" alt="" width="44" height="44" />
            <span class="dl-brand-name">@Branding.SiteName</span>
        </div>
        <h1 class="dl-title">Forgot password</h1>
        <p class="pi-hint" style="margin-bottom:16px;">Enter the email for your patient account. If it matches an account, we will send a reset link.</p>

        @if (!string.IsNullOrEmpty(Model.FormError))
        {
            <div class="dl-error">@Model.FormError</div>
        }
        @if (!string.IsNullOrEmpty(Model.FormSuccess))
        {
            <div class="alert-success">@Model.FormSuccess</div>
        }

        <form method="post" novalidate>
            <div class="dl-field">
                <input asp-for="Input.Email" id="fp-email" class="dl-input" type="email" autocomplete="username" placeholder=" " />
                <label class="dl-float-label" for="fp-email">Email address</label>
            </div>
            <button type="submit" class="dl-btn">Send reset link</button>
        </form>
        <p style="margin-top:16px;"><a class="pi-link" href="/?login=patient">Back to sign in</a></p>
    </div>
</div>
@await Component.InvokeAsync("SiteFooter")
</body>
</html>
