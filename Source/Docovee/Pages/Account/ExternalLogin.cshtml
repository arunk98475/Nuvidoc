@page
@model Docovee.Pages.Account.ExternalLoginModel
@{
    Layout = null;
    ViewData["Title"] = $"Social sign-in — {Branding.SiteName}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <partial name="Shared/_Favicon" />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
</head>
<body>
<nav>
    <partial name="Shared/_SiteLogo" />
    <div class="nav-right">
        <a href="/" class="nav-link">Home</a>
    </div>
</nav>
<div class="auth-page">
    <div class="auth-card">
        <h1>@Model.Provider sign-in</h1>
        <p class="auth-subtitle">@Model.Message</p>
        <p class="auth-footer-link">
            <a href="/?login=patient">Return to patient log in</a>
        </p>
    </div>
</div>
</body>
</html>
