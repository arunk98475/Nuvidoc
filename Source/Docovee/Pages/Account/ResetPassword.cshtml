@page
@model Docovee.Pages.Account.ResetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = $"Reset password — {Branding.SiteName}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <partial name="Shared/_Favicon" />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
</head>
<body class="dl-body">
<div class="dl-page">
    <div class="dl-card">
        <div class="dl-brand">
            <img class="dl-mark" src="~/images/favicon_large.png" asp-append-version="true" alt="" width="44" height="44" />
            <span class="dl-brand-name">@Branding.SiteName</span>
        </div>
        <h1 class="dl-title">Reset password</h1>

        @if (!string.IsNullOrEmpty(Model.FormError))
        {
            <div class="dl-error">@Model.FormError</div>
        }
        @if (!string.IsNullOrEmpty(Model.FormSuccess))
        {
            <div class="alert-success">@Model.FormSuccess</div>
            <p style="margin-top:16px;"><a class="dl-btn" href="/?login=patient" style="display:inline-block;text-align:center;text-decoration:none;">Sign in</a></p>
        }
        else if (Model.TokenValid)
        {
            <form method="post" novalidate>
                <input type="hidden" asp-for="Token" />
                <div class="dl-field">
                    <input asp-for="Input.NewPassword" id="rp-new" class="dl-input" type="password" autocomplete="new-password" placeholder=" " />
                    <label class="dl-float-label" for="rp-new">New password</label>
                </div>
                <div class="dl-field">
                    <input asp-for="Input.ConfirmPassword" id="rp-confirm" class="dl-input" type="password" autocomplete="new-password" placeholder=" " />
                    <label class="dl-float-label" for="rp-confirm">Confirm password</label>
                </div>
                <p class="pi-hint">At least 6 characters.</p>
                <button type="submit" class="dl-btn">Update password</button>
            </form>
        }
        else
        {
            <p style="margin-top:16px;"><a class="pi-link" href="/Account/ForgotPassword">Request a new reset link</a></p>
        }
    </div>
</div>
@await Component.InvokeAsync("SiteFooter")
</body>
</html>
