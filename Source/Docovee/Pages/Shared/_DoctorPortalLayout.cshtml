@using System.Security.Claims
@using Docovee.BLL.Services
@inject IAppointmentService AppointmentService
@{
    var nav = (ViewData["Nav"] as string ?? "").ToLowerInvariant();
    var title = ViewData["Title"] as string ?? "Doctor portal";
    var brandInitial = Branding.SiteName.Length > 0 ? Branding.SiteName[0].ToString().ToUpperInvariant() : "N";
    var inboxBadge = 0;
    if (User.Identity?.IsAuthenticated == true
        && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var doctorId))
    {
        inboxBadge = await AppointmentService.CountActionRequiredAsync(doctorId);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — @Branding.SiteName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doctor-portal.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="dp-shell">
    <aside class="dp-sidebar" aria-label="Doctor portal navigation">
        <a class="dp-logo" href="/Doctor">
            <span class="dp-logo-mark">@brandInitial</span>
            <span>@Branding.SiteName</span>
        </a>

        <nav class="dp-nav">
            <a class="dp-nav-item @(nav == "dashboard" ? "active" : "")" href="/Doctor">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                <span class="label">Dashboard</span>
            </a>
            <a class="dp-nav-item @(nav == "inbox" ? "active" : "")" href="/Doctor/Inbox">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
                <span class="label">Inbox</span>
                @if (inboxBadge > 0)
                {
                    <span class="dp-nav-badge">@(inboxBadge > 99 ? "99+" : inboxBadge.ToString())</span>
                }
            </a>
            <a class="dp-nav-item @(nav == "calendar" ? "active" : "")" href="/Doctor/Calendar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
                <span class="label">Calendar</span>
            </a>
            <a class="dp-nav-item @(nav.StartsWith("performance") ? "active" : "")" href="/Doctor/Performance">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V5M4 19h16"/><path d="M8 16v-5M12 16V8M16 16v-8"/></svg>
                <span class="label">Performance</span>
            </a>
            <a class="dp-nav-item @(nav == "features" ? "active" : "")" href="/Doctor/Features">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 14.5 9.5 21 12 14.5 14.5 12 21 9.5 14.5 3 12 9.5 9.5z"/></svg>
                <span class="label">Features</span>
            </a>
            @{
                var settingsOpen = nav.StartsWith("settings");
                var settingsSection = nav.StartsWith("settings-") ? nav["settings-".Length..] : "practice";
            }
            <div class="dp-nav-group @(settingsOpen ? "is-open" : "")" id="dp-settings-group">
                <button type="button" class="dp-nav-item dp-nav-toggle @(settingsOpen ? "active" : "")" id="dp-settings-toggle" aria-expanded="@(settingsOpen ? "true" : "false")" aria-controls="dp-settings-sub">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9c.3.6.9 1 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                    <span class="label">Settings</span>
                    <svg class="dp-nav-chevron" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
                </button>
                <div class="dp-nav-sub" id="dp-settings-sub" @(settingsOpen ? null : "hidden")>
                    <a class="@(settingsSection == "practice" ? "active" : "")" href="/Doctor/Settings/practice">Practice details</a>
                    <a class="@(settingsSection == "locations" || settingsSection == "location" ? "active" : "")" href="/Doctor/Settings/locations">Locations</a>
                    <a class="@(settingsSection == "visit-reasons" ? "active" : "")" href="/Doctor/Settings/visit-reasons">Visit reasons</a>
                    <a class="@(settingsSection == "insurance" ? "active" : "")" href="/Doctor/Settings/insurance">Insurance</a>
                    <a class="@(settingsSection == "working-hours" ? "active" : "")" href="/Doctor/Settings/working-hours">Working hours</a>
                    <a class="@(settingsSection == "booking-link" ? "active" : "")" href="/Doctor/Settings/booking-link">Booking Link</a>
                    <a class="@(settingsSection == "legal" ? "active" : "")" href="/Doctor/Settings/legal">Legal</a>
                </div>
            </div>
        </nav>

        <div class="dp-sidebar-foot">
            <a href="/Account/Logout">Sign out</a>
        </div>
    </aside>

    <div class="dp-main">
        @RenderBody()
    </div>
</div>
<script>
(function () {
  const group = document.getElementById("dp-settings-group");
  const toggle = document.getElementById("dp-settings-toggle");
  const sub = document.getElementById("dp-settings-sub");
  if (!group || !toggle || !sub) return;
  toggle.addEventListener("click", function () {
    const open = group.classList.toggle("is-open");
    sub.hidden = !open;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>