@*
  Zocdoc-style patient account controls: notifications + name dropdown.
  Expects ViewData:
    PatientDisplayName (string) — full name
    PatientNotifyCount (int, optional) — unread notification count
*@
@{
    var fullName = (ViewData["PatientDisplayName"] as string)?.Trim();
    if (string.IsNullOrWhiteSpace(fullName))
        fullName = User.Identity?.Name ?? "Account";
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;
    var notifyCount = ViewData["PatientNotifyCount"] as int? ?? 0;
    var siteName = Branding.SiteName;
}
<div class="pac-nav" id="patient-account-nav">
    <div class="pac-notify-wrap" id="pac-notify-wrap">
        <button type="button" class="pac-notify" id="pac-notify-btn" aria-label="Notifications" aria-expanded="false" aria-haspopup="true" aria-controls="pac-notify-menu">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <span class="pac-notify-count" data-notify-badge="1"@if (notifyCount <= 0) { <text> hidden</text> }>@notifyCount</span>
        </button>
        <div class="pac-notify-menu" id="pac-notify-menu" role="menu" hidden>
            <div class="pac-notify-list" id="pac-notify-list">
                <p class="pac-notify-empty">Loading…</p>
            </div>
            <a class="pac-notify-all" role="menuitem" href="/Account/Profile?section=notifications">See all notifications</a>
        </div>
    </div>

    <div class="pac-dropdown" id="pac-dropdown">
        <button type="button" class="pac-user-btn" id="pac-user-btn" aria-expanded="false" aria-haspopup="true">
            <span>@firstName</span>
            <svg class="pac-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="pac-menu" id="pac-menu" role="menu">
            <a class="pac-menu-item" role="menuitem" href="/?chat=1">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span>My @siteName</span>
            </a>
            <a class="pac-menu-item" role="menuitem" href="/?chat=1">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
                <span>Well Guide</span>
            </a>
            <a class="pac-menu-item" role="menuitem" href="/Account/Profile?section=appointments">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                <span>Appointments</span>
            </a>
            <a class="pac-menu-item" role="menuitem" href="/Account/Appointments">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 3h18v4H3z"/><path d="M3 10h18v11H3z"/><path d="M8 14h8"/><path d="M8 18h5"/></svg>
                <span>Appointment history</span>
            </a>
            <div class="pac-menu-divider"></div>
            <a class="pac-menu-item" role="menuitem" href="/Account/Profile">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Settings</span>
            </a>
            <a class="pac-menu-item" role="menuitem" href="/Account/Logout">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                <span>Sign out</span>
            </a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/patient-notifications.js" asp-append-version="true"></script>
<script>
(function () {
  var PREVIEW_LIMIT = 5;
  var ALL_HREF = "/Account/Profile?section=notifications";
  var LOGO_SRC = "/images/favicon_large.png";

  var userRoot = document.getElementById("pac-dropdown");
  var userBtn = document.getElementById("pac-user-btn");
  var userMenu = document.getElementById("pac-menu");
  var notifyWrap = document.getElementById("pac-notify-wrap");
  var notifyBtn = document.getElementById("pac-notify-btn");
  var notifyMenu = document.getElementById("pac-notify-menu");
  var notifyList = document.getElementById("pac-notify-list");
  var previewItems = [];
  var previewLoaded = false;
  var previewLoading = false;

  function closeUserMenu() {
    if (!userRoot || !userBtn) return;
    userBtn.setAttribute("aria-expanded", "false");
    userRoot.classList.remove("is-open");
  }
  function openUserMenu() {
    if (!userRoot || !userBtn) return;
    closeNotifyMenu();
    userBtn.setAttribute("aria-expanded", "true");
    userRoot.classList.add("is-open");
  }
  function closeNotifyMenu() {
    if (!notifyWrap || !notifyBtn || !notifyMenu) return;
    notifyBtn.setAttribute("aria-expanded", "false");
    notifyWrap.classList.remove("is-open");
    notifyMenu.setAttribute("hidden", "");
  }
  function openNotifyMenu() {
    if (!notifyWrap || !notifyBtn || !notifyMenu) return;
    closeUserMenu();
    notifyBtn.setAttribute("aria-expanded", "true");
    notifyWrap.classList.add("is-open");
    notifyMenu.removeAttribute("hidden");
    loadPreview();
  }

  function itemText(item) {
    var title = ((item && item.title) || "").trim();
    var body = ((item && item.body) || "").trim();
    if (title && body) {
      if (body.indexOf(title) === 0) return body;
      return title + " " + body;
    }
    return body || title || "Nuvi update";
  }

  function renderPreview() {
    if (!notifyList) return;
    notifyList.innerHTML = "";
    var slice = previewItems.slice(0, PREVIEW_LIMIT);
    if (slice.length === 0) {
      var empty = document.createElement("p");
      empty.className = "pac-notify-empty";
      empty.textContent = previewLoaded ? "No notifications yet." : "Loading…";
      notifyList.appendChild(empty);
      return;
    }
    slice.forEach(function (item) {
      var row = document.createElement("a");
      row.className = "pac-notify-item" + (item.isRead ? "" : " pac-notify-item-unread");
      row.href = ALL_HREF;
      row.setAttribute("role", "menuitem");

      var img = document.createElement("img");
      img.className = "pac-notify-avatar";
      img.src = LOGO_SRC;
      img.alt = "";
      img.width = 36;
      img.height = 36;

      var text = document.createElement("span");
      text.className = "pac-notify-text";
      text.textContent = itemText(item);

      row.appendChild(img);
      row.appendChild(text);
      notifyList.appendChild(row);
    });
  }

  function upsertPreview(item) {
    if (!item) return;
    var id = item.id != null ? item.id : item.notificationId;
    if (id != null) {
      previewItems = previewItems.filter(function (n) { return n.id !== id; });
      item.id = id;
    }
    previewItems.unshift(item);
    previewLoaded = true;
    renderPreview();
  }

  function loadPreview() {
    if (previewLoading) return;
    if (previewLoaded) {
      renderPreview();
      return;
    }
    previewLoading = true;
    fetch("/api/notifications", { credentials: "same-origin", headers: { Accept: "application/json" } })
      .then(function (res) {
        var type = (res.headers.get("content-type") || "").toLowerCase();
        if (!res.ok || type.indexOf("application/json") === -1) return Promise.reject();
        return res.json();
      })
      .then(function (data) {
        previewItems = (data && data.items) ? data.items.slice() : [];
        previewLoaded = true;
        if (data && typeof data.unreadCount === "number" && window.NuvidocPatientPush) {
          window.NuvidocPatientPush.setBellCount(data.unreadCount);
        }
        renderPreview();
      })
      .catch(function () {
        if (!notifyList) return;
        notifyList.innerHTML = "";
        var err = document.createElement("p");
        err.className = "pac-notify-empty";
        err.textContent = "Couldn't load notifications.";
        notifyList.appendChild(err);
      })
      .finally(function () {
        previewLoading = false;
      });
  }

  if (userRoot && userBtn && userMenu) {
    userBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      if (userRoot.classList.contains("is-open")) closeUserMenu();
      else openUserMenu();
    });
  }

  if (notifyWrap && notifyBtn && notifyMenu) {
    notifyBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      if (notifyWrap.classList.contains("is-open")) closeNotifyMenu();
      else openNotifyMenu();
    });
  }

  document.addEventListener("click", function (e) {
    if (userRoot && !userRoot.contains(e.target)) closeUserMenu();
    if (notifyWrap && !notifyWrap.contains(e.target)) closeNotifyMenu();
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      closeUserMenu();
      closeNotifyMenu();
    }
  });

  if (window.NuvidocPatientPush) {
    window.NuvidocPatientPush.start({ joinPatient: true }).catch(function () { /* hub optional */ });
    window.NuvidocPatientPush.onBookingUpdated(function (message) {
      upsertPreview({
        id: message && message.notificationId,
        title: (message && message.title) || "Nuvi update",
        body: (message && (message.body || message.chatMessage)) || "",
        doctorId: message && message.doctorId,
        isRead: false
      });
    });
  }
})();
</script>
