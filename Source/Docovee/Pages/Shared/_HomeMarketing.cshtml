@model IReadOnlyList<Docovee.DS.Models.FeaturedDoctorCardDto>
@using Docovee.DS.Models

<section class="hp-stats" aria-label="Trust statistics">
    <div class="hp-stats-inner">
        <div class="hp-stat"><div class="hp-stat-num">3 min</div><div class="hp-stat-label">Average time to match</div></div>
        <div class="hp-stat"><div class="hp-stat-num">Growing</div><div class="hp-stat-label">Dentist network across the US</div></div>
        <div class="hp-stat"><div class="hp-stat-num">98%</div><div class="hp-stat-label">Patient satisfaction rate</div></div>
        <div class="hp-stat"><div class="hp-stat-num">$0</div><div class="hp-stat-label">Cost to patients — always free</div></div>
    </div>
</section>

<section class="hp-insurance-bar" aria-label="Insurance partners">
    <div class="hp-insurance-inner">
        <div class="hp-insurance-title">Works with major dental insurance plans</div>
        <div class="hp-insurance-logos">
            <span class="hp-ins-logo hp-ins-aetna">DELTA DENTAL</span>
            <span class="hp-ins-logo hp-ins-cigna">CIGNA</span>
            <span class="hp-ins-logo hp-ins-united">UNITED</span>
            <span class="hp-ins-logo hp-ins-bcbs">BLUE CROSS</span>
            <span class="hp-ins-logo hp-ins-medicare">AETNA</span>
            <span class="hp-ins-logo hp-ins-humana">HUMANA</span>
            <span class="hp-ins-more">+ more →</span>
        </div>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-white" aria-labelledby="why-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">Why @Branding.SiteName</div>
            <h2 class="section-h2" id="why-heading">Finding a dentist shouldn't feel like<br><em>searching in the dark.</em></h2>
        </div>
        <div class="hp-why-grid">
            <div class="hp-why-card hp-why-featured">
                <div class="hp-why-icon">🎯</div>
                <h3>Matched, not just listed</h3>
                <p>Most finders show you a list. @Branding.SiteName understands your situation and finds the dentist who's actually right for you — needs, location, and preferences.</p>
            </div>
            <div class="hp-why-card">
                <div class="hp-why-icon">⚡</div>
                <h3>Book in minutes, not days</h3>
                <p>No hold music. No calling three offices. See real availability and request a visit instantly.</p>
            </div>
            <div class="hp-why-card">
                <div class="hp-why-icon">🤝</div>
                <h3>Reviews you can trust</h3>
                <p>Reviews from verified patients who actually visited. We track what matters: did they listen, were they on time, would patients go back.</p>
            </div>
        </div>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-mist" aria-labelledby="visit-reasons-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">Common Visit Reasons</div>
            <h2 class="section-h2" id="visit-reasons-heading">What brings you in <em>today?</em></h2>
        </div>
        <div class="hp-reasons-grid">
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I need a teeth cleaning')"><span class="hp-reason-emoji">🦷</span><span>Cleaning</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('Tooth pain')"><span class="hp-reason-emoji">😣</span><span>Tooth Pain</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I want dental implants')"><span class="hp-reason-emoji">✨</span><span>Implants</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I want teeth whitening')"><span class="hp-reason-emoji">💎</span><span>Whitening</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I am interested in Invisalign')"><span class="hp-reason-emoji">😁</span><span>Invisalign</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I need a new patient dental exam')"><span class="hp-reason-emoji">📋</span><span>New patient exam</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('Emergency dental visit')"><span class="hp-reason-emoji">🚨</span><span>Emergency</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I have TMJ pain')"><span class="hp-reason-emoji">🦴</span><span>TMJ</span></button>
            <button type="button" class="hp-reason-btn hp-reason-btn-accent" onclick="fillChatInput('')"><span class="hp-reason-emoji">✦</span><span>Something else</span></button>
        </div>
        <p class="hp-reasons-link-wrap">
            <a href="#" class="hp-text-link" onclick="scrollToChat(); return false;">Tell @Branding.ChatBotName what’s going on →</a>
        </p>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-white" aria-labelledby="specialties-heading">
    <div class="hp-container">
        <div class="hp-specialties-grid">
            <div>
                <div class="section-eyebrow">Dental care</div>
                <h2 class="section-h2" id="specialties-heading">Dentists.<br><em>One place.</em></h2>
                <p class="section-body">We're focused on dentistry first. Tell @Branding.ChatBotName what you need — general care, ortho, implants, or emergency relief — and we'll match you.</p>
            </div>
            <div class="hp-specialty-tags">
                <div class="hp-specialty-tag">🦷 General Dentist</div>
                <div class="hp-specialty-tag">😁 Orthodontist</div>
                <div class="hp-specialty-tag">🦴 Oral Surgeon</div>
                <div class="hp-specialty-tag">🦷 Periodontist</div>
                <div class="hp-specialty-tag">✨ Implants</div>
                <div class="hp-specialty-tag">💎 Cosmetic</div>
                <div class="hp-specialty-tag">👶 Pediatric Dentistry</div>
                <button type="button" class="hp-specialty-tag hp-specialty-more" onclick="scrollToChat()">Ask Nuvi →</button>
            </div>
        </div>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-mist" id="testimonials" aria-labelledby="testimonials-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">Top Dentists</div>
            <h2 class="section-h2" id="testimonials-heading">Real dentists.<br><em>Real results.</em></h2>
            <p class="section-body hp-doctors-subtitle">Highly rated providers in our network — tap a card to view profile, contact info, and reviews.</p>
        </div>
        @if (Model is { Count: > 0 })
        {
            <div class="hp-testimonials-grid">
                @foreach (var doctor in Model)
                {
                    var stars = doctor.GoogleRating > 0
                        ? new string('★', (int)Math.Round(doctor.GoogleRating))
                        : "★★★★★";
                    var location = $"{doctor.City}, {doctor.State}";
                    var highlight = string.IsNullOrWhiteSpace(doctor.HighlightText)
                        ? $"Trusted {doctor.Specialty} in {location}."
                        : doctor.HighlightText;
                    <a href="/doctors/@doctor.Id"
                            class="hp-testimonial hp-doctor-card@(doctor.IsFeatured ? " hp-testimonial-featured" : "")"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="View profile for @doctor.Name">
                        <div class="hp-stars" title="@doctor.GoogleRating.ToString("0.0") rating">@stars</div>
                        <p>@highlight</p>
                        <footer>
                            @if (!string.IsNullOrWhiteSpace(doctor.PhotoUrl))
                            {
                                <img class="hp-doctor-card-photo" src="@doctor.PhotoUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="hp-testimonial-avatar">@doctor.AvatarInitials</span>
                            }
                            <div>
                                <strong>@doctor.Name</strong>
                                <span>@doctor.Specialty · @location</span>
                                @if (doctor.GoogleReviewCount > 0)
                                {
                                    <span class="hp-doctor-review-count">@doctor.GoogleReviewCount Google reviews</span>
                                }
                            </div>
                        </footer>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="section-body">We're adding dentists to our network every day. <a href="#" class="hp-text-link" onclick="scrollToChat(); return false;">Tell @Branding.ChatBotName what you need →</a></p>
        }
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-white" id="how-it-works" aria-labelledby="how-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">No more guessing</div>
            <h2 class="section-h2" id="how-heading">We do the work.<br><em>You just show up.</em></h2>
        </div>
        <div class="hp-steps-panel">
            <div class="hp-step-panel-item">
                <div class="hp-step-panel-num">01</div>
                <h3>Tell us what's wrong</h3>
                <p>Describe what's going on in your own words — “my molar hurts when I bite” works perfectly.</p>
            </div>
            <div class="hp-step-panel-item">
                <div class="hp-step-panel-num">02</div>
                <h3>We find your best match</h3>
                <p>A few quick follow-ups — urgency, location, preferences — then we rank dentists by fit. Not by who paid the most.</p>
            </div>
            <div class="hp-step-panel-item">
                <div class="hp-step-panel-num">03</div>
                <h3>Book and we handle the rest</h3>
                <p>Request a visit online. The office confirms, and you're on the calendar.</p>
            </div>
        </div>
    </div>
</section>

<section class="hp-cta" aria-labelledby="cta-heading">
    <div class="hp-cta-inner">
        <div class="section-eyebrow hp-cta-eyebrow">Start Now — It's Free</div>
        <h2 id="cta-heading">The right dentist is<br><em>closer than you think.</em></h2>
        <p>Tell us what's going on. We'll handle matching and booking. Always free for patients.</p>
        <button type="button" class="hp-cta-btn" onclick="scrollToChat()">Find My Dentist Now →</button>
        <div class="hp-cta-note">Free for patients · No account required to start</div>
    </div>
</section>

<nav class="hp-browse" aria-label="Browse directory">
    <div class="hp-container">
        <div class="hp-browse-grid">
            <div>
                <div class="hp-browse-title">Browse Dentists</div>
                <a href="#" onclick="fillChatInput('I need a dentist'); return false;">Dentists Near Me</a>
                <a href="#" onclick="fillChatInput('I need an orthodontist'); return false;">Orthodontists</a>
                <a href="#" onclick="fillChatInput('I need an oral surgeon'); return false;">Oral Surgeons</a>
                <a href="#" onclick="fillChatInput('I need a periodontist'); return false;">Periodontists</a>
                <a href="#" onclick="fillChatInput('I need a pediatric dentist'); return false;">Pediatric Dentists</a>
                <a href="#" class="hp-browse-more" onclick="scrollToChat(); return false;">Ask Nuvi →</a>
            </div>
            <div>
                <div class="hp-browse-title">Browse Concerns</div>
                <a href="#" onclick="fillChatInput('Tooth pain'); return false;">Tooth Pain</a>
                <a href="#" onclick="fillChatInput('I need a teeth cleaning'); return false;">Cleaning</a>
                <a href="#" onclick="fillChatInput('Emergency dental visit'); return false;">Emergency Dental</a>
                <a href="#" onclick="fillChatInput('I have TMJ pain'); return false;">TMJ</a>
                <a href="#" onclick="fillChatInput('I need a filling'); return false;">Fillings</a>
                <a href="#" class="hp-browse-more" onclick="scrollToChat(); return false;">Something else →</a>
            </div>
            <div>
                <div class="hp-browse-title">Browse Procedures</div>
                <a href="#" onclick="fillChatInput('I need dental implants'); return false;">Dental Implants</a>
                <a href="#" onclick="fillChatInput('I want teeth whitening'); return false;">Teeth Whitening</a>
                <a href="#" onclick="fillChatInput('I am interested in Invisalign'); return false;">Invisalign</a>
                <a href="#" onclick="fillChatInput('I need a root canal'); return false;">Root Canal</a>
                <a href="#" onclick="fillChatInput('I need a crown'); return false;">Crowns</a>
                <a href="#" class="hp-browse-more" onclick="scrollToChat(); return false;">Ask Nuvi →</a>
            </div>
            <div>
                <div class="hp-browse-title">@Branding.SiteName</div>
                <a href="#how-it-works">About Us</a>
                <a href="#how-it-works">How It Works</a>
                <a href="#testimonials">Verified Reviews</a>
                <a href="/Account/Register">Create Account</a>
                <a href="/Account/Login">Sign In</a>
                <a href="/Account/Register" class="hp-browse-accent">List your practice →</a>
            </div>
        </div>
    </div>
</nav>
