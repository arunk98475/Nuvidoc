@model Docovee.Pages.Shared.HomeMarketingModel
@using Docovee.DS.Models
@{
    var doctors = Model.FeaturedDoctors;
    var home = Model.Home;
}

<section class="hp-stats" aria-label="Trust statistics">
    <div class="hp-stats-inner">
        <div class="hp-stat">
            <div class="hp-stat-num">@(Model.ImplantSpecialistCount > 0 ? $"{Model.ImplantSpecialistCount}+" : "—")</div>
            <div class="hp-stat-label">Implant specialists</div>
        </div>
        <div class="hp-stat">
            <div class="hp-stat-num">@(Model.AverageGoogleRating > 0 ? $"{Model.AverageGoogleRating:0.0}★" : "—")</div>
            <div class="hp-stat-label">Average rating</div>
        </div>
        <div class="hp-stat"><div class="hp-stat-num">24hr</div><div class="hp-stat-label">Consultation booking</div></div>
        <div class="hp-stat"><div class="hp-stat-num">$0</div><div class="hp-stat-label">Matching fee</div></div>
    </div>
</section>

<section class="hp-seo-strip" aria-label="Dental implant searches">
    <div class="hp-seo-strip-inner">
        <a class="hp-seo-chip" href="/services/dental-implants-houston">Dental Implants Houston</a>
        <a class="hp-seo-chip" href="/services/dental-implants-houston">Single Tooth Implant</a>
        <a class="hp-seo-chip" href="/services/dental-implants-houston">All-on-4 Implants</a>
        <a class="hp-seo-chip" href="/services/dental-implants-houston">Full Mouth Reconstruction</a>
        <a class="hp-seo-chip" href="/services/dental-implants-houston">Implant Supported Dentures</a>
        <a class="hp-seo-chip hp-seo-chip-more" href="/services/dental-implants-houston">Learn more →</a>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-white" aria-labelledby="why-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">Why NuviDoc for Implants</div>
            <h2 class="section-h2" id="why-heading">The smarter way to find your implant specialist</h2>
        </div>
        <div class="hp-why-grid">
            <div class="hp-why-card hp-why-featured">
                <div class="hp-why-icon">🎯</div>
                <h3>AI-Matched Specialists</h3>
                <p>Nuvi analyzes your specific case — bone density concerns, budget, timeline — and matches you only with implant-qualified dentists nearby.</p>
            </div>
            <div class="hp-why-card">
                <div class="hp-why-icon">📞</div>
                <h3>We Call For You</h3>
                <p>Skip the hold music. Nuvi's AI calls offices on your behalf to check availability and book your consultation automatically.</p>
            </div>
            <div class="hp-why-card">
                <div class="hp-why-icon">💰</div>
                <h3>Transparent Pricing</h3>
                <p>Get upfront cost ranges for single implants, All-on-4, and full mouth restorations before you ever step into an office.</p>
            </div>
        </div>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-mist" aria-labelledby="implant-types-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">Implant Options</div>
            <h2 class="section-h2" id="implant-types-heading">Which implant solution is right for you?</h2>
        </div>
        <div class="hp-reasons-grid">
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I need a single tooth implant')"><span class="hp-reason-emoji">🦷</span><span>Single implant</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I am interested in All-on-4 implants')"><span class="hp-reason-emoji">✨</span><span>All-on-4</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I want full mouth dental implants')"><span class="hp-reason-emoji">😁</span><span>Full mouth</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I want implant supported dentures')"><span class="hp-reason-emoji">💎</span><span>Implant dentures</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I need a bone graft for dental implants')"><span class="hp-reason-emoji">🦴</span><span>Bone graft</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('I need a dental implant consultation')"><span class="hp-reason-emoji">📋</span><span>Free consult</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('How much do dental implants cost?')"><span class="hp-reason-emoji">💲</span><span>Implant cost</span></button>
            <button type="button" class="hp-reason-btn" onclick="fillChatInput('Do I qualify for dental implants?')"><span class="hp-reason-emoji">✅</span><span>Am I a candidate?</span></button>
            <button type="button" class="hp-reason-btn hp-reason-btn-accent" onclick="fillChatInput('')"><span class="hp-reason-emoji">✦</span><span>Ask Nuvi</span></button>
        </div>
        <p class="hp-reasons-link-wrap">
            <a href="#" class="hp-text-link" onclick="scrollToChat(); return false;">Tell @Branding.ChatBotName about your situation →</a>
        </p>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-white" aria-labelledby="specialties-heading">
    <div class="hp-container">
        <div class="hp-specialties-grid">
            <div>
                <div class="section-eyebrow">Our Specialists</div>
                <h2 class="section-h2" id="specialties-heading">Implant-trained dentists across Houston</h2>
                <p class="section-body">From oral surgeons and periodontists to implant-certified general dentists — Nuvi matches you with the right provider for your case and budget.</p>
            </div>
            <div class="hp-specialty-tags">
                <div class="hp-specialty-tag">✨ Implant Dentists</div>
                <div class="hp-specialty-tag">🦴 Oral Surgeons</div>
                <div class="hp-specialty-tag">🦷 Periodontists</div>
                <div class="hp-specialty-tag">💎 Prosthodontists</div>
                <div class="hp-specialty-tag">😁 All-on-4 Specialists</div>
                <div class="hp-specialty-tag">📍 Near Me</div>
                <div class="hp-specialty-tag">💲 Financing Available</div>
                <button type="button" class="hp-specialty-tag hp-specialty-more" onclick="scrollToChat()">Find yours →</button>
            </div>
        </div>
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-mist" id="testimonials" aria-labelledby="testimonials-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">Featured Implant Specialists</div>
            <h2 class="section-h2" id="testimonials-heading">Highly rated dentists in Houston</h2>
            <p class="section-body hp-doctors-subtitle">Verified reviews from real patients who chose implants.</p>
        </div>
        @if (doctors is { Count: > 0 })
        {
            <div class="hp-testimonials-grid">
                @foreach (var doctor in doctors)
                {
                    var stars = doctor.GoogleRating > 0
                        ? new string('★', (int)Math.Round(doctor.GoogleRating))
                        : "★★★★★";
                    var location = $"{doctor.City}, {doctor.State}";
                    var highlight = string.IsNullOrWhiteSpace(doctor.HighlightText)
                        ? $"Trusted implant specialist in {location}."
                        : doctor.HighlightText;
                    <a href="/doctors/@doctor.Id"
                            class="hp-testimonial hp-doctor-card@(doctor.IsFeatured ? " hp-testimonial-featured" : "")"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="View profile for @doctor.Name">
                        <div class="hp-stars" title="@doctor.GoogleRating.ToString("0.0") rating">@stars</div>
                        <p>@highlight</p>
                        <footer>
                            @if (!string.IsNullOrWhiteSpace(doctor.PhotoUrl))
                            {
                                <img class="hp-doctor-card-photo" src="@doctor.PhotoUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="hp-testimonial-avatar">@doctor.AvatarInitials</span>
                            }
                            <div>
                                <strong>@doctor.Name</strong>
                                <span>@doctor.Specialty · @location</span>
                                @if (doctor.GoogleReviewCount > 0)
                                {
                                    <span class="hp-doctor-review-count">@doctor.GoogleReviewCount Google reviews</span>
                                }
                            </div>
                        </footer>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="section-body">We're adding implant specialists every day. <a href="#" class="hp-text-link" onclick="scrollToChat(); return false;">Tell @Branding.ChatBotName what you need →</a></p>
        }
    </div>
</section>

<hr class="hp-divider" />

<section class="hp-section hp-section-white" id="how-it-works" aria-labelledby="how-heading">
    <div class="hp-container">
        <div class="hp-section-header">
            <div class="section-eyebrow">How It Works</div>
            <h2 class="section-h2" id="how-heading">Get matched to an implant specialist in minutes</h2>
        </div>
        <div class="hp-steps-panel">
            <div class="hp-step-panel-item">
                <div class="hp-step-panel-num">01</div>
                <h3>Tell Nuvi your situation</h3>
                <p>Answer a few quick questions about which teeth are missing, your health history, timeline, and budget. Takes under 2 minutes.</p>
            </div>
            <div class="hp-step-panel-item">
                <div class="hp-step-panel-num">02</div>
                <h3>Get matched instantly</h3>
                <p>Nuvi ranks Houston implant dentists by fit score — factoring in your location, insurance, and the complexity of your case.</p>
            </div>
            <div class="hp-step-panel-item">
                <div class="hp-step-panel-num">03</div>
                <h3>We book your consult</h3>
                <p>Nuvi's AI calls the office for you, confirms availability, and locks in your consultation — no hold music, no back and forth.</p>
            </div>
        </div>
    </div>
</section>

<section class="hp-cta" aria-labelledby="cta-heading">
    <div class="hp-cta-inner">
        <div class="section-eyebrow hp-cta-eyebrow">Ready to get started?</div>
        <h2 id="cta-heading">Find your implant specialist today</h2>
        <p>Free matching · No commitment · Book a consultation in minutes</p>
        <button type="button" class="hp-cta-btn" onclick="scrollToChat()">Find My Implant Dentist</button>
        <div class="hp-cta-note">Serving Houston & surrounding areas · 500+ verified specialists</div>
    </div>
</section>

<nav class="hp-browse" aria-label="Browse implant options">
    <div class="hp-container">
        <div class="hp-browse-grid">
            <div>
                <div class="hp-browse-title">Implant Services</div>
                <a href="#" onclick="fillChatInput('I need a single tooth implant'); return false;">Single Tooth Implant</a>
                <a href="#" onclick="fillChatInput('I am interested in All-on-4 implants'); return false;">All-on-4 Implants</a>
                <a href="#" onclick="fillChatInput('I want full mouth dental implants'); return false;">Full Mouth Implants</a>
                <a href="#" onclick="fillChatInput('I want implant supported dentures'); return false;">Implant Dentures</a>
                <a href="#" onclick="fillChatInput('I need a bone graft for dental implants'); return false;">Bone Grafting</a>
                <a href="/services/dental-implants-houston" class="hp-browse-more">All implant options →</a>
            </div>
            <div>
                <div class="hp-browse-title">Common Questions</div>
                <a href="#" onclick="fillChatInput('How much do dental implants cost?'); return false;">Implant cost</a>
                <a href="#" onclick="fillChatInput('Do I qualify for dental implants?'); return false;">Am I a candidate?</a>
                <a href="#" onclick="fillChatInput('How long does the implant process take?'); return false;">Timeline</a>
                <a href="#" onclick="fillChatInput('Does insurance cover dental implants?'); return false;">Insurance coverage</a>
                <a href="#" onclick="fillChatInput('Are dental implants painful?'); return false;">Pain &amp; recovery</a>
                <a href="#" class="hp-browse-more" onclick="scrollToChat(); return false;">Ask Nuvi →</a>
            </div>
            <div>
                <div class="hp-browse-title">By Specialist</div>
                <a href="#" onclick="fillChatInput('I need an oral surgeon for implants'); return false;">Oral Surgeon</a>
                <a href="#" onclick="fillChatInput('I need a periodontist for implants'); return false;">Periodontist</a>
                <a href="#" onclick="fillChatInput('I need a prosthodontist for implants'); return false;">Prosthodontist</a>
                <a href="#" onclick="fillChatInput('I need an implant dentist near me'); return false;">Near Me</a>
                <a href="#" onclick="fillChatInput('Dental implants with financing'); return false;">Financing Options</a>
                <a href="#" class="hp-browse-more" onclick="scrollToChat(); return false;">Find specialist →</a>
            </div>
            <div>
                <div class="hp-browse-title">@Branding.SiteName</div>
                <a href="#how-it-works">How It Works</a>
                <a href="#testimonials">Verified Specialists</a>
                <a href="/?signup=patient">Create Account</a>
                <a href="/?login=patient">Sign In</a>
                <a href="/Account/Register/Doctor" class="hp-browse-accent">List your implant practice →</a>
            </div>
        </div>
    </div>
</nav>
