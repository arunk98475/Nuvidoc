@model SiteSettingsModel
@{
    var brand = Branding.SiteName;
    var privacyHref = string.IsNullOrWhiteSpace(Model.PrivacyPdfUrl) ? "/Privacy" : Model.PrivacyPdfUrl;
}
<link rel="stylesheet" href="~/css/site-footer.css" asp-append-version="true" />
<footer class="sf" role="contentinfo">
    <nav class="sf-menu" aria-label="Footer">
        <div class="sf-inner sf-menu-inner">
            <a href="/">Home</a>
            <a href="/?chat=1">Find a Dentist</a>
            <a href="/services">Services</a>
            <a href="/blog">Blog</a>
            <a href="/#how-it-works">How It Works</a>
            <a href="/#testimonials">Reviews</a>
            <a href="/Account/Register/Doctor">List your practice</a>
            <a href="/sitemap">Site Map</a>
        </div>
    </nav>
    <div class="sf-inner">

        @if (Model.HasSocialLinks || Model.HasStoreLinks)
        {
            <div class="sf-media">
                @if (Model.HasSocialLinks)
                {
                    <div class="sf-social" aria-label="Social media">
                        @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                        {
                            <a href="@Model.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.6l.4-3H13v-2c0-.6.4-1 1-1z"/></svg>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                        {
                            <a href="@Model.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 2A1.8 1.8 0 1 0 13.8 12 1.8 1.8 0 0 0 12 10.2zM17.4 6.6a.9.9 0 1 1-.9.9.9.9 0 0 1 .9-.9z"/></svg>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.TwitterUrl))
                        {
                            <a href="@Model.TwitterUrl" target="_blank" rel="noopener noreferrer" aria-label="X">
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M14.7 10.3 22 2h-2.2l-6.4 7.2L8.2 2H2l7.8 11.1L2 22h2.2l6.9-7.8L15.8 22H22l-7.3-11.7zm-2.4 2.8-.8-1.1L5 3.5h2.7l5.2 7.3.8 1.1 7 9.6h-2.7l-5.7-8.4z"/></svg>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                        {
                            <a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.5 9H4V20h2.5V9zM5.2 4A1.5 1.5 0 1 0 6.7 5.5 1.5 1.5 0 0 0 5.2 4zM20 20h-2.5v-5.6c0-1.6-.6-2.6-2-2.6a2.1 2.1 0 0 0-2 1.4 2.6 2.6 0 0 0-.1 1v5.8H11V9h2.4v1.5a3.4 3.4 0 0 1 3-1.7c2.3 0 3.6 1.5 3.6 4.6z"/></svg>
                            </a>
                        }
                    </div>
                }
                @if (Model.HasStoreLinks)
                {
                    <div class="sf-stores">
                        @if (!string.IsNullOrWhiteSpace(Model.AppStoreUrl))
                        {
                            <a class="sf-store" href="@Model.AppStoreUrl" target="_blank" rel="noopener noreferrer">
                                <span class="sf-store-kicker">Download on the</span>
                                <span class="sf-store-name">App Store</span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PlayStoreUrl))
                        {
                            <a class="sf-store" href="@Model.PlayStoreUrl" target="_blank" rel="noopener noreferrer">
                                <span class="sf-store-kicker">Get it on</span>
                                <span class="sf-store-name">Google Play</span>
                            </a>
                        }
                    </div>
                }
            </div>
        }

        <p class="sf-disclaimer">
            The content provided here and elsewhere on the @brand site or mobile app is provided for general informational purposes only. It is not intended as, and @brand does not provide, medical advice, diagnosis or treatment. Always contact your healthcare provider directly with any questions you may have regarding your health or specific medical advice.
        </p>

        <div class="sf-bottom">
            <div class="sf-legal">
                <span>© @DateTime.UtcNow.Year @brand, Inc.</span>
                @if (!string.IsNullOrWhiteSpace(Model.TermsPdfUrl))
                {
                    <a href="@Model.TermsPdfUrl" target="_blank" rel="noopener noreferrer">Terms</a>
                }
                <a href="@privacyHref" target="@(string.IsNullOrWhiteSpace(Model.PrivacyPdfUrl) ? null : "_blank")" rel="@(string.IsNullOrWhiteSpace(Model.PrivacyPdfUrl) ? null : "noopener noreferrer")">Privacy</a>
                @if (!string.IsNullOrWhiteSpace(Model.ConsumerHealthPdfUrl))
                {
                    <a href="@Model.ConsumerHealthPdfUrl" target="_blank" rel="noopener noreferrer">Consumer Health</a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PrivacyChoicesPdfUrl))
                {
                    <a href="@Model.PrivacyChoicesPdfUrl" target="_blank" rel="noopener noreferrer">Your privacy choices</a>
                }
            </div>
        </div>
    </div>
</footer>
