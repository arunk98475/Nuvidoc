@*
  Zocdoc-style patient login modal (email → password, social buttons placeholder).
*@
<div class="pl-backdrop" id="patient-login-backdrop" hidden></div>
<div class="pl-modal" id="patient-login-modal" role="dialog" aria-modal="true" aria-labelledby="patient-login-title" hidden>
    <button type="button" class="pl-close" id="patient-login-close" aria-label="Close">&times;</button>
    <h2 class="pl-title" id="patient-login-title">To log in, enter your email address</h2>

    <form class="pl-form" id="patient-login-form" method="post" action="/Account/Login" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="Input.AccountType" value="Patient" />

        <div class="pl-step is-active" data-pl-step="email">
            <label class="pl-label" for="pl-email">Email Address</label>
            <input id="pl-email" class="pl-input" name="Input.Username" type="email" autocomplete="username" required placeholder="" />
            <button type="button" class="pl-btn-primary" id="pl-continue">Continue</button>
        </div>

        <div class="pl-step" data-pl-step="password" hidden>
            <p class="pl-email-echo" id="pl-email-echo"></p>
            <button type="button" class="pl-link-btn" id="pl-change-email">Use a different email</button>
            <label class="pl-label" for="pl-password">Password</label>
            <input id="pl-password" class="pl-input" name="Input.Password" type="password" autocomplete="current-password" />
            <p class="pl-error" id="pl-error" hidden></p>
            <button type="submit" class="pl-btn-primary">Log in</button>
            <p class="pl-hint" style="margin-top:12px;">
                <a class="pl-link-btn" id="pl-forgot" href="/Account/ForgotPassword">Forgot password?</a>
            </p>
        </div>
    </form>

    <div class="pl-or"><span>or</span></div>

    <div class="pl-social">
        <a class="pl-social-btn" id="pl-google" href="/Account/ExternalLogin?provider=Google&amp;returnUrl=/">
            <span class="pl-social-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            </span>
            Continue with Google
        </a>
        <a class="pl-social-btn" id="pl-apple" href="/Account/ExternalLogin?provider=Apple&amp;returnUrl=/">
            <span class="pl-social-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="#111"><path d="M16.7 12.6c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.1.8-.6 0-1.6-.7-2.7-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.5-.4 6.3 1 8.3.7 1 1.5 2.1 2.6 2 1-.1 1.4-.7 2.7-.7s1.6.6 2.7.7c1.1.1 1.9-1 2.6-2 .8-1.1 1.1-2.2 1.1-2.3-.1 0-2-.8-2.1-3.3zM14.3 6.3c.6-.7 1-1.7.9-2.7-0.9.1-1.9.6-2.5 1.3-.6.6-1.1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z"/></svg>
            </span>
            Continue with Apple
        </a>
    </div>

    <p class="pl-provider-note">
        Are you an administrator?
        <a href="Account/Admin">Log in here</a>
    </p>
</div>
