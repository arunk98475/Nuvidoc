@page
@using Docovee.BLL.Data
@using System.Text.Json
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = $"{Branding.SiteName} — Find a Dentist Near Me";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Find the right dentist near you. @Branding.SiteName matches you with top-rated local dentists based on your needs." />
    <link rel="stylesheet" href="~/css/docovee.css" asp-append-version="true" />
</head>
<body>

<nav>
    <div class="nav-left">
        <partial name="Shared/_SiteLogo" />
        <div class="nav-links">
            <a class="nav-link" href="#" onclick="scrollToChat(); return false;">Find a Dentist</a>
            <div class="nav-dropdown">
                <a class="nav-link" href="#">Dental care</a>
                <div class="nav-dropdown-menu">
                    <a class="nav-dropdown-item" href="#" onclick="fillChatInput('I need a dentist'); return false;">🦷 General Dentist</a>
                    <a class="nav-dropdown-item" href="#" onclick="fillChatInput('I need an orthodontist'); return false;">😁 Orthodontist</a>
                    <a class="nav-dropdown-item" href="#" onclick="fillChatInput('I need an oral surgeon'); return false;">🦴 Oral Surgeon</a>
                    <a class="nav-dropdown-item" href="#" onclick="fillChatInput('I need a periodontist'); return false;">🦷 Periodontist</a>
                    <a class="nav-dropdown-item" href="#" onclick="fillChatInput('I want dental implants'); return false;">✨ Dental Implants</a>
                    <a class="nav-dropdown-item" href="#" onclick="fillChatInput('I want teeth whitening'); return false;">💎 Whitening</a>
                    <a class="nav-dropdown-item" href="#" onclick="fillChatInput('I am interested in Invisalign'); return false;">🦷 Invisalign</a>
                    <a class="nav-dropdown-item" href="#" onclick="scrollToChat(); return false;">🌿 Tell Nuvi what you need →</a>
                </div>
            </div>
            <a class="nav-link" href="#how-it-works">How It Works</a>
            <a class="nav-link" href="#testimonials">Reviews</a>
        </div>
    </div>
    <div class="nav-right" id="nav-right" @(User.Identity?.IsAuthenticated == true ? "data-authenticated=\"true\"" : "")>
        @if (User.Identity?.IsAuthenticated == true)
        {
            if (User.IsInRole(AuthRoles.Admin))
            {
                <a href="/Admin/Patients" class="nav-link">Admin Panel</a>
            }
            else if (User.IsInRole(AuthRoles.Patient))
            {
                <a href="/Account/Profile" class="nav-link">My Profile</a>
            }
            else if (User.IsInRole(AuthRoles.Doctor))
            {
                <a href="/Doctor" class="nav-link">Doctor portal</a>
            }
            <a href="/Account/Logout" class="nav-link">Logout</a>
        }
        else
        {
            <a href="/Account/Login" class="nav-link">Login</a>
            <a href="/Account/Register/Doctor" class="nav-link nav-for-doctors">For Doctors</a>
        }
        <button class="nav-cta" onclick="window.scrollTo({top:0,behavior:'smooth'})">Find My Doctor</button>
    </div>
</nav>

<div class="hero-chat" id="hero-section">
    <div class="hero-left">
        <div class="hero-eyebrow">Find the Best Doctor Near Me · Book Online Today</div>
        <h1>Find a doctor<br>you can <em>trust.</em></h1>
        <p>Tell @Branding.ChatBotName what's going on. Your personal AI concierge finds the doctor who truly fits you — not just any doctor, the right one.</p>
    </div>

    <div class="hero-steps-strip">
        <div class="hero-step-cell">
            <div class="hero-step-label">Step 1</div>
            <div class="hero-step-text">Tell us what's wrong</div>
        </div>
        <div class="hero-step-cell">
            <div class="hero-step-label">Step 2</div>
            <div class="hero-step-text">We understand your needs</div>
        </div>
        <div class="hero-step-cell">
            <div class="hero-step-label">Step 3</div>
            <div class="hero-step-text">Get matched with top doctors</div>
        </div>
        <div class="hero-step-cell hero-step-cell-last">
            <div class="hero-step-label">Step 4</div>
            <div class="hero-step-text">Book instantly</div>
        </div>
    </div>

    <div class="hero-chat-split-wrap" id="hero-chat-split-wrap">
    <div class="hero-right" id="hero-chat-panel">
        <div class="chat-window">
            <div class="chat-header">
                <div class="ai-avatar">@Branding.ChatBotInitial</div>
                <div>
                    <div class="ai-name">@Branding.ChatBotName</div>
                    <div class="ai-status"><span class="ai-dot"></span>Here to help you find the right dentist</div>
                </div>
            </div>
            <div class="chat-messages" id="chat-messages">
                <div class="msg ai">
                        <div class="msg-avatar">@Branding.ChatBotName</div>
                    <div class="msg-bubble">
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole(AuthRoles.Patient))
                        {
                            @:Hi @(Model.PatientFullName ?? User.Identity!.Name)! 👋 I'm @Branding.ChatBotName — your personal dentist-matching concierge. Welcome back! What's going on with your teeth or smile?
                        }
                        else
                        {
                            @:Hi! I'm @Branding.ChatBotName 👋 I'm here to match you with the right dentist — not just any dentist, the right one for YOU. Tooth pain, cleaning, implants, or a new dental home — tell me what's going on.
                        }
                    </div>
                </div>
            </div>
            <div class="chips" id="quick-chips">
                <button class="chip" onclick="sendChip(this)">I need a dentist</button>
                <button class="chip" onclick="sendChip(this)">Tooth pain</button>
                <button class="chip" onclick="sendChip(this)">Dental implants</button>
                <button class="chip" onclick="sendChip(this)">Teeth cleaning</button>
                <button class="chip" onclick="sendChip(this)">Invisalign</button>
                <button class="chip" onclick="sendChip(this)">Emergency dental</button>
            </div>
            <div class="chat-input-area" id="chat-input-area">
                <textarea class="chat-input" id="chat-input" name="chat-message" rows="1" autocomplete="off" autocapitalize="sentences" spellcheck="true" placeholder="Tell @Branding.ChatBotName what's going on..." onkeydown="handleKey(event)" oninput="autoResize(this)"></textarea>
                <button class="send-btn" id="send-btn" onclick="sendMessage()">
                    <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/></svg>
                </button>
            </div>
        </div>
        <div class="disclaimer disclaimer-banner">⚠️ Not medical advice. For emergencies call 911.</div>
    </div>

    <aside class="hero-doctor-panel" id="hero-doctor-panel" hidden aria-hidden="true">
        <div class="hero-doctor-panel-inner">
            <button type="button" class="hero-doctor-panel-close" onclick="closeDoctorSidePanel()" aria-label="Close profile">&times;</button>
            <div id="hero-doctor-panel-body" class="hero-doctor-panel-body"></div>
        </div>
    </aside>
    </div>
</div>

<partial name="Shared/_HomeMarketing" model="Model.FeaturedDoctors" />

<div id="doctor-profile-modal" class="hp-doctor-modal" hidden aria-hidden="true">
    <div class="hp-doctor-modal-backdrop" onclick="closeDoctorProfileModal()"></div>
    <div class="hp-doctor-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="doctor-modal-title">
        <button type="button" class="hp-doctor-modal-close" onclick="closeDoctorProfileModal()" aria-label="Close">&times;</button>
        <div id="doctor-profile-modal-body" class="hp-doctor-modal-body"></div>
    </div>
</div>

<footer class="site-footer site-footer-rich">
    <div class="site-footer-inner">
        <div class="site-footer-brand">@Branding.SiteName.ToLowerInvariant().</div>
        <div class="site-footer-links">
            <a href="#">Terms of Use</a>
            <a href="#">Privacy Policy</a>
            <a href="#">Community Standards</a>
            <a href="#">Accessibility</a>
        </div>
        <div class="site-footer-copy">© @DateTime.UtcNow.Year @Branding.SiteName · Not medical advice · For emergencies call 911</div>
    </div>
</footer>

<script>
  window.nuvidocBranding = {
    siteName: "@Branding.SiteName",
    chatBotName: "@Branding.ChatBotName",
    matchSearchLoadingMessage: @Html.Raw(JsonSerializer.Serialize(NuviFlowContent.MatchSearchLoadingMessage))
  };
</script>
<script src="~/js/docovee.js" asp-append-version="true"></script>
</body>
</html>
