@page
@model Docovee.Pages.Admin.Patients.AccountSettingsModel
@{
    ViewData["Title"] = "Account settings";
}

<partial name="_PatientsNav" />

<div class="admin-card">
    <h1>Patient account settings</h1>
    <p>Configure automatic account closure for inactive patients and automatic permanent deletion for closed accounts.</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-error">@Model.ErrorMessage</div>
    }

    <form method="post" asp-page-handler="Lifecycle">
        <div class="form-group" style="margin-bottom:18px;">
            <label class="hint">
                <input type="checkbox" asp-for="Input.AutoCloseInactiveEnabled" />
                Automatically close account if not logged in for continuous
            </label>
            <div class="form-grid" style="margin-top:10px;">
                <div class="form-group">
                    <label asp-for="Input.AutoCloseInactiveMonths">Months without login</label>
                    <input asp-for="Input.AutoCloseInactiveMonths" type="number" min="1" max="120" class="form-control" />
                    <p class="hint">Default 24. Inactivity is measured from last login, or registration date if the patient never logged in. Closing disables login only; data is kept.</p>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:18px;">
            <label class="hint">
                <input type="checkbox" asp-for="Input.AutoDeleteClosedEnabled" />
                Automatically permanently delete account if it stayed closed for
            </label>
            <div class="form-grid" style="margin-top:10px;">
                <div class="form-group">
                    <label asp-for="Input.AutoDeleteClosedMonths">Months account stays closed</label>
                    <input asp-for="Input.AutoDeleteClosedMonths" type="number" min="1" max="60" class="form-control" />
                    <p class="hint">Default 3. Applies to all closed accounts (self-delete, admin close, or auto-inactivity). This is separate from manual admin permanent remove wait (<code>Account:HardDeleteWaitDays</code> in appsettings).</p>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save settings</button>
    </form>
</div>

<div class="admin-card" style="margin-top:24px;">
    <h1>Nuvi verification for new patients</h1>
    <p>When enabled, Nuvi asks new patients to confirm their contact details with a one-time code during chat signup.</p>

    @if (!string.IsNullOrEmpty(Model.VerificationSuccessMessage))
    {
        <div class="alert-success">@Model.VerificationSuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.VerificationErrorMessage))
    {
        <div class="alert-error">@Model.VerificationErrorMessage</div>
    }

    <form method="post" asp-page-handler="Verification">
        <div class="form-group" style="margin-bottom:18px;">
            <label class="hint">
                <input type="checkbox" asp-for="Verification.EnableEmailVerification" />
                Enable Nuvi email verification for new patients
            </label>
            <p class="hint">When checked, after a new patient enters an email in Nuvi, a code is sent to that address and Nuvi asks for the OTP (chips: Change Email Address, Quit).</p>
        </div>

        <div class="form-group" style="margin-bottom:18px;">
            <label class="hint">
                <input type="checkbox" asp-for="Verification.EnablePhoneVerification" />
                Enable Nuvi Phone number verification for new patients
            </label>
            <p class="hint">When checked, after a new patient enters a phone number in Nuvi, a code is sent by SMS and Nuvi asks for the OTP (chips: Change Phone number, WhatsApp Me Otp, Quit).</p>
        </div>

        <button type="submit" class="btn btn-primary">Save verification settings</button>
    </form>
</div>
