@page
@model Docovee.Pages.Admin.Patients.RemindersModel
@using Docovee.BLL.Services
@{
    ViewData["Title"] = "Booking reminders";
    var lastRunClinic = Model.RunStatus.LastRunUtc.HasValue
        ? ClinicTime.FromUtc(Model.RunStatus.LastRunUtc.Value)
        : (DateTime?)null;
}

<partial name="_PatientsNav" />

<div class="admin-card">
    <h1>Booking reminders</h1>
    <p>Remind registered patients who have not booked a NuviDoc appointment. Useful for longer consideration cycles (for example implants).</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="form-group" style="margin-bottom:18px;">
            <label class="hint">
                <input type="checkbox" asp-for="Input.Enabled" />
                Send reminders to patients with no booking
            </label>
            <p class="hint">When on, registered patients with no NuviDoc appointment are reminded on the interval below.</p>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="Input.IntervalDays">Send reminders every (days)</label>
                <input asp-for="Input.IntervalDays" type="number" min="1" max="90" class="form-control" />
                <p class="hint">First send is this many days after registration, then every this many days.</p>
            </div>
            <div class="form-group">
                <label asp-for="Input.StopAfterMonths">Stop reminders after (months from registration)</label>
                <input asp-for="Input.StopAfterMonths" type="number" min="1" max="24" class="form-control" />
                <p class="hint">No further sends after this window from the registration date.</p>
            </div>
        </div>

        <h2 class="admin-section-title">Channels</h2>
        <div class="form-group">
            <label class="hint">
                <input type="checkbox" asp-for="Input.EnableWhatsApp" />
                Enable WhatsApp reminders
            </label>
            <p class="hint">Requires a verified phone and Twilio WhatsApp (Content SID for nurture messages).</p>
        </div>
        <div class="form-group">
            <label class="hint">
                <input type="checkbox" asp-for="Input.EnableEmail" />
                Enable email reminders
            </label>
            <p class="hint">Sent to the patient’s account email address.</p>
        </div>
        <div class="form-group">
            <label class="hint">
                <input type="checkbox" asp-for="Input.EnableSms" />
                Enable SMS reminders
            </label>
            <p class="hint">Requires a verified phone number.</p>
        </div>

        <button type="submit" class="btn btn-primary">Save settings</button>
    </form>
</div>

<div class="admin-card" style="margin-top:24px;">
    <h2 class="admin-section-title">Worker status</h2>
    <p class="hint">The booking reminder worker runs about every 20 minutes while the app is running.</p>
    @if (Model.RunStatus.LastRunUtc.HasValue)
    {
        <p>
            <strong>Last run:</strong>
            @Model.RunStatus.LastRunUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
            (@lastRunClinic!.Value.ToString("yyyy-MM-dd h:mm tt") Central)
        </p>
        <p><strong>Sent on last run:</strong> @Model.RunStatus.LastRunSentCount reminder@(Model.RunStatus.LastRunSentCount == 1 ? "" : "s")</p>
    }
    else
    {
        <p>No worker run recorded yet. Start the app and wait for the first cycle (about 45 seconds after startup).</p>
    }
</div>

<div class="admin-card" style="margin-top:24px;">
    <h2 class="admin-section-title">Recent sends</h2>
    <p class="hint">@Model.TotalSendCount total reminder@(Model.TotalSendCount == 1 ? "" : "s") sent · showing latest @Model.RecentSends.Count</p>
    @if (Model.RecentSends.Count == 0)
    {
        <p>No booking reminders have been sent yet.</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Sent (UTC)</th>
                        <th>Patient</th>
                        <th>Channel</th>
                        <th>Step (days)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.RecentSends)
                    {
                        var sentClinic = ClinicTime.FromUtc(row.SentAtUtc);
                        <tr>
                            <td>
                                @row.SentAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC<br />
                                <small>@sentClinic.ToString("yyyy-MM-dd h:mm tt") Central</small>
                            </td>
                            <td>
                                <a href="/Admin/Patients/Edit/@row.PatientId">@row.PatientName</a><br />
                                <small>@row.PatientUsername</small>
                            </td>
                            <td>@row.Channel</td>
                            <td>@row.StepDay</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
