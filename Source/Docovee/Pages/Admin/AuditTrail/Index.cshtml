@page
@model Docovee.Pages.Admin.AuditTrail.IndexModel
@{
    ViewData["Title"] = "Audit trail";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
}

<div class="admin-card">
    <h1>Audit trail</h1>
    <p>HIPAA-aligned activity log: who changed or accessed records, when, and from where. Passwords and API keys are never stored.</p>

    <form method="get" class="form-grid" style="margin-bottom:16px;">
        <div class="form-group">
            <label>Entity type</label>
            <input name="EntityType" value="@Model.EntityType" class="form-control" placeholder="Patient, Appointment…" />
        </div>
        <div class="form-group">
            <label>Action</label>
            <input name="Action" value="@Model.Action" class="form-control" placeholder="Create, Update, Login…" />
        </div>
        <div class="form-group">
            <label>Actor</label>
            <input name="Actor" value="@Model.Actor" class="form-control" placeholder="Username or user id" />
        </div>
        <div class="form-group" style="align-self:end;">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    @if (Model.Rows.Count == 0)
    {
        <p>No audit entries found.</p>
    }
    else
    {
        <p>@Model.TotalCount total entries · page @Model.PageNum of @totalPages</p>
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>When (UTC)</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Actor</th>
                        <th>IP</th>
                        <th>Summary</th>
                        <th>OK</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@row.Action</td>
                            <td>@row.EntityType @(row.EntityId != null ? $"#{row.EntityId}" : "")</td>
                            <td>@(row.ActorUsername ?? "—")<br /><small>@(row.ActorRole ?? "")</small></td>
                            <td>@(row.IpAddress ?? "—")</td>
                            <td>@row.Summary</td>
                            <td>@(row.Success ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div style="margin-top:16px;display:flex;gap:8px;">
                @if (Model.PageNum > 1)
                {
                    <a class="btn btn-secondary" href="?page=@(Model.PageNum - 1)&EntityType=@Model.EntityType&Action=@Model.Action&Actor=@Model.Actor">Previous</a>
                }
                @if (Model.PageNum < totalPages)
                {
                    <a class="btn btn-secondary" href="?page=@(Model.PageNum + 1)&EntityType=@Model.EntityType&Action=@Model.Action&Actor=@Model.Actor">Next</a>
                }
            </div>
        }
    }
</div>
