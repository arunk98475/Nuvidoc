@page "{id:int}"
@model Docovee.Pages.Admin.Doctors.EditModel
@{
    ViewData["Title"] = "Edit Doctor";
    var nh = Model.NexHealthConnection;
    var isIntegrated = nh is { IsEnabled: true };
}

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Input.Id" />
    @{
        ViewContext.ViewData.TemplateInfo.HtmlFieldPrefix = "Input";
    }
    <div class="admin-card">
        <h1>Edit Doctor</h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        <partial name="_DoctorForm" model="Model.Input" />
        @if (!string.IsNullOrEmpty(Model.Input.PhotoUrl))
        {
            <div class="form-group">
                <label>Current Photo</label>
                <img src="@Model.Input.PhotoUrl" alt="Current photo" class="doctor-thumb-preview" onerror="this.style.display='none';" style="max-width:120px;border-radius:8px;" />
            </div>
        }
        <div class="form-group">
            <label>Replace Photo</label>
            <input type="file" name="photo" accept="image/*" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </div>

    <partial name="_DoctorBillingCard" model="Model.Input" />
</form>
@{
    // Reset so NexHealth fields bind as NexHealthForm.* (not Input.NexHealthForm.*).
    ViewContext.ViewData.TemplateInfo.HtmlFieldPrefix = string.Empty;
}

<div class="admin-card" id="procedure-fees">
    <h1>Procedure fees</h1>
    <p>Cash prices for procedures (e.g. Dental Implant). Used by Nuvi when procedure cost consideration is enabled.</p>

    @if (Model.PracticeFeeSaved && !string.IsNullOrWhiteSpace(Model.PracticeFeeMessage))
    {
        <div class="alert-success">@Model.PracticeFeeMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.PracticeFeeMessage))
    {
        <div class="alert-error">@Model.PracticeFeeMessage</div>
    }

    <form method="post" asp-page-handler="AddProcedureFee" style="margin-bottom:1.25rem;">
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="PracticeFeeForm.ProcedureName">Procedure name</label>
                <input asp-for="PracticeFeeForm.ProcedureName" class="form-control" placeholder="e.g. Dental Implant" maxlength="200" required />
            </div>
            <div class="form-group">
                <label asp-for="PracticeFeeForm.FeeUsd">Fee (USD)</label>
                <input asp-for="PracticeFeeForm.FeeUsd" type="number" min="0" step="0.01" class="form-control" placeholder="300.00" required />
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Add procedure fee</button>
    </form>

    @if (Model.PracticeFees.Count == 0)
    {
        <p class="hint">No procedure fees yet.</p>
    }
    else
    {
        <table class="admin-table" style="width:100%;">
            <thead>
                <tr>
                    <th>Procedure</th>
                    <th>Fee (USD)</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fee in Model.PracticeFees)
                {
                    <tr>
                        <td>
                            <form method="post" asp-page-handler="UpdateProcedureFee" id="admin-fee-@fee.Id">
                                <input type="hidden" name="PracticeFeeForm.Id" value="@fee.Id" />
                                <input name="PracticeFeeForm.ProcedureName" value="@fee.ProcedureName" class="form-control" maxlength="200" required />
                            </form>
                        </td>
                        <td>
                            <input form="admin-fee-@fee.Id" name="PracticeFeeForm.FeeUsd" type="number" min="0" step="0.01" value="@fee.FeeUsd.ToString("0.00")" class="form-control" required />
                        </td>
                        <td>@fee.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td style="white-space:nowrap;">
                            <button type="submit" form="admin-fee-@fee.Id" class="btn btn-secondary">Save</button>
                            <form method="post" asp-page-handler="DeleteProcedureFee" style="display:inline;">
                                <input type="hidden" name="feeId" value="@fee.Id" />
                                <button type="submit" class="btn btn-secondary" onclick="return confirm('Delete this procedure fee?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="admin-card" id="nexhealth">
    <h1>NexHealth integration</h1>
    <p>
        Connect this provider (doctor) to a NexHealth location. The NuviDoc API key is shared for all doctors
        (configured in <code>NexHealth:ApiKey</code>). Once enabled, public booking slots and appointments sync with NexHealth.
    </p>

    @if (Model.IntegrationSaved && !string.IsNullOrWhiteSpace(Model.IntegrationMessage))
    {
        <div class="alert-success">@Model.IntegrationMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.IntegrationMessage))
    {
        <div class="alert-error">@Model.IntegrationMessage</div>
    }

    <div class="form-group">
        <label>API key</label>
        @if (Model.HasGlobalNexHealthApiKey)
        {
            <p class="hint" style="margin:0;">Configured globally for NuviDoc — not entered per doctor.</p>
        }
        else
        {
            <p class="hint" style="margin:0;color:#b91c1c;">Missing. Set <code>NexHealth:ApiKey</code> in appsettings (shared for all doctors).</p>
        }
    </div>

    @if (isIntegrated)
    {
        <div class="integration-status-row">
            <span class="badge-integrated">INTEGRATED</span>
            <span class="hint">
                Last updated:
                @{
                    var updated = nh!.LastSyncAt ?? nh.LastTestAt;
                }
                @(updated.HasValue ? updated.Value.ToLocalTime().ToString("g") : "—")
            </span>
        </div>
    }

    <form method="post" asp-page-handler="SaveNexHealth" asp-fragment="nexhealth">
        <div class="form-grid">
            <div class="form-group">
                <label>
                    <input type="checkbox" asp-for="NexHealthForm.IsEnabled" name="NexHealthForm.IsEnabled" />
                    Enable NexHealth sync for this doctor
                </label>
            </div>
            <div class="form-group">
                <label asp-for="NexHealthForm.Subdomain">Subdomain</label>
                <input asp-for="NexHealthForm.Subdomain" name="NexHealthForm.Subdomain" class="form-control" placeholder="e.g. nuvidoc-demo-practice" />
                <span class="hint">NexHealth practice subdomain (query param <code>subdomain</code>).</span>
            </div>
            <div class="form-group">
                <label asp-for="NexHealthForm.LocationId">Location ID</label>
                <input asp-for="NexHealthForm.LocationId" name="NexHealthForm.LocationId" class="form-control" placeholder="NexHealth location id" />
            </div>
            <div class="form-group">
                <label asp-for="NexHealthForm.Npi">NPI number</label>
                <div class="provider-id-row">
                    <input asp-for="NexHealthForm.Npi" name="NexHealthForm.Npi" class="form-control" placeholder="10-digit NPI" maxlength="10" inputmode="numeric" />
                    <button type="submit" formaction="?handler=FindProviderByNpi#nexhealth" class="btn btn-secondary">Find Provider ID</button>
                </div>
                <span class="hint">Enter the provider NPI and click Find Provider ID to look up the NexHealth provider <code>id</code> for this practice.</span>
            </div>
            <div class="form-group">
                <label asp-for="NexHealthForm.ProviderId">NexHealth Provider ID</label>
                <input asp-for="NexHealthForm.ProviderId" name="NexHealthForm.ProviderId" class="form-control" placeholder="NexHealth provider id for this doctor" />
                <span class="hint">From NexHealth <code>GET /providers?subdomain=…&amp;location_id=…</code> — use the provider <code>id</code>, or find it with NPI above.</span>
            </div>
            @if (Model.ProviderCandidates.Count > 0)
            {
                <div class="form-group">
                    <label>Matching providers</label>
                    <select class="form-control" onchange="if(this.value){document.querySelector('[name=\'NexHealthForm.ProviderId\']').value=this.value;}">
                        <option value="">Select a provider…</option>
                        @foreach (var candidate in Model.ProviderCandidates)
                        {
                            <option value="@candidate.Id">@candidate.Name (@candidate.Id)@(string.IsNullOrWhiteSpace(candidate.Npi) ? "" : $" — NPI {candidate.Npi}")</option>
                        }
                    </select>
                    <span class="hint">Choose a provider to fill the Provider ID field, then click Save integration.</span>
                </div>
            }
            <div class="form-group">
                <label asp-for="NexHealthForm.OperatoryId">Operatory ID (optional)</label>
                <input asp-for="NexHealthForm.OperatoryId" name="NexHealthForm.OperatoryId" class="form-control" placeholder="Chair / operatory id if required" />
            </div>
        </div>

        <div class="actions" style="margin-top:12px;gap:8px;display:flex;flex-wrap:wrap;">
            <button type="submit" class="btn btn-primary">Save integration</button>
            <button type="submit" formaction="?handler=TestNexHealth#nexhealth" class="btn btn-secondary">Save &amp; test connection</button>
            @if (nh != null)
            {
                <button type="submit" formaction="?handler=SyncNexHealth#nexhealth" class="btn btn-secondary">Sync appointments now</button>
            }
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(nh?.LastError))
    {
        <p class="hint" style="color:#b91c1c;margin-top:12px;">Last error: @nh.LastError</p>
    }
</div>

<div class="admin-card admin-card-danger">
    <h2 class="admin-section-title">Close / remove account</h2>
    @if (!string.IsNullOrEmpty(Model.AccountMessage))
    {
        <div class="@(Model.AccountMessageSuccess ? "alert-success" : "alert-error")">@Model.AccountMessage</div>
    }

    @if (!Model.Input.IsDeleted)
    {
        <p class="hint">Closing disables login and hides the profile from patient search. All profile data is kept until permanent remove. Permanent remove timing is set in appsettings (<code>Account:HardDeleteWaitDays</code>).</p>
        <form method="post" asp-page-handler="CloseAccount" onsubmit="return confirm('Close this doctor account? Login will be disabled and the profile will be hidden. Data is retained until permanent remove.');">
            <input type="hidden" name="id" value="@Model.Input.Id" />
            <button type="submit" class="btn btn-secondary">Close account</button>
        </form>
    }
    else
    {
        <p class="hint">
            This account is closed
            @if (Model.Input.DeletedAtUtc.HasValue)
            {
                <text> since @Model.Input.DeletedAtUtc.Value.ToLocalTime().ToString("g").</text>
            }
            else
            {
                <text>.</text>
            }
            Permanent remove wait: <strong>@Model.HardDeleteWaitDays</strong> day(s) from appsettings <code>Account:HardDeleteWaitDays</code> (0 = immediate).
            Username and password are kept; Activate restores login without changing credentials.
        </p>
        <div class="actions" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
            <form method="post" asp-page-handler="ActivateAccount" onsubmit="return confirm('Activate this doctor account? The profile can appear in search again and login will work with the existing credentials.');">
                <input type="hidden" name="id" value="@Model.Input.Id" />
                <button type="submit" class="btn btn-primary">Activate Account</button>
            </form>
            @if (Model.CanRemoveAccount)
            {
                <form method="post" asp-page-handler="RemoveAccount" onsubmit="return confirm('Permanently remove this doctor? Related records may be deleted. This cannot be undone.');">
                    <input type="hidden" name="id" value="@Model.Input.Id" />
                    <button type="submit" class="btn btn-danger">Remove this Account</button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-danger" disabled title="Available after the wait period">Remove this Account</button>
            }
        </div>
        @if (!Model.CanRemoveAccount && Model.RemoveAvailableAtUtc.HasValue)
        {
            <p class="hint">Remove available after @Model.RemoveAvailableAtUtc.Value.ToLocalTime().ToString("g").</p>
        }
    }
</div>

@if (Model.ScrollToNexHealth)
{
    <script>
        document.getElementById('nexhealth')?.scrollIntoView({ block: 'start' });
    </script>
}
