@page
@model Docovee.Pages.Admin.Doctors.IndexModel
@{
    ViewData["Title"] = "Doctors";
}

<div class="admin-card">
    <h1>Doctors</h1>
    <p>Manage practitioner listings used by the AI matching engine.</p>

    <form method="get">
        <div class="form-grid">
            <div class="form-group">
                <label>Search</label>
                <input name="Search" value="@Model.Search" class="form-control" placeholder="Name, specialty, practice, city" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="Create" class="btn btn-secondary">+ Add Doctor</a>
        <a asp-page="Import" class="btn btn-secondary">Import CSV / Excel</a>
    </form>
</div>

<div class="admin-card">
    <h2>Default visit billing</h2>
    <p>These values apply to all doctors unless a doctor overrides the per-visit fee. Charging starts after free visits are used.</p>

    @if (Model.BillingDefaultsSaved)
    {
        <div class="alert-success">Default billing settings saved.</div>
    }
    @if (!string.IsNullOrEmpty(Model.BillingDefaultsError))
    {
        <div class="alert-error">@Model.BillingDefaultsError</div>
    }

    <form method="post" asp-page-handler="UpdateBillingDefaults">
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="PageNum" value="@Model.PageNum" />
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="DefaultPerVisitFeeUsd">Per-visit fee (USD)</label>
                <input asp-for="DefaultPerVisitFeeUsd" type="number" min="0" step="0.01" class="form-control" />
                <p class="hint">Default amount charged when a doctor marks a NuviDoc patient as showed.</p>
            </div>
            <div class="form-group">
                <label asp-for="FreeVisitCount">Number of free visits</label>
                <input asp-for="FreeVisitCount" type="number" min="0" step="1" class="form-control" />
                <p class="hint">Each doctor’s first N showed NuviDoc visits are free. Charging starts after that. Default is 0.</p>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>

<div class="admin-card">
    <h2>Sponsorship</h2>
    <p>Doctors can turn on sponsored listings only when their quality score meets this threshold.</p>

    @if (Model.SponsorshipSettingsSaved)
    {
        <div class="alert-success">Sponsorship settings saved.</div>
    }
    @if (!string.IsNullOrEmpty(Model.SponsorshipSettingsError))
    {
        <div class="alert-error">@Model.SponsorshipSettingsError</div>
    }

    <form method="post" asp-page-handler="UpdateSponsorshipSettings">
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="PageNum" value="@Model.PageNum" />
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="MinQualityScoreForSponsorship">Minimum quality score to enable sponsorship</label>
                <input asp-for="MinQualityScoreForSponsorship" type="number" min="0" max="100" step="1" class="form-control" />
                <p class="hint">Score is 0–100. Doctors below this value cannot enable sponsorship; active sponsorship is paused if their score later drops below it.</p>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>

<div class="admin-card">
    @if (Model.Results.Items.Count == 0)
    {
        <p>No doctors found. Add one manually or import from CSV/Excel.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Doctor</th>
                    <th>Specialty</th>
                    <th>Location</th>
                    <th>Rating</th>
                    <th>Patient Reviews</th>
                    <th>Status</th>
                    <th>NexHealth</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Results.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(d.PhotoUrl))
                            {
                                <div class="doctor-thumb-cell">
                                    <img src="@d.PhotoUrl" alt="@d.Name" class="doctor-thumb-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                    <span class="doctor-thumb-fallback" style="display:none;">—</span>
                                </div>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            <strong>@d.Name</strong>
                            @if (!string.IsNullOrEmpty(d.PracticeName))
                            {
                                <br /><span style="font-size:12px;color:#6b8078;">@d.PracticeName</span>
                            }
                        </td>
                        <td>@d.Specialty</td>
                        <td>@(d.Location ?? $"{d.City}, {d.State}")</td>
                        <td>★ @d.GoogleRating (@d.GoogleReviewCount)</td>
                        <td>@d.PatientReviewCount</td>
                        <td>@(d.IsActive ? "Active" : "Inactive")@(d.IsSponsored ? $" · Sponsored · Q{d.QualityScore}" : $" · Q{d.QualityScore}")</td>
                        <td>
                            @if (d.IsNexHealthIntegrated)
                            {
                                <span class="badge-integrated">INTEGRATED</span>
                            }
                            else
                            {
                                <span class="hint">Not connected</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a asp-page="Edit" asp-route-id="@d.Id" asp-fragment="nexhealth" class="btn btn-secondary btn-sm">Edit</a>
                                <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Delete this doctor?');">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <span>Showing @Model.Results.Items.Count of @Model.Results.TotalCount (page @Model.Results.Page of @Model.Results.TotalPages)</span>
            @if (Model.Results.Page > 1)
            {
                <a class="btn btn-secondary btn-sm" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-PageNum="@(Model.Results.Page - 1)">Previous</a>
            }
            @if (Model.Results.Page < Model.Results.TotalPages)
            {
                <a class="btn btn-secondary btn-sm" asp-page="./Index" asp-route-Search="@Model.Search" asp-route-PageNum="@(Model.Results.Page + 1)">Next</a>
            }
        </div>
    }
</div>
