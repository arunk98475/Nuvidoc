@page
@model Docovee.Pages.Admin.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <partial name="Shared/_Favicon" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-card">
        <h1 class="admin-login-brand">
            <img class="admin-logo-mark" src="~/images/favicon_large.png" asp-append-version="true" alt="" width="28" height="28" />
            @Branding.SiteName Admin
        </h1>
        <p>Sign in to manage patients and settings.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="alert-success">@Model.InfoMessage</div>
        }

        @if (Model.ShowOtpStep)
        {
            <form method="post" asp-page-handler="VerifyOtp">
                <input type="hidden" asp-for="OtpSessionToken" />
                <div class="form-group" style="margin-bottom:14px;">
                    <label asp-for="OtpCode">Verification code</label>
                    <input asp-for="OtpCode" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;margin-bottom:10px;">Verify and sign in</button>
            </form>
            <form method="post" asp-page-handler="ResendOtp">
                <input type="hidden" asp-for="OtpSessionToken" />
                <button type="submit" class="btn btn-secondary" style="width:100%;">Resend code</button>
            </form>
        }
        else
        {
            <form method="post">
                <div class="form-group" style="margin-bottom:14px;">
                    <label asp-for="Input.Username">Username</label>
                    <input asp-for="Input.Username" class="form-control" autocomplete="username" />
                </div>
                <div class="form-group" style="margin-bottom:20px;">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;">Sign In</button>
            </form>
        }
    </div>
</body>
</html>
